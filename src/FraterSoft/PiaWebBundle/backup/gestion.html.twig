<style>
    #atributos{
        margin: 10px 0;
    }
    #length{
        float: right
    }
    #listasevento_length > label > select{
        width: 50px;
    }
    #formlistasevento > div:nth-child(n+0) > label{
        display: inline-block;
        width: 130px;
        text-align: left;   
        vertical-align: middle;
    }
    #formlistasevento > div:nth-child(n+0) > input[type="checkbox"]{
        vertical-align: middle;
        margin-left: 0;
    }
    #formlistasevento > div:nth-child(n+0) > input[type="text"],input[type="number"] {
        vertical-align: middle;
        width: 196px;
    }
    #formlistasevento > div:nth-child(n+0) > select {
        height: 21px;
    }
    #formlistasevento > div:nth-child(n+0){
        margin: 5px;
    }    
    td.details-control {
        background: url('{{asset('bundles/fratersoftpiaweb/images/details_open.png')}}') no-repeat center center;
        cursor: pointer;
    }
    tr.shown td.details-control {
        background: url('{{asset('bundles/fratersoftpiaweb/images/details_close.png')}}') no-repeat center center;
    }    
</style> 
{% block body -%}    
    <div id="atributos">
        Seleccione el Atributo Opcion 
        <select id="select_atributos_opcion">
        {% for atributo in atributos %}
            <option value="{{ atributo.idatributo.id }}">
                {% if atributo.etiqueta is null %}
                    {{ atributo.idatributo.nombre }} 
                {% else %} 
                    {{ atributo.etiqueta }} 
                {% endif %}
            </option>
        {% endfor %}
        </select>
    </div>
    <table id="listasevento" class="display row-border hover">
        <thead>
            <tr>
            {% for campo in campos %}                
                <th>{{campo}}</th>
            {% endfor %}
            </tr>
        </thead>
        <tbody>
        {% for row in entities %}
            <tr>
            {% for campo in campos %} 
                {% if campo|length > 2 and campo[:2]=='id' %}
                    <td>{{ attribute(attribute(row, campo),'id') }}</td>
                {% else %}
                    <td>{{ attribute(row, campo) }}</td>
                {% endif %}
            {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div id="dialogElimiarListasevento" title="Advertencia!!!">
        ¿Esta seguro que desea elimar el elemento <strong id="eliminarListasevento"></strong> de la Lista ?
    </div>         
    <div id="dialogformListasevento" title="">
        {{ form_start(form,{'attr': {'id': 'formlistasevento'}}) }}
        {{ form_end(form) }} 
    </div> 
        
{% endblock %}
<link href="{{asset('bundles/fratersoftpiaweb/css/jquery.datetimepicker.css')}}" rel="stylesheet" type="text/css"/>
<script src="{{asset('bundles/fratersoftpiaweb/js/jquery.datetimepicker.full.js')}}" type="text/javascript"></script>  
<script>
    $(document).ready(function () { 
        
        menuConfInscripcionesControl('listasevento');        
        
        var table;
        var arraycampos;
        var rows=null;
        
        $('#tabla').DataTable({
            "dom": 'Brt',
            buttons: [
                {text: 'Nuevo'},
            ],
            'select': {
                style: 'os',   
                rows: "%d filas seleccionadas",
            },               
            
        });
        //crea un array javascript con el array twig enviado los campos de la entidad
        arraycampos = {{ campos|json_encode|raw }};
        
        //Contruye un array jason con la configuracion de los campos que comienzan
        //con id que seran ocultados en la tabla
        var config_columnDefs=[];
        for(i=0;i<arraycampos.length;i++){
            if(arraycampos[i].substring(0,2)=="id")
                config_columnDefs.push({ "targets": i , "visible": false});
        }
        config_columnDefs.push({ "targets": 3 , "width": 50});
        
        //Configura la tabla de datos
        table = $('#listasevento').DataTable({
            "dom": 'B<"top"<"#length"l>>rt<"clear">p',
            "order": [[1,'ASC']],
            "autoWidth": false,
            buttons: [
                {text: 'Nuevo',
                    action: function (e, dt, node, config) {
                        $('#formlistasevento').attr('action','{{ path('listasevento_create')}}'); 
                        $("#fratersoft_piawebbundle_listasevento_" + arraycampos[1]).val({{idevento}});
                        for(i=2;i<arraycampos.length;i++){
                            $("#fratersoft_piawebbundle_listasevento_" + arraycampos[i]).val("");
                        }
                        $("#dialogformListasevento").dialog({ title: "Nueva Lista" });
                        $("#dialogformListasevento").dialog("open");
                }},                 
                {text: 'Editar',
                    action: function (e, dt, node, config) {
                        var rows = table.rows({selected: true}).data();
                        if (rows.length == 1) {

                            //contruye la ruta del action del formulario
                            var action = '{{ path('listasevento_update',{'id':'_id_'})}}';
                            action = action.replace('_id_',rows[0][0]);
                            $('#formlistasevento').attr('action',action);

                            //carga la informacion seleccionada de la tabla en el formulario
                            for(i=1;i<arraycampos.length;i++){
                                $("#fratersoft_piawebbundle_listasevento_" + arraycampos[i]).val(rows[0][i]);
                            }

                            //configura el titulo y abre el formulario
                            $("#dialogformListasevento").dialog({ title: "Editar Lista" });
                            $("#dialogformListasevento").dialog("open");
                        }
                        else
                            alert("Debe seleccionar la Listasevento a editar");                        
                }},                 
                {text: 'Eliminar',
                    action: function (e, dt, node, config) {
                        $("#dialogformListasevento").dialog({ title: "Editar Listasevento" });
                        rows = table.rows({selected: true}).data();
                        $("#eliminarListasevento").html("");
                        if (rows.length == 1) {
                            $("#eliminarListasevento").append(rows[0][3] + " => " + rows[0][4]);
                            $("#dialogElimiarListasevento").dialog("open");                            
                        }
                        else
                            alert("Debe seleccionar la Listasevento a eliminar");
                }},                 
            ],
            'select': {
                style: 'os',   
                rows: "%d filas seleccionadas",
            },               
            "language": {
                "emptyTable": "No hay datos para mostrar",
            },
            "columnDefs": config_columnDefs,            
        });    

        //Filtra la tabla de datos segun la opcion del select seleccionado
        filtrarTabla(2);
        
        //Muestra la ventana de confirmacion
        $("#dialogElimiarListasevento").dialog({
            autoOpen: false,
            width: 400,
            modal: true,
            buttons: [
                {
                    text: "SI",
                    click: function () {
                        var action = '{{ path('listasevento_delete',{'id':'_id_'})}}';
                        action = action.replace('_id_',rows[0][0]);
                        window.open(action, "_self");                        
                        $(this).dialog("close");
                    }
                },
                {
                    text: "NO",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });
        //Muestra la ventana de confirmacion
        $("#dialogformListasevento").dialog({
            autoOpen: false,
            modal: true,
            buttons: [
                {
                    text: "Guardar",
                    click: function () {
                        $("#formlistasevento").submit();
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Carrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]             
        });
        
        //Configura el titulo de la tabla        
        $('#listasevento').append("<caption><b>Lista " + $("#select_atributos_opcion option:selected").text() + "</b></caption>");
        table.draw();
        $("#select_atributos_opcion").change(function () {
            $('#listasevento > caption').remove();
            $('#listasevento').append("<caption><b>Lista " + $("#select_atributos_opcion option:selected").text() + "</b></caption>");
            table.draw();
        });
        
    });    
</script>    
