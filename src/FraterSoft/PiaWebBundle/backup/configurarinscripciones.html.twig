{% extends '::base.html.twig' %}
{% block style %}    
    {{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':0}) }}
    <style type="text/css">
        #tabs{
            display: none;
        }
        #contentAtributos,#contentComptencias,#contentCategoria,#contentListas{
            width: 700px;
            margin: 10px;
        }    
    </style>
{% endblock %}  
{% block body -%}
    <div id="tabs">    
        {{ include("FraterSoftPiaWebBundle:Evento:tabs.html.twig") }}
        <div id="tabs-2">        
            <div id="accordion">
                <h3>Atributos</h3>
                <div id="contentAtributos">
                    {{ render(controller('FraterSoftPiaWebBundle:EventoAtributos:new',{'idevento':idevento})) }}
                </div>
                <h3>Competencias</h3>
                <div id="contentComptencias">
                    {#{{ render(controller('FraterSoftPiaWebBundle:Competencia:new',{'idevento':idevento})) }}#}
                </div>
                <h3>Categorias</h3>
                <div id="contentCategoria">
                    {#{{ render(controller('FraterSoftPiaWebBundle:Categoria:new',{'idevento':idevento})) }}#}
                </div>
                <h3>Listas</h3>
                <div id="contentListas">
                    {#{{ render(controller('FraterSoftPiaWebBundle:Listasevento:gestion',{'idevento':idevento})) }}#}
                </div>
                <h3>Formas de Pago</h3>
                <div>
                    <p>
                        Cras dictum. Pellentesque habitant morbi tristique senectus et netus
                        et malesuada fames ac turpis egestas. Vestibulum ante ipsum primis in
                        faucibus orci luctus et ultrices posuere cubilia Curae; Aenean lacinia
                        mauris vel est.
                    </p>
                </div>
                <h3>Precios</h3>
                <div>
                    <p>
                        Cras dictum. Pellentesque habitant morbi tristique senectus et netus
                        et malesuada fames ac turpis egestas. Vestibulum ante ipsum primis in
                        faucibus orci luctus et ultrices posuere cubilia Curae; Aenean lacinia
                        mauris vel est.
                    </p>
                </div>
            </div>
        </div>
        <a href="{{ urllistaeventos }}"><button id="button">Regresar</button></a>                       
    </div>
{% endblock %}
{% block javascripts -%}
    <script>
        $(document).ready(function () { 
            $("#accordion").accordion({ 
                heightStyle: "content",
                autoHeight: false,    
                active: false,
                collapsible: true,
            });
            $("#accordion").on( "accordionactivate", function( event, ui ) {
            });
            $("#tabs").css("display","inline");            
            $('#tabs a[href="#tabs-2"]').click();            
            $('#tabs a[href="#tabs-1"]').on("click", function () {
                $(location).attr('href', '{{ path('evento_edit',{'id':idevento}) }}')
            });
        });
    </script>
{% endblock-%}  
