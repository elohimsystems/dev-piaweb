<style>
    #competencias{
        margin: 10px 0;
    }    
    #length{
        float: right
    }
    #categorias_length > label > select{
        width: 50px;
    }
    #formcategoria > div:nth-child(n+0) > label{
        display: inline-block;
        width: 130px;
        text-align: left;   
        vertical-align: middle;
    }
    #formcategoria > div:nth-child(n+0) > input[type="checkbox"]{
        vertical-align: middle;
        margin-left: 0;
    }
    #formcategoria > div:nth-child(n+0) > input[type="text"],input[type="number"] {
        vertical-align: middle;
        width: 196px;
    }
    #formcategoria > div:nth-child(n+0) > select {
        height: 21px;
    }
    #formcategoria > div:nth-child(n+0){
        margin: 5px;
    }    
    td.details-control {
        background: url('{{asset('bundles/fratersoftpiaweb/images/details_open.png')}}') no-repeat center center;
        cursor: pointer;
    }
    tr.shown td.details-control {
        background: url('{{asset('bundles/fratersoftpiaweb/images/details_close.png')}}') no-repeat center center;
    }    
</style> 
{% block body -%}
    <div id="competencias">
        Seleccione el Comptencia
        <select id="select_competencias_opcion">
        {% for competencia in competencias %}
            <option value="{{ competencia.id }}">{{competencia.descripcion}}</option>
        {% endfor %}
        </select>
    </div>
    <table id="categorias" class="display row-border hover">
        <thead>
            <tr>
                <th></th>
                <th>Id</th>
                <th>Idcompetencia</th>
                <th>Descripcion</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td>x</td>
                <td>{{ entity.id }}</td>
                <td>{{ entity.idcompetencia.id }}</td>
                <td>{{ entity.descripcion }}</td>
                <td></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div id="dialogElimiarCategoria" title="Advertencia!!!">
        ¿Esta seguro que desea elimar la Categoria <strong id="eliminarCategoria"></strong>?
    </div>         
    <div id="dialogformCategoria" title="X">
        {{ form_start(form,{'attr': {'id': 'formcategoria'}}) }}
        {{ form_end(form) }} 
    </div> 
    <div id="dialogCategoriaReglas">
        {#{{ render(controller('FraterSoftPiaWebBundle:CategoriaReglas:gestion',{'idcompetencia':361})) }}#}
    </div>
        
{% endblock %}
<link href="{{asset('bundles/fratersoftpiaweb/css/jquery.datetimepicker.css')}}" rel="stylesheet" type="text/css"/>
<script src="{{asset('bundles/fratersoftpiaweb/js/jquery.datetimepicker.full.js')}}" type="text/javascript"></script>  
<script>
    $(document).ready(function () { 
        var tableCategorias;
        var arraycampos;
        var rows=null;
        
        //crea un array javascript con el aaray twig enviado co los campos de la entidad
        arraycampos = {{ campos|json_encode|raw }};
        tableCategorias = $('#categorias').DataTable({
            "dom": 'B<"top"<"#length"l>>rt<"clear">p',
            "order": [[1,'ASC']],
            "autoWidth": false,
            buttons: [
                {text: 'Nuevo',
                    action: function (e, dt, node, config) {
                        $('#formcategoria').attr('action','{{ path('categoria_create')}}'); 
                        $("#fratersoft_piawebbundle_categoria_" + arraycampos[1]).val($("#select_competencias_opcion").val());
                        for(i=2;i<arraycampos.length;i++){
                            $("#fratersoft_piawebbundle_categoria_" + arraycampos[i]).val("");
                        }
                        $("#dialogformCategoria").dialog({ title: "Nueva Categoria" });
                        $("#dialogformCategoria").dialog("open");
                }},                 
                {text: 'Editar',
                    action: function (e, dt, node, config) {
                        var rows = tableCategorias.rows({selected: true}).data();
                        if (rows.length == 1) {

                            //contruye la ruta del action del formulario
                            var action = '{{ path('categoria_update',{'id':'_id_'})}}';
                            action = action.replace('_id_',rows[0][0]);
                            $('#formcategoria').attr('action',action);

                            //carga la informacion seleccionada de la tabla en el formulario
                            for(i=1;i<arraycampos.length;i++){
                                $("#fratersoft_piawebbundle_categoria_" + arraycampos[i]).val(rows[0][i]);
                            }

                            //configura el titulo y abre el formulario
                            $("#dialogformCategoria").dialog({ title: "Editar Categoria" });
                            $("#dialogformCategoria").dialog("open");
                        }
                        else
                            alert("Debe seleccionar la Categoria a editar");                        
                }},                 
                {text: 'Eliminar',
                    action: function (e, dt, node, config) {
                        $("#dialogformCategoria").dialog({ title: "Editar Categoria" });
                        rows = tableCategorias.rows({selected: true}).data();
                        $("#eliminarCategoria").html("");
                        if (rows.length == 1) {
                            $("#eliminarCategoria").append(rows[0][2]);                            
                            $("#dialogElimiarCategoria").dialog("open");                            
                        }
                        else
                            alert("Debe seleccionar la Categoria a eliminar");
                }},                 
            ],
            'select': {
                style: 'os',   
                rows: "%d filas seleccionadas",
            },               
            "language": {
                "emptyTable": "No hay datos para mostrar",
            },
            "columnDefs": [ //Oculta las columnas en la tabla
                { "targets": 0 , "visible": true,
                    "className":      'details-control',
                    "orderable":      false,
                    "data":           null,
                    "defaultContent": '',
                    "width": 20
                },
                { "targets": 1 , "visible": true},
                { "targets": 2 , "visible": true},
                { "targets": 4,  "width": 98 ,
                    "render": function ( data, type, row, meta ) {
                        var urlregla="{{ path('categoriareglas_gestion', { 'idcategoria': '_idcategoria_' }) }}";
                        urlregla = urlregla.replace('_idcategoria_', row[0]);
                        var urledit="{{ path('pago_edit', { 'id': '_id_' }) }}";
                        urledit = urledit.replace('_id_', data);
                        var html=
                            "<ul id='icons' class='ui-widget ui-helper-clearfix'>"
                            + "<a href='" + urlregla + "'>"
                            + "<li class='ui-state-default ui-corner-all' title='Gestion de Reglas'><span class='ui-icon ui-icon-wrench'></span></li>"
                            + "</a>"
                            + "<a href='" + urledit + "'>"
                            + "<li class='ui-state-default ui-corner-all' title='Copiar'><span class='ui-icon ui-icon-copy'></span></li>"
                            + "</a>"
                            + "<a class='dialog-link' href='' onclick='anular(" + data + "," + row.secuencia + ");return false;'>"
                            + "<li class='ui-state-default ui-corner-all' title='Anular'><span class='ui-icon ui-icon-closethick'></span></li>"
                            + "</a></ul>"                                            
                        return html;
                    },        
                },
            ],            
        });    

        filtrarTabla(2);
        
        //Configura el titulo de la tabla        
        $('#categorias').append("<caption><b>Lista " + $("#select_competencias_opcion option:selected").text() + "</b></caption>");
        tableCategorias.draw();
        $("#select_competencias_opcion").change(function () {
            $('#categorias > caption').remove();
            $('#categorias').append("<caption><b>Lista " + $("#select_competencias_opcion option:selected").text() + "</b></caption>");
            //Filtra la tabla de datos segun la opcion del select seleccionado 
            //var filteredData = tableCategorias
            //    .column( 2 )
            //    .data()
             //   .filter( function ( value, index ) {
             //       console.log(value + " " + $("#select_competencias_opcion").val())
            //        return value == $("#select_competencias_opcion").val() ? true : false;
            //     });
            tableCategorias.draw();
        });

        // Add event listener for opening and closing details
        $('#categorias tbody').on('click', 'td.details-control', function () {
            var tr = $(this).closest('tr');
            var row = tableCategorias.row( tr );

            if ( row.child.isShown() ) {
                // This row is already open - close it
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                var url = "{{ path('categoriareglas_listarajax',{'idcategoria':'_idcategoria_'}) }}";
                url=url.replace('_idcategoria_',row.data()[1]);
                $.ajax({
                    type: "GET",
                    //data: criterios,
                    url: url,
                    dataType: "json",
                    success: function (datos)
                    {
                        row.child( format(datos)).show();
                    },
                    error: function (jqXHR, textStatus, errorThrown)
                    {
                        alert("PIA Ajax Error Categoria Reglas: " + jqXHR.responseText);
                    }
                });
                tr.addClass('shown');                                
            }
        });
        
        /* Formatting function for row details - modify as you need */
        function format ( d ) {
            // `d` is the original data object for the row
            return '<table class="display row-border hover">'+
                '<thead>'+
                    '<tr>'+
                        '<th>Atributo</th>'+
                        '<th>Tipo</th>'+
                        '<th>Valor 1</th>'+
                        '<th>Valor 2</th>'+
                        '<th>Acciones</th>'+
                    '</tr>'+
                '</thead>'+
                '<tbody>'+
                    '<tr>'+
                        '<td>edad</td>'+
                        '<td>Rango</td>'+
                        '<td>15</td>'+
                        '<td>29</td>'+
                        '<td>'+
                            '<ul id="icons" class="ui-widget ui-helper-clearfix">' +
                                '<a href="">' +
                                    '<li class="ui-state-default ui-corner-all" title="Gestion de Reglas"><span class="ui-icon ui-icon-wrench"></span></li>' +
                                '</a>' +
                                '<a href="">' +
                                    '<li class="ui-state-default ui-corner-all" title="Copiar"><span class="ui-icon ui-icon-copy"></span></li>' +
                                '</a>' +
                            '</ul>' +
                        '</td>'+
                    '</tr>'+
                    '<tr>'+
                        '<td>sexo</td>'+
                        '<td>Valor</td>'+
                        '<td>Masculino</td>'+
                        '<td></td>'+
                        '<td>'+
                            '<ul id="icons" class="ui-widget ui-helper-clearfix">' +
                                '<a href="">' +
                                    '<li class="ui-state-default ui-corner-all" title="Gestion de Reglas"><span class="ui-icon ui-icon-wrench"></span></li>' +
                                '</a>' +
                                '<a href="">' +
                                    '<li class="ui-state-default ui-corner-all" title="Copiar"><span class="ui-icon ui-icon-copy"></span></li>' +
                                '</a>' +
                            '</ul>' +
                        '</td>'+
                    '</tr>'+
                '<tbody>'+
            '</table>';
        }
        
        //Muestra la ventana de confirmacion
        $("#dialogElimiarCategoria").dialog({
            autoOpen: false,
            width: 400,
            modal: true,
            buttons: [
                {
                    text: "SI",
                    click: function () {
                        var action = '{{ path('categoria_delete',{'id':'_id_'})}}';
                        action = action.replace('_id_',rows[0][0]);
                        window.open(action, "_self");                        
                        $(this).dialog("close");
                    }
                },
                {
                    text: "NO",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });
        //Muestra la ventana de confirmacion
        $("#dialogformCategoria").dialog({
            autoOpen: false,
            width: 400,
            modal: true,
            buttons: [
                {
                    text: "Guardar",
                    click: function () {
                        $("#formcategoria").submit();
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Carrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]             
        });  
        //Muestra la ventana de confirmacion
        $("#dialogformCategoria").dialog({
            autoOpen: false,
            modal: true,
            buttons: [
                {
                    text: "Guardar",
                    click: function () {
                        $("#formcategoria").submit();
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Carrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]             
        });  
    });    
</script>    
