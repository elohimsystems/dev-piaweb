<style>
    .contenido{    
        margin: auto;
        width: 370px;
    }        
    #fratersoft_piawebbundle_inscrito_idpia,#formulario > div:nth-child(n+0){
        margin: 5px;
    }
    /* Seleccion los ultimos n elementos de los div del formulario */
    #formulario > div:nth-last-child(-n+{{ numero_botones + 1}}) { 
        float: left;
        width: 45%;
        text-align: center;
    }
    #formulario > div:nth-child(n+0) > label{
        display: inline-block;
        width: 150px;
        text-align: left;   
        vertical-align: middle;
    }
    #formulario > div:nth-child(n+0) > input[type="checkbox"]{
        vertical-align: middle;
        margin-left: 0;
    }
    #formulario > div:nth-child(n+0) > input[type="text"],input[type="number"] {
        vertical-align: middle;
        width: 196px;
    }
    #formulario > div:nth-child(n+0) > select {
        height: 21px;
    }        
</style>