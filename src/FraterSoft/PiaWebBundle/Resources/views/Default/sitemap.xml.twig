<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://sistemapia.com.ve{{ path('frater_soft_pia_web_landing') }}</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>https://sistemapia.com.ve{{ path('frater_soft_pia_web_contacto') }}</loc>
        <changefreq>monthly</changefreq>
        <priority>0.5</priority>
    </url>
    {% for evento in eventos %}
    <url>
        <loc>https://sistemapia.com.ve{{ path('frater_soft_pia_web_evento_detalle', {'id': evento.id}) }}</loc>
        {% if evento.fecha %}<lastmod>{{ evento.fecha|date('Y-m-d') }}</lastmod>{% endif %}
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
    </url>
    {% endfor %}
</urlset>
