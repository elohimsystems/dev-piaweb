                                ocfun=ocfun.replace(nombrecampo,row[nombrecampo]);
                                //console.log(ocfun);
                                html+="<a onClick='"+ocfun+"'>"
                                + "<li class='ui-state-default ui-corner-all' title='"+actions[0].botones[i].title+"'>"
                                + "<span class='ui-icon "+actions[0].botones[i].icon+"'></span></li>"
                                + "</a>";                            

                            }
                            html+="</ul>";
                        }
                        return html;
                    }
                }    
            ]
        }); 
        return(table);
    }
    
