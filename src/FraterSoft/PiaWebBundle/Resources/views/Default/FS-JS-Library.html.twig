    function buscaPrecio(idevento, idcompetencia, idcategoria,formulario,recargas,idmoneda,credito){ 
        //Busca el precio segun configuracion
        var id_campo_precio=idform(formulario,'precio');
        var id_campo_moneda=idform(formulario,'idmoneda');
        var id_campo_monto=idform(formulario,'monto');
        var id_campo_banco=idform(formulario,'banco');
        var id_campo_referencia=idform(formulario,'referencia');
        var id_campo_idformapago=idform(formulario,'idformapago');
        var id_campo_texto=idform(formulario,'texto');
        var criterios = "idevento=" + idevento
                + "&idcompetencia=" + idcompetencia
                + "&idcategoria=" + idcategoria
                + "&idmoneda=" + idmoneda;
        if (recargas) {
            $(id_campo_precio).find('option').remove();
            $.each(recargas, function (key, value) {
                $("#recarga"+key).remove();
            });
        }
        //Oculta el total a pagar
        $(id_campo_monto).hide();
        $(id_campo_monto).parent().children(0).hide();
        $.ajax({
            type: "GET",
            data: criterios,
            url: "{{ path('inscrito_precio') }}",
            dataType: "json",
            success: function (datos)
            {
                var texto="";
                $.each(datos['values'][0]['values'], function (key, value) {
                    var preciofinal=0;
                    if (credito!=null && credito!=undefined){
                        preciofinal=value.precio-credito.monto;
                        preciofinal=preciofinal.toFixed(2);
                    }
                    else{
                        preciofinal=value.precio;
                    }
                    console.log(preciofinal);
                    texto=((value.texto==null)?'':value.texto + ' ')  + ((value.moneda==null)?'':value.moneda + ' ') + preciofinal;
                    if(value.precio!=-1){
                        $(id_campo_precio).val(preciofinal);
                        $(id_campo_texto).val(value.texto);
                        calcularTotalPagar(
                            $(id_campo_precio),
                            $(id_campo_monto),
                            recargas
                        );
                        $(id_campo_precio).prop("disabled", false);
                        $(id_campo_banco).prop("disabled", false);
                        $(id_campo_referencia).prop("disabled", false);
                        $(id_campo_idformapago).removeAttr("style");
                    }
                    else{
                        $(id_campo_precio).val(0);
                        $(id_campo_monto).val(0);
                        $(id_campo_texto).val(value.texto);
                        $(id_campo_precio).prop("disabled", true);
                        $(id_campo_banco).prop("disabled", true);
                        $(id_campo_referencia).prop("disabled", true);
                        $(id_campo_idformapago).empty();
                        $(id_campo_idformapago).append($('<option>', {
                            value: 14,
                            text: "EXONERADO"
                        }));
                        $(id_campo_idformapago).val(14);
                        $(id_campo_idformapago).attr("style", "pointer-events: none;");                                
                    }
                });             
            },
            error: function (jqXHR, textStatus, errorThrown)
            {
                alert("PIA Ajax Error: " + jqXHR.responseText);
            }
        });
    }            

