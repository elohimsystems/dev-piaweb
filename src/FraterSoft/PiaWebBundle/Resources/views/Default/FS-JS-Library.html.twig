    function calcularTotalPagar(campo_precio,campo_monto,recargas){
        if(recargas.length > 0){
            var recarga=[];
            var texto_porcentaje="";
            var div;
            var montorecargo;
            var total=parseFloat(campo_precio.val());
            $.each(recargas, function (key, value) {
                $("#recarga"+key).remove();
                if(campo_precio.val()){
                    div=campo_precio.parent().get(0);
                    montorecargo=campo_precio.val()*(value['porcentaje']/100);
                    total+=parseFloat(montorecargo);
                    texto_porcentaje=(value['verporcentaje']!=null)?" "+value['porcentaje']+"%":"";
                    recarga.push($("<div id='recarga"+key+"'><label>"+value['nombre']+texto_porcentaje+"</label><spam id='montorecarga'>"+montorecargo.toFixed(2)+"</spam></div>"));
                    recarga[key].insertAfter(div);
                    campo_monto.val(total.toFixed(2));
                    campo_monto.show();
                    campo_monto.parent().children(0).show();
                    console.log(montorecargo);
                }
                else{
                    campo_monto.hide();
                    campo_monto.parent().children(0).hide();
                }            
            });
        }
        else
            campo_monto.val(campo_precio.val());
    }

    function setSession(key,value){
