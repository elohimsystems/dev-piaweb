<script>
    //Abre una ventana de dialogo para cargar la imagen, ajustando el tamano del dialogo a la imagen cargada
    function cargar_imagen(input,image,maxAncho,maxAlto,tipo){
        var uuid = null;
        var file = null;
        var ini=input[0].name.lastIndexOf("[")+1;
        var fin=input[0].name.lastIndexOf("]");
        var nombrecampo=input[0].name.substring(ini,fin);
        var tipobase;
        if(!tipo)
            tipobase="jpg";
        else
            tipobase=tipo;
        if(input.val()!=''){
            var rutamapa = input.val().split('/');
            uuid = rutamapa[0];
            file = rutamapa[1];
            var img = document.getElementById(image.attr("id"));
            $("#uploadimage").dialog({width: img.naturalWidth+59,height:img.naturalHeight+193});
        }
        else{
            uuid = null;
            file = null;
            $("#uploadimage").dialog({width: 300,height:150});
        }
    
        var url="{{asset('bundles/fratersoftpiaweb/fine-uploader/')}}";
        var uploader = new qq.FineUploader({
            debug: false,
            element: document.getElementById('fine-uploader'),
                        //autoUpload: false,
            session : {
                endpoint: url + "/files.php?file=" + file + "&uuid=" + uuid,  
            },
            request: {
                endpoint: url + "/endpoint.php"
            },
            deleteFile: {
                enabled: true,
                endpoint: url + "/endpoint.php",
                forceConfirm: true,
            },
            scaling: {
                customResizer: [
                    {name: "small", maxSize: 100},
                    {name: "medium", maxSize: 200}
                ]
            },
            validation: {
                image: {
                    maxHeight: maxAlto,
                    maxWidth: maxAncho,
                    //minHeight: 300,
                },                           
                allowedExtensions: [tipobase],
            }, 
            messages: {
                maxHeightImageError: "El alto maximo de la imagen debe de ser " + maxAlto + " pixeles",
                maxWidthImageError: "El ancho maximo de la imagen debe de ser " + maxAncho + " pixeles",
                minWidthImageError: "El alto minimo de la imagen debe de ser 300 pixeles",
            },
            chunking: {
                enabled: true,
                concurrent: {
                        enabled: true
                },
                success: {
                        endpoint: url + "/endpoint.php?done"
                }
            },
			
            resume: {
                    enabled: true
            },	
            callbacks: {
                onSessionRequestComplete: function(id, name, response) {
                    var uploads = uploader.getUploads();
                    if(uploads.length>0){
                        var picture = document.getElementsByClassName("qq-thumbnail-wrapper");
                        if(id[0].name.endsWith(tipo)){
                            var src = "{{asset('bundles/fratersoftpiaweb/images/__tipo__-128.png')}}";
                            src = src.replace('__tipo__',tipo)
                            picture[0].firstElementChild.src = src;
                        }
                        else
                            picture[0].firstElementChild.src = url + "files/" + id[0].uuid + "/" + id[0].name;
                        $('#namefile_'+nombrecampo).val(name);
                        var botoncargar = document.getElementsByClassName("qq-upload-button-selector qq-upload-button");
                        botoncargar[0].style.visibility = 'hidden';
                    }
                    else{
                        {#var picture = document.getElementsByClassName("#fine-uploader > div > ul");
                        picture[0].firstElementChild.addVar() = url + "/files/placeholders/not_available-generic.png";    #} 
                    }
                },
                onComplete: function(id, name, resp) {
                    var uuid = uploader.getUuid(id);
                    var urlfile="{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + uuid + '/' + name;
                    input.val(uuid + '/' + name);
                    var botoncargar = document.getElementsByClassName("qq-upload-button-selector qq-upload-button");
                    botoncargar[0].style.visibility = 'hidden';
                    if(name.endsWith(tipo)){
                        var src = "{{asset('bundles/fratersoftpiaweb/images/__tipo__-128.png')}}";
                        src = src.replace('__tipo__',tipo)                        
                        image.attr("src",src);
                        image.wrap("<a href='"+urlfile+"' target='_blank'>");
                    }
                    else
                        image.attr("src","{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + uuid + '/' + name);
                    $('#namefile_'+nombrecampo).val(name);
                    var img = new Image();
                    img.onload = function() {
                        $("#uploadimage").dialog({width: this.width+59,height:this.height+193});
                    }
                    img.src = "{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + uuid + '/' + name;
                },
                onDeleteComplete: function(id,xhr,iserror) {
                    var botoncargar = document.getElementsByClassName("qq-upload-button-selector qq-upload-button");
                    botoncargar[0].style.visibility = 'visible';
                    input.val('');
                    image.attr("src","{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}");
                    $("#uploadimage").dialog({width: 300,height:150});                    
                    $('#namefile_'+nombrecampo).val('');
                }
            }
        });        
        $("#uploadimage").dialog("open");
    }
    
    function controlLoadFile(formcampo,tipo){
        var ini=formcampo[0].name.lastIndexOf("[")+1;
        var fin=formcampo[0].name.lastIndexOf("]");
        var nombrecampo=formcampo[0].name.substring(ini,fin);
        var idcampo=formcampo.selector;
        var idboton="btn_"+nombrecampo;
        var idimagen="imagen_"+nombrecampo;
        formcampo.attr("type","hidden");
        var url = "{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') }}" + $(idcampo).val();
        var nombrearchivo = url.substring(url.lastIndexOf("/")+1,url.length);
        var rutaiconfile="{{asset('bundles/fratersoftpiaweb/images/__tipo__-128.png')}}";
        rutaiconfile=rutaiconfile.replace('__tipo__',tipo);
        $(idcampo).prop('readonly', true);
        $(idcampo).parent().append(
            "<button type='button' id='"+idboton+"'></button>"
        );    
        $("<input id='namefile_"+nombrecampo+"' type='text' value='' readonly>").insertAfter($(idcampo));
        if(formcampo.val()=="")
            $("<img id='"+idimagen+"' src='{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}' sytle='height:21px'/>" ).insertBefore($(idcampo));
        else{
            $("<a href='"+url+"' target='_blank'><img id='"+idimagen+"' src='"+rutaiconfile+"'/></a>" ).insertBefore($(idcampo));
            $("#namefile_"+nombrecampo).val(nombrearchivo);
        }
        $('#'+idboton).append("<img id='icon-"+nombrecampo+"' src='{{asset('bundles/fratersoftpiaweb/images/cargar-archivo.png')}}'/>").button();
        $("#"+idboton).on('click', function() {
            cargar_imagen($(idcampo),$("#"+idimagen),350,600,tipo);
        });            
    }

    function validaEmailPersonal(emailoriginal,campo){
        //console.log(emailoriginal+ ' ' + campo);
        if(campo.val()!=""){
            if(emailoriginal!=campo.val()){
                var url="{{ path('competidor_valida_emailpersonal_ajax',{'email':'_email_'}) }}";
                url=url.replace('_email_',campo.val());
                $.ajax({
                    type: "GET",
                    url: url,
                    //async: false,
                    dataType: "json",
                    success: function (datos){
                        if(datos.recordsTotal==1){
                            alert('Email ya esta asignado a otro competidor y no puede repetirse. Ingrese un nuevo Email Personal o dejelo en blanco y use el Email Secundario');
                            campo.val("");
                            campo.focus();
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown){
                        alert("PIA Ajax Error: " + jqXHR.responseText);
                    }
                });
            }
        }
    }
    
    function validaRequiredHidden(campo){
        if($(campo).attr("required")=="required")
            var ini=campo.attr("name").lastIndexOf("[")+1;
            var fin=campo.attr("name").lastIndexOf("]");
            var nombrecampo=campo.attr("name").substring(ini,fin);
            if($(campo).val()==""){
                alert("El campo " + nombrecampo + " no puede estar vacio");
                return false;
            }
            else
                return true;
    }
    
    function filtrarTabla(columna,select){
        $.fn.dataTable.ext.search.push(
            function( settings, data, dataIndex ) {
                var valor_index = select.val();
                var row = data[columna] || 0; // use data for the age column

                if (valor_index==row){
                    return true;
                }
                return false;
            }        
        );
    }

    /* 
    * FUNCION QUE CREA UN ARRAY CON LA CONFIGURACION NECESARIAA PARA EL DATATABLE 
    * SI ALGUN CAMPO DEL QUERY COMIENZA POR ID, ESTA COLUMNA SE OCULTARA 
    * AUTOMATICAMENTE. TABIEN VALIDA QUE EL VALOR DE CAMPO QUE COMIENZA POR ID
    * TENGA UN VALOR NUMERICO. 
    * */
    
    function getNamesColumsFromObject(data){
        var configcols=[];
        var j=0;
        $.each(data, function( key, value ) {
            if(key.substr(0, 2)=='id' && !isNaN(Number(value)))
                configcols[j++]={ title: toTitleCase(key), data: key, visible:false };
            else
                if (typeof value === 'string' || value instanceof String)
                    configcols[j++]={ title: toTitleCase(key), data: key, render: function(data){ return data.toUpperCase()}  };
                else
                    configcols[j++]={ title: toTitleCase(key), data: key  };
        });
        return(configcols);
    }

    function getNamesColumsFromData(configcols,arraycolumns,data,keydata){
        var j=0;
        keydata=(keydata==null || keydata=="")?"":keydata+".";
        $.each(data, function( key, value ){
            if($.type(value)=="object")
                getNamesColumsFromData(configcols,arraycolumns,value,key);
            else{
                if(key=="date" || key=="timezone_type" || key=="timezone")
                    return(null);
                configcols.push(($.inArray(keydata+key,arraycolumns)!=-1)?{title:key.toUpperCase(),data:(keydata+key),visible:true,render: function(data){ return data.toUpperCase()}}:{title:key,data:keydata+key,visible:false});
            }
        });
        return(null);
    }

    function nameColumsDataTable(arraycampos){
        var configcols=[];
        var i=0;
        $.each(arraycampos, function( key, value ) {
            if(key!='entity'){
                switch(value['constraint']){
                    case 'primarykey':
                        configcols[i]={ title: value['nombre'], data: key, visible: true  };
                        break;
                    case 'foreingkey':
                        switch(value['tipoRelacion']){
                            case 1:
                                var j=i;
                                var contador=0;
                                $.each(value['campos'], function( keyf, valuef ) {
                                    if(valuef['constraint']==""){
                                        configcols[j++]={ title: toTitleCase(valuef['nombre']), data: keyf, visible: true  };
                                        contador++;
                                    }
                                });
                                if(contador>0)i+=contador-1;
                                break;
                            case 2:
                                configcols[i]={ title: value['nombre'], data: key, visible: true  };
                                break;                                
                        }
                        break;
                    default:
                        configcols[i]={ title: toTitleCase(value['nombre']), data: key };
                        break;
                }
                if(value['tipo']=='boolean')
                    configcols[i]['render']=function(data){
                        return(data==true?"<spam class='ui-icon ui-icon-check'></spam>":"");
                    };
                if(value['tipo']=='datetime' || value['tipo']=='datetimetz')
                    configcols[i]['render']=function(data){
                        //var formatted=(data!=null)?$.datepicker.formatDate("d/m/Y H:i", data):data;
                        var formatted=(data!=null)?getFormattedTimestamp(data.timestamp):data;
                        return formatted;
                    };
                i++;
            }
        });
        return(configcols);        
    }

    function tablaDatosArrayObjetos(nombretabla,arraydatos,caption,actions){
