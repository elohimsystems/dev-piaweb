    function buscarFormasPago(formulario,idevento,idmoneda) {
        //Busca el precio segun configuracion
        var id_campo_idformapago=idform(formulario,'idformapago');
        var criterios = "idevento=" + idevento
                + "&idmoneda=" + idmoneda;
        $(id_campo_idformapago).find('option').remove();
        window.sessionStorage.clear();
        var url="{{ path('pago_formaspago_ajax',{'idevento':'_idevento_','idmoneda':'_idmoneda_'}) }}";
        url=url.replace('_idevento_',idevento);
        url=url.replace('_idmoneda_',idmoneda);
        //console.log(url);
        $.ajax({
            type: "GET",
            //data: criterios,
            url: url,
            dataType: "json",
            success: function (datos)
            {                
                $(id_campo_idformapago).append("<option selected value=''>Seleccione una Forma de Pago</option>");
                $.each(datos.data, function (key, value) {
                    $(id_campo_idformapago).append('<option value=' + key + '>' + value.nombre + '</option>');
                    if(value.parametros!=null)
                        setSession(key.toString(),value.parametros);
                });
            },
            error: function (jqXHR, textStatus, errorThrown)
            {
                alert("PIA Ajax Error: " + jqXHR.responseText);
            }
        });
    }            

