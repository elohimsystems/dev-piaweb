{% extends '::base.html.twig' %}
{% block javascripts %}
    <script>
        $(document).ready(function () {
            $("#mensaje" ).append("{{ texto | raw }}");
            $("#botonera" ).append("<button class='ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only'>" +
                "<a href='{{ url }}'>Regresar</a></button>");
            $("#espere" ).hide();            
        });
    </script>           
{% endblock %}     

{% block style %}
    <style type="text/css">  
        #mensaje,#espere{
            margin: auto;            
            text-align: center;
            font-size: 16px;
            width: 400px
        }
        #botonera{
            margin-top: 30px;
            text-align: center;
        }              
        .ui-button{
            padding: 9px;
        }
    </style>
{% endblock %} 
{% block body %}
    <p id="espere">
        <img width="50px" src="{{ asset('bundles/fratersoftpiaweb/images/') ~ 'loading.gif' }}"><br>
        Espera mientras se procesa la operacion...
    </p>
    <p id="mensaje"></p>
    <div id="botonera">
    </div>
{% endblock %}    