{% extends '::base.html.twig' %}

{% block body %}
<div style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;">
    {{ include('FraterSoftPiaWebBundle:Default:_header.html.twig') }}

    <h1 style="color: #333; margin-bottom: 30px;">Eventos</h1>

    <table style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="background: #f5f5f5;">
                <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">Nombre</th>
                <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">Fecha</th>
                <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">Lugar</th>
                <th style="padding: 10px; text-align: left; border-bottom: 2px solid #ddd;">Activo</th>
            </tr>
        </thead>
        <tbody>
            {% for evento in eventos %}
            <tr>
                <td style="padding: 10px; border-bottom: 1px solid #eee;">{{ evento.nombre }}</td>
                <td style="padding: 10px; border-bottom: 1px solid #eee;">{{ evento.fecha|date('d/m/Y') }}</td>
                <td style="padding: 10px; border-bottom: 1px solid #eee;">{{ evento.lugar }}</td>
                <td style="padding: 10px; border-bottom: 1px solid #eee;">{{ evento.activo ? 'SI' : 'NO' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock body %}
