{% extends '::base.html.twig' %}
{% block javascripts %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig") }}
    <script type="text/javascript" language="javascript" src="//cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/pdfmake.min.js"></script>
    <script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/vfs_fonts.js"></script>      
    <script type="text/javascript" language="javascript" src="//cdn.datatables.net/plug-ins/1.10.16/dataRender/datetime.js"></script>  
    <script>
        var idinscrito = 0;
        function anular(id) {
            idinscrito = id;
            $("#dialog").dialog("open");
        }

        $(document).ready(function () {
            url="{{ path('inscrito_lista_auditoriaajax',{'idevento': idevento }) }}";
            var table = $('#tablaAuditoria').DataTable({
                "dom": 'Bflit<"bottom"Bl<"clear">p>',
                //processing: true,
                serverSide: false, 
                ajax: url,                
		buttons: [  
                    {extend: 'excelHtml5',
                        text: 'Exportar',
                        title: 'Listado Auditoria {{nombreevento}}'
                    }, 
                ],
                'select': {
                    style: 'os',   
                    rows: "%d filas marcadas",
                },                
                "language": {
                    "loadingRecords": "Espere - cargando...",
                    "emptyTable": "No hay datos para mostrar",
                    "lengthMenu": "Muestra _MENU_ registros",
                    "info": "Mostrando _START_ de _END_ de _TOTAL_ registros",
                    "search": "Buscar:",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    },
                    "select": {
                        style: 'os',
                        rows: "%d filas marcadas"
                    },                    
                },
                'scrollX': true,
                columns: [
                    { title: "Sec.", data: "secuencia" },
                    { title: "Competencia", data: "idcompetencia.descripcion" },
                    { title: "Numero", data: "numero" },
                    {% for atributo in atributos %}
                    { 
                        title: {% if atributo.etiqueta is null=='S' %}"{{ atributo.idatributo.nombre }}"{% else %}"{{ atributo.etiqueta }}"{% endif %}, 
                        {% if atributo.idatributo.tipodato=='E' %} 
                        data: "idpia.{{atributo.idatributo.nombre|lower}}.nombre",
                        {% else %}
                        data: "idpia.{{atributo.idatributo.nombre|lower}}",
                        {% endif %}
                        {% if atributo.idatributo.tipodato=='S' %} 
                        render: function(data){return data==null?"":data.toUpperCase();} 
                        {% elseif  atributo.idatributo.tipodato=='D' %} 
                        render: function(data){
                            var formatted=null;
                            if(data)
                                formatted = $.datepicker.formatDate("dd/mm/yy", new Date(data.timestamp * 1000));
                            return formatted;
                        }
                        {% elseif  atributo.idatributo.tipodato=='I' %} 
                        render: function(data){
                            if(data){
                                var url = "{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + data;
                                return "<a href='"+url+"' target='_blank'><img id='imagen_foto' src='"+url+"'/></a>";
                            }
                            else{
                                var url = "{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}";
                                return "<img id='imagen_foto' src='"+url+"'/></a>";
                            }
                        }                        
                        {% endif %}},            
                    {% endfor %}
                    { title: "Categoria", data: "idcategoria.descripcion" },
                    { title: "Punto", data: "punto" },
                    { title: "Precio", data: "precio" },   
                    { title: "Estatus", data: "status",
                        render: function(data, type, row){
                            if(data==1 && row.pagos[0].length==0)
                                return('SIN PAGO');
                            else if(data==1 && row.pagos[0].conciliado==true)
                                return('INSCRITO');
                            else if(data==1 && row.pagos[0].conciliado==null && row.pagos[0].tipo!='3')
                                return('PREINSCRITO');
                            else if(data==1 && row.pagos[0].conciliado==null && row.pagos[0].tipo=='3')
                                return('TDC NO PAGADO');
                            else if(data==0)
                                return('ANULADO');
                            else return('');
                        }
                    },
                    /* INFORMACION DEL PAGO */
                    { title: "FechaPago", data: "pagos.0.fechapago",
                        render: function(data){
                            if(data && data.timestamp){
                                var fecha = new Date(data.timestamp * 1000);
                                if(!isNaN(fecha.getTime())){
                                    var dd = ("0"+fecha.getDate()).slice(-2);
                                    var mm = ("0"+(fecha.getMonth()+1)).slice(-2);
                                    var yy = fecha.getFullYear();
                                    return dd+"/"+mm+"/"+yy;
                                }
                            }
                            return null;
                        }
                    },
                    { title: "Texto", data: "pagos[0].texto" },        
                    { title: "Monto", data: "pagos[0].monto" },        
                    { title: "Moneda", data: "pagos[0].moneda" },        
                    { title: "Referencia", data: "pagos[0].referencia" },        
                    { title: "Comprobante", data: "pagos[0].comprobante" },                            
                    { title: "Forma de Pago", data: "pagos[0].idformapago.nombre"},   
                    { title: "Banco", data: "pagos[0].idbanco.nombre" },        
                    { title: "Conciliado?", data: "pagos[0].conciliado",
                        render: function(data){
                            return(data?"SI":"NO");
                        }
                    },        
                    { title: "ConciliadoEl", data: "pagos.0.conciliadoel",
                        render: function(data){
                            if(data){
                                var fecha;
                                if(data.timestamp)
                                    fecha = new Date(data.timestamp * 1000);
                                else
                                    fecha = new Date(data);
                                if(!isNaN(fecha.getTime())){
                                    var dd = ("0"+fecha.getDate()).slice(-2);
                                    var mm = ("0"+(fecha.getMonth()+1)).slice(-2);
                                    var yy = fecha.getFullYear();
                                    var hh = ("0"+fecha.getHours()).slice(-2);
                                    var mi = ("0"+fecha.getMinutes()).slice(-2);
                                    return dd+"/"+mm+"/"+yy+" "+hh+":"+mi;
                                }
                            }
                            return null;
                        }            
                    },
                    { title: "Liquidado", data: "pagos[0].idliquidacion" },
                ],
                "columnDefs": [ //Oculta las columnas en la tabla
                    {% set target=3 %}
                    {% for atributo in atributos %}
                    {% if atributo.idatributo.tipo=='U' %}
                    { "visible": false, "targets": {{ target }} },
                    {% endif %}
                    {% set target=target+1 %}
                    {% endfor %}
                ],           
                
            });
            //Muestra la ventana de confirmacion
            $("#notificacion").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('inscrito_notificar_confirmacion_lote', { 'data_json':'_data_json_','idevento':idevento}) }}";
                            url = url.replace('_data_json_', data_json);
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });
            //Muestra la ventana de confirmacion
            $("#anumeros").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('numeracion_asignar', {'idevento':idevento}) }}";
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });            
            //Muestra la ventana de confirmacion
            $("#rnumeros").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('numeracion_resetear', {'idevento':idevento}) }}";
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });           
            //Muestra la ventana de confirmacion
            $("#correosatodos").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('inscrito_notificar_confirmacion_todos', {'idevento':idevento}) }}";
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            }); 
            $("#dialog").dialog({
                autoOpen: false,
                width: 400,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('inscrito_anular', { 'id':'_idinscrito_'}) }}";
                            url = url.replace('_idinscrito_', idinscrito);
                            window.open(url, "_self")
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });            
        });

        $(function () {
            $("#tabs").tabs();
            $('#tabs a[href="#tabs-6"]').click();
            $('#tabs a[href="#tabs-1"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_preinscritos',{'idevento':idevento}) }}')
            });
            $('#tabs a[href="#tabs-2"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_inscritos',{'idevento':idevento}) }}')
            });
            $('#tabs a[href="#tabs-3"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_anulados',{'idevento':idevento}) }}')
            });
            $('#tabs a[href="#tabs-5"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_estadisticas',{'idevento':idevento}) }}')
            });             
            $("#seccionCargando").hide();        
            $("#contenido").show();        
        });

    </script>           
{% endblock %} 
{% block style %}
<style type="text/css">
    #contenido{     
        display: none;
    }
    #seccionCargando > img{
        width: 50px;
    }        
    #seccionCargando{
        text-align: center;
    }    
    td,th{
        font-size: 10px;
    }
    .ui-icon {
        -ms-transform: scale(0.7); /* IE 9 */
        -webkit-transform: scale(0.7); /* Chrome, Safari, Opera */
        transform: scale(0.7);
    }        
    .dataTables_length,.dataTables_filter{
        margin-top: 3px;
    }
    select{
        width: 50px;
    }
    #evento{
        border: 1px solid #d8dcdf;
        padding: 5px;
        margin-bottom: 3px;
        border-radius: 6px;
        font-weight: bold;        
    }    
</style>
{% endblock %}  
{% block body -%}
    <div style="max-width:1200px; margin:auto">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div id="seccionCargando">
        <img src="{{ asset('bundles/fratersoftpiaweb/images/loading.gif') }}">
    </div>        
    <div id="contenido">            
        <div id="evento">{{nombreevento}}</div>
        <div id="tabs">
            <ul>
                <li><a href="#tabs-1">Pre-Inscritos</a></li>
                <li><a href="#tabs-2">Inscritos</a></li>
                <li><a href="#tabs-3">Anulados</a></li>
                <li><a href="#tabs-5">Estadisticas</a></li>    
                <li><a href="#tabs-6">Audutoria</a></li>    
            </ul>
            <div id="tabs-1"></div>
            <div id="tabs-2"></div>  
            <div id="tabs-3"></div>  
            <div id="tabs-5"></div>  
            <div id="tabs-6">
                <table id="tablaAuditoria" class="display row-border hover">
                </table>     
                <a href="{{ path('evento_listemail',{'email':email}) }}"><button id="button">Regresar</button></a>
            </div>
            <div id="notificacion" title="Advertencia!!!">
                <p id="msgconc">Desea reenviar las notificaciones de Confirmacion de Inscripcion de las siguintes secuencias: <div id="ids"></div></p>
            </div>            
            <div id="anumeros" title="Advertencia!!!">
                <p id="msgconc">¿Esta seguro que desea ASIGNAR los numeros?</p>
            </div>  
            <div id="rnumeros" title="Advertencia!!!">
                <p id="msgconc">¿Esta seguro que desea RESETEAR los numeros?</p>
            </div>  
            <div id="correosatodos" title="Advertencia!!!">
                <p id="msgconc">¿Esta seguro que desea enviar la confirmacion a todos los inscritos? El proceso tardara varios minutos.</p>
            </div> 
            <div id="dialog" title="Advertencia!!!">
                <p>Esta seguro que desea anular inscripcion con la secuencia <b id="sec"></b> ?</p>
            </div>        
        </div>
    </div>
    </div>
{% endblock %}
