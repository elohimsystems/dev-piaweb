{% extends '::base.html.twig' %}
{% block stylesheets %}
    <link href="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.css')}}" rel="stylesheet" type="text/css"/>
{% endblock %}
{% block jsQuery %}    
    <script src="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.js')}}" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
{% endblock %}
{% block style %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':2}) }}
    <style type="text/css">
        #{{form.archivo.vars.id}}{
            width: 145px !important; 
            vertical-align: middle;
        }
        #namefile{
            width: 145px; 
            vertical-align: middle;
        }
        #btn_archivo{
            height: 21px;
            width: 31px;
        }     
        #btn_archivo > span{
            padding-bottom: 0;
            padding-top: 0;
            padding-left: 0;
            padding-right: 0;
        }
        #icon-archivo{
            vertical-align: middle;
        }
        #imagen_archivo{
            height: 20px;
            vertical-align: middle;
            padding-right: 2px;
        }
        #tabs{  /* Oculta el tabs para que se muestre luego de cargar todo el html */
            display: none;
        }        
        th{
            text-transform:capitalize;
        }
   </style>
{% endblock %}    
{% block javascripts %}
    <script>
        var competencias = [];
        var categorias = [];
        var estados = [];
        var paises = [];
        var formaspago = [];
        var atributos = [];
        var titulos = [];
        var table;
        {% for clave,campo in campos %}
            {% if campo is iterable %}
                {% if campo['constraint']!='primarykey' %}
                var atributo = new Object();
                atributo.nombre="{{campo['nombre']}}";
                atributo.tipo="{{campo['tipo']}}";
                atributo.longitud="{{campo['longitud']}}";
                atributos["{{campo['nombre']}}"]=atributo;
                titulos.push("{{campo['nombre']}}");
                {% endif %}
            {% endif %}
        {% endfor %}
        //crea un array de las competencias del evento, para validar los datos cargados
        {% for competencia in competencias %}
            competencias.push("{{competencia.descripcion}}");
        {% endfor %}
        //crea un array de los estados del sistema, para validar los datos cargados
        {% for estado in estados %}
            estados.push("{{estado.nombre}}");
        {% endfor %}            
        //crea un array de las categorias del evento, para validar los datos cargados
        {% for categoria in categorias %}
            categorias.push("{{categoria.descripcion}}");
        {% endfor %}            
        //crea un array de las paises del sistema, para validar los datos cargados
        {% for pais in paises %}
            paises.push("{{pais.nombre}}");
        {% endfor %}            
        //crea un array de las paises del sistema, para validar los datos cargados
        {% for formapago in formaspago %}
            formaspago.push("{{formapago.idformapago.nombre}}");
        {% endfor %}            
        console.log(formaspago);
            
        //agrega los titulos al array que no estan en Competidor
        titulos.push("competencia");
        titulos.push("numero");
        titulos.push("categoria");
        titulos.push("precio");
        titulos.push("formapago");
        titulos.push("referencia");
        titulos.push("conciliadoel");
        titulos.push("banco");
        titulos.push("discapacitado");
        titulos.push("tipodiscapacidad");
        titulos.push("confranela");
        titulos.push("estatus");
        
        
        var dataSet=[];
        var camposSet=[];
        function processData(allText) {
            var MessageErrors = "";
            var allTextLines = allText.split(/\r\n|\n/);
            var header = allTextLines[0].split(',');            
            //Valida que la primera fila del archivo poseea los titulos adecuados
            for(i=0;i<header.length;i++){
                for(j=0;j<titulos.length;j++){
                    if($.inArray(header[i],titulos)==-1){
                        MessageErrors += "Nombre del titulo " + header[i] + " no es valido, use el archivo con el formato "
                        + " adecuado para importar los datos. Borre el archivo, corrijalo y vuelva a cargarlo.\n";
                        //return false;
                    }
                }
            }
            
            //Configura los titulos de la tabla
            for(i=0;i<header.length;i++){
                switch(header[i]){
                    case "fechanacimiento":
                        camposSet[i]={ title: "Nacido El"};
                        break;
                    case "tipodiscapacidad":
                        camposSet[i]={ title: "Tipo Discapacidad"};
                        break;
                    case "email":
                        camposSet[i]={ title: "Email Secundario"};
                        break;
                    case "confranela":
                        camposSet[i]={ title: "Con Franela?"};
                        break;
                    case "tallafranela":
                        camposSet[i]={ title: "Talla Franela"};
                        break;
                    default:
                        camposSet[i]={ title: header[i]};
                }
            }
            //console.log(camposSet);
            //Configura el dataset con que sera llenada la tabla
            var line=[];
            for(nl=1,j=0;nl<allTextLines.length && allTextLines[nl]!="";nl++){
                line[j]=allTextLines[nl].split(',');
                for(col=0;col<header.length;col++){
                    //console.log(header[col]);
                    if(line[j][col]!="" && typeof atributos[header[col]] === "object"){
                        switch(atributos[header[col]].tipo){
                            case "string":
                                if(atributos[header[col]].longitud<line[j][col].length){
                                    MessageErrors += "Error en la columna " + header[col] + ", linea " + (nl+1) +
                                            ", el valor '" + line[j][col] + ". Longitud mayor " + atributos[header[col]].longitud + "<br>";
                                    //return false;
                                }
                                break;
                            case "datetime":
                                if(isNaN(Date.parse(line[j][col]))){
                                    MessageErrors += "Error en la columna: " + header[col] + ", linea: " + (nl+1) +
                                            ", el valor '" + line[j][col] + ". Formato de fecha incorrecto, formato correcto: aaaa/mm/dd<br>";
                                    //return false;
                                }
                                break;
                            case "bigint":
                                if(isNaN(line[j][col])){
                                    if(header[col]!="idpais"){ //quitar validacion cuando se configure el idpais como clave foranea
                                        MessageErrors += "Error en la columna: " + header[col] + ", linea: " + (nl+1) +
                                                ", el valor '" + line[j][col] + ". Valor no es numerico<br>";
                                        //return false;
                                    }
                                }
                                break;
                        }
                    }
                    if(line[j][col]!=""){
                        //VALIDA LA COMPETENCIA DEL ARCHIVO
                        if(col == 0 && competencias.indexOf(line[j][col])==-1){
                            MessageErrors += "Error en la linea: " + (j+1) + ", columna 'COMPETENCIA'" +
                                    ", el valor '" + line[j][10] + "', no esta configurado en el evento<br>";
                            //return false;
                        }
                        //VALIDA EL ESTADO DEL ARCHIVO
                        //console.log('estados:',estados);
                        if(col == 12 && estados.indexOf(line[j][col])==-1){
                            MessageErrors += "Error en la linea: " + (j+1) + ", columna 'ESTADO'" +
                                    ", el valor '" + line[j][12] + "', no esta configurado en el sistema<br>";
                            console.log('linea',line[j]);
                            //return false;
                        }
                        //VALIDA EL PAIS DEL ARCHIVO
                        if(col == 13 && paises.indexOf(line[j][col])==-1){
                            MessageErrors += "Error en la linea: " + (j+1) + ", columna 'PAIS'" +
                                    ", el valor '" + line[j][13] + "', no esta configurado en el sistema<br>";
                            //return false;
                        }
                        //VALIDA LA FORMA DE PAGO DEL ARCHIVO
                        if(col == 16 && formaspago.indexOf(line[j][col])==-1){
                           MessageErrors += "Error en la linea: " + (j+1) + ", columna 'FORMA DE PAGO'" +
                                    ", el valor '" + line[j][16] + "', no esta configurado en el evento<br>";
                            //return false;
                        }
                        //VALIDA LA CATEGORIA DEL ARCHIVO
                        console.log('categoria archivo',line[j][22]);
                        console.log('categoria sistema',categorias);
                        if(col == 22 && categorias.indexOf(line[j][col])==-1){
                            MessageErrors += "Error en la linea: " + (j+1) + ", columna 'CATEGORIA'" +
                                    ", el valor '" + line[j][22] + "', no esta configurado en el evento<br>";
                            //return false;
                        }
                    }
                }
                dataSet.push(line[j++]);
            }
            if (MessageErrors!=""){
                Swal.fire({
                    title: 'Información Importante',
                    html: MessageErrors,
                    //icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Aceptar',
                    cancelButtonText: 'Cancelar'
                });

                return false;
            }            
            //console.log(dataSet);
            return true;
        }        
        $().ready(function () {
            
            var data=null;
            controlLoadFile($("#{{form.archivo.vars.id}}"),"csv");
            
            $('#form_Importar').click(function() {
                if($('#namefile_archivo').val()=="")
                    alert("Debe cargar primero el archivo de datos");
                else
                    $("#confirmacion").data('event',event).dialog("open");                    
            });

            $('#csvcompetidor').DataTable( {
                data: null,
                pageLength: 100,
                columns:[
                    {data:'competencia',title:'Competencia'},
                    {data:'numero',title:'Numero'},
                    {data:'iddocumento',title:'IdDocumento'},
                    {data:'apellido',title:'Apellido'},
                    {data:'nombre',title:'Nombre'},
                    {data:'fechanacimiento',title:'Nacido el'},
                    {data:'sexo',title:'Sexo'},
                    {data:'edad',title:'Edad'},
                    {data:'discapacitado',title:'Discapacitado'},
                    {data:'tipodiscapacidad',title:'Tipo Discapacidad'},
                    {data:'email',title:'Email Secundario'},
                    {data:'telefono',title:'Telefono'},
                    {data:'estado',title:'Estado'},
                    {data:'pais',title:'Pais'},
                    {data:'equipo',title:'Club'},
                    {data:'precio',title:'Precio'},
                    {data:'formapago',title:'Forma Pago'},
                    {data:'referencia',title:'Referencia'},
                    {data:'banco',title:'Banco'},
                    {data:'confranela',title:'Con Franela?'},
                    {data:'tallafranela',title:'Talla Franela'},
                    {data:'categoria',title:'Categoria'},
                    {data:'estatus',title:'Estatus'}]
                });

            $('#imagen_archivo').on('load', function () {
                if($('#imagen_archivo').attr('src').endsWith('csv-128.png')){
                    data = "{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + $("#{{form.archivo.vars.id}}").val();
                    $.ajax({
                        type: "GET",
                        url: data,
                        dataType: "text",
                        success: function(data) {
                            if(processData(data)){
                                $('#csvcompetidor').DataTable().destroy();
                                table = $('#csvcompetidor').DataTable( {
                                    data: dataSet,
                                    columns: camposSet
                                });
                            }
                        }
                     });
                }
                else{
                    $('#csvcompetidor').DataTable().clear().draw();
                    dataSet=[];
                }
            });                                 
            
            //muestra la ventana para cargar imagenes o archivos
            $("#uploadimage").dialog({
                autoOpen: false,
                modal: true,
                buttons: [
                    {
                        text: "Aceptar",
                        click: function () {
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "Cerrar",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });           
            
            $("#confirmacion").dialog({
                autoOpen: false,
                modal: true,
                buttons: [
                    {
                        text: "Si",
                        click: function () {
                            $( "#formulario" ).submit();
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "No",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });                        
        });
    </script><meta http-equiv="Content-Type" content="text/html; charset=euc-jp">   
{% endblock %}

{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div>        
        <div>     
            <h1>Importar Inscripciones de Plantilla</h1>
            {{ form_start(form,{'attr': {'id': 'formulario'}}) }}
            {{ form_end(form) }}
            <table id="csvcompetidor" class="display" cellspacing="0" width="100%">
            </table>
            <div id="uploadimage">    
                <div id="fine-uploader"></div>  
                {{ include("FraterSoftPiaWebBundle:Evento:template-fineuploader.html.twig") }} 
            </div>    
            <div id="confirmacion">    
                Esta seguro que desea ingresar los datos del archivo cargado?
            </div>  
            {{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig",{'idevento':null}) }}    
        </div> 
    </div>         
    </div>
{% endblock %}
