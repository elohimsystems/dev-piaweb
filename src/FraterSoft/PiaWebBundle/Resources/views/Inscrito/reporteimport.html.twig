{% extends '::base.html.twig' %}
{% if tema is defined and tema is not null %}{% set temastyle=tema.styles %}{% endif %} 
{% block style %}
    <style type="text/css">         
        #mensaje{
            margin: auto;            
            text-align: center;
            font-size: 16px;
            margin-bottom: 20px;            
            /*width: 400px*/
        }
        #botonera{
            margin-top: 30px;
            text-align: center;
        }
        #variables{
            margin:auto;
            width: 300px;
        }
        th{
            width: 250px;
            text-align: left;
        }
        td{
            width: 50px;
        }
    </style>
{% endblock %} 
{% block body %}
    <div class="contenido">
        <div id="mensaje">{{ mensaje | raw }}</div>
        <div id="variables">
            <table>
                <tr>
                    <th>Cantidad de Registros:</th><td>{{ cantidad_registros }}</td>
                </tr>                
                <tr>
                    <th>Competidores agregados:</th><td>{{ competidores_i }}</td>
                </tr>
                <tr>
                    <th>Competidores actualizados:</th><td>{{competidores_a}}</td>
                </tr>
                <tr>
                    <th>Inscripciones agregadas:</th><td>{{inscritos_i}}</td>
                </tr>
                <tr>
                    <th>Inscripciones existentes:</th><td>{{inscritos_existentes}}</td>
                </tr>
            </table>
        </div>
        <div id="botonera">
            <a href="{{ url }}">
                <button class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
                        Regresar
                </button> 
            </a>
            {% if urlcontinuar is defined %}
                <a href="{{ urlcontinuar }}">
                    <button class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
                        Continuar
                    </button>             
                </a>
            {% endif %}
        </div>
    </div>
{% endblock %}    