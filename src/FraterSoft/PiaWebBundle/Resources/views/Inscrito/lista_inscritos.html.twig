{% extends '::base.html.twig' %}
{% block javascripts %}
    <script type="text/javascript" language="javascript" src="//cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/pdfmake.min.js"></script>
    <script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/vfs_fonts.js"></script>      
    <script type="text/javascript" language="javascript" src="//cdn.datatables.net/plug-ins/1.10.16/dataRender/datetime.js"></script> 
    <script src="{{asset('bundles/fratersoftpiaweb/js/jquery.datetimepicker.full.js')}}" type="text/javascript"></script>    
    <script>
        var idinscrito = 0;
        function anular(id) {
            idinscrito = id;
            $("#dialog").dialog("open");
        }
        console.log("{{ path('inscrito_lista_inscritosajax',{'idevento': idevento }) }}");
        $(document).ready(function () {
            url="{{ path('inscrito_lista_inscritosajax',{'idevento': idevento }) }}";
            var emails=[];
            var table = $('#tablaInscritos').DataTable({
                "dom": 'Bflit<"bottom"Bl<"clear">p>',
                processing: true,
                serverSide: false, 
                ajax: url,                
		buttons: [  
                    {extend: 'excelHtml5',
                        text: 'Exportar',
                        title: '',
                        filename: 'Inscritos {{nombreevento}}',
                        // Genera UN solo Excel con una hoja por disciplina; cada hoja lleva los
                        // inscritos de esa disciplina ordenados por fecha de conciliacion (asc).
                        // Un inscrito multicompetencia aparece en la hoja de cada modalidad.
                        customize: function (xlsx) {
                            var NS_MAIN = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main';
                            var NS_R = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';
                            var NS_CT = 'http://schemas.openxmlformats.org/package/2006/content-types';
                            var NS_REL = 'http://schemas.openxmlformats.org/package/2006/relationships';

                            var exp = table.buttons.exportData({ modifier: { search: 'applied', order: 'applied' } });
                            var rowsData = table.rows(null, { search: 'applied', order: 'applied' }).data().toArray();

                            // Columnas que NO se exportan
                            var excluir = ['Precio', 'Recarga', 'Total'];
                            var keep = [];
                            for (var h = 0; h < exp.header.length; h++) {
                                if (excluir.indexOf(exp.header[h]) === -1) keep.push(h);
                            }
                            var header = keep.map(function (idx) { return exp.header[idx]; });
                            var body = exp.body.map(function (row) {
                                return keep.map(function (idx) { return row[idx]; });
                            });

                            var colDist = header.indexOf({{ (titulocompetencias|default('Distancia'))|json_encode|raw }});
                            var colCat = header.indexOf('Categoria');

                            // Agrupa las filas por disciplina
                            var grupos = {}, orden = [];
                            function push(nombre, celdas, ts) {
                                nombre = (nombre && String(nombre).trim()) ? String(nombre).trim() : 'SIN DISCIPLINA';
                                if (!grupos[nombre]) { grupos[nombre] = []; orden.push(nombre); }
                                grupos[nombre].push({ celdas: celdas, ts: ts });
                            }
                            for (var r = 0; r < body.length; r++) {
                                var rd = rowsData[r] || {};
                                var base = body[r];
                                var ts = 0;
                                if (rd.pagos && rd.pagos[0] && rd.pagos[0].conciliadoel && rd.pagos[0].conciliadoel.timestamp) {
                                    ts = parseInt(rd.pagos[0].conciliadoel.timestamp, 10) || 0;
                                }
                                var comps = (rd.competencias && rd.competencias.length) ? rd.competencias : null;
                                if (comps) {
                                    for (var k = 0; k < comps.length; k++) {
                                        var c = base.slice();
                                        if (colDist !== -1) c[colDist] = comps[k].idcompetencia ? comps[k].idcompetencia.descripcion : '';
                                        if (colCat !== -1) c[colCat] = comps[k].idcategoria ? comps[k].idcategoria.descripcion : '';
                                        push(c[colDist], c, ts);
                                    }
                                } else {
                                    push(colDist !== -1 ? base[colDist] : '', base, ts);
                                }
                            }
                            if (orden.length === 0) { orden.push('Sin datos'); grupos['Sin datos'] = []; }
                            orden.sort();
                            orden.forEach(function (n) { grupos[n].sort(function (a, b) { return a.ts - b.ts; }); });

                            // Helpers para armar el XML de cada hoja
                            function colLetra(idx) {
                                var s = '', n = idx + 1;
                                while (n > 0) { var m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); }
                                return s;
                            }
                            function esc(v) {
                                return String(v == null ? '' : v)
                                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                                    .replace(/"/g, '&quot;').replace(/'/g, '&apos;');
                            }
                            function celdaXml(ref, val) {
                                var s = String(val == null ? '' : val);
                                if (s !== '' && /^-?\d+(\.\d+)?$/.test(s) && !/^0\d+/.test(s)) {
                                    return '<c r="' + ref + '" t="n"><v>' + s + '</v></c>';
                                }
                                return '<c r="' + ref + '" t="inlineStr"><is><t xml:space="preserve">' + esc(s) + '</t></is></c>';
                            }
                            function hojaXml(filas) {
                                var xml = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
                                    '<worksheet xmlns="' + NS_MAIN + '" xmlns:r="' + NS_R + '"><sheetData>';
                                xml += '<row r="1">';
                                for (var c = 0; c < header.length; c++) xml += celdaXml(colLetra(c) + '1', header[c]);
                                xml += '</row>';
                                for (var f = 0; f < filas.length; f++) {
                                    var rn = f + 2;
                                    xml += '<row r="' + rn + '">';
                                    for (var cc = 0; cc < header.length; cc++) xml += celdaXml(colLetra(cc) + rn, filas[f].celdas[cc]);
                                    xml += '</row>';
                                }
                                return xml + '</sheetData></worksheet>';
                            }
                            var usados = {};
                            function nombreHoja(n) {
                                var base = String(n).replace(/[\\\/\?\*\[\]:]/g, ' ').substring(0, 31).replace(/^\s+|\s+$/g, '') || 'Hoja';
                                var nm = base, i = 2;
                                while (usados[nm.toLowerCase()]) { nm = base.substring(0, 27) + ' ' + i; i++; }
                                usados[nm.toLowerCase()] = true;
                                return nm;
                            }

                            // Reconstruye el paquete xlsx con una hoja por disciplina
                            var sheetsXml = '', relsXml = '', ctSheetsXml = '';
                            xlsx.xl.worksheets = {};
                            orden.forEach(function (nombre, idx) {
                                var n = idx + 1;
                                var file = 'sheet' + n + '.xml';
                                xlsx.xl.worksheets[file] = $.parseXML(hojaXml(grupos[nombre]));
                                sheetsXml += '<sheet name="' + esc(nombreHoja(nombre)) + '" sheetId="' + n + '" r:id="rId' + n + '"/>';
                                relsXml += '<Relationship Id="rId' + n + '" Type="' + NS_R + '/worksheet" Target="worksheets/' + file + '"/>';
                                ctSheetsXml += '<Override PartName="/xl/worksheets/' + file + '" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>';
                            });
                            delete xlsx.xl['styles.xml'];
                            xlsx.xl['workbook.xml'] = $.parseXML('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
                                '<workbook xmlns="' + NS_MAIN + '" xmlns:r="' + NS_R + '"><sheets>' + sheetsXml + '</sheets></workbook>');
                            xlsx.xl._rels['workbook.xml.rels'] = $.parseXML('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
                                '<Relationships xmlns="' + NS_REL + '">' + relsXml + '</Relationships>');
                            xlsx['[Content_Types].xml'] = $.parseXML('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
                                '<Types xmlns="' + NS_CT + '">' +
                                '<Default Extension="xml" ContentType="application/xml"/>' +
                                '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
                                '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>' +
                                ctSheetsXml + '</Types>');
                        }
                    },
                    { extend: 'print', text: 'Imprimir' },
                    {%if nivel_seguridad == 1%}
                    /*{text: 'Asignar Numeros',
                        action: function (e, dt, node, config) {
                            $("#anumeros").dialog("open");
                    }},*/                 
                    {% endif %}
                    {%if nivel_seguridad == 1%}
                    {text: 'Resetear Numeros',
                        action: function (e, dt, node, config) {
                            $("#rnumeros").dialog("open");
                    }},                 
                    {% endif %}
                    {%if nivel_seguridad == 1%}
                    {text: 'Importar',
                        action: function (e, dt, node, config) {
                            url = "{{ path('inscrito_importar', { 'idevento':idevento}) }}";
                            //url = url.replace('_data_json_', data_json);
                            window.open(url, "_self");
                    }},                 
                    {% endif %}
                    {%if nivel_seguridad == 1%}
                    {text: 'Notificar',
                        action: function (e, dt, node, config) {
                            var countelement = 0;
                            var separador;
                            var rows = table.rows({selected: true}).data();
                            if (rows.length > 0) {
                                var id = new Object();
                                $("#ids").html("");
                                for (var i = 0; i < rows.length; i++) {
                                    separador = (countelement == 0) ? "" : ",";
                                    $("#ids").append(separador + rows[i].secuencia);
                                    id[countelement] = rows[i].secuencia;
                                    countelement++;
                                }
                                //Muestra u oculta el mensaje de secuencias a conciliar
                                if(countelement==0) $("#msgconc").hide(); else $("#msgconc").show();
                                if(countelement>0){
                                    data_json = JSON.stringify(id);
                                    $("#notificacion").dialog("open");
                                }
                                else{
                                    alert("Debe seleccionar por lo menos una inscripcion distinta de TACR")
                                }
                            }
                            else
                                $("#correosatodos").dialog("open");
                    }},                
                    {% endif %}
                ],
                'select': {
                    style: 'os',   
                    rows: "%d filas marcadas",
                },                
                "language": {
                    "loadingRecords": "Espere - cargando...",
                    "emptyTable": "No hay datos para mostrar",
                    "lengthMenu": "Muestra _MENU_ registros",
                    "info": "Mostrando _START_ de _END_ de _TOTAL_ registros",
                    "search": "Buscar:",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    },
                    "select": {
                        style: 'os',
                        rows: "%d filas marcadas"
                    },                    
                },
                'scrollX': true,
                "order":[[{{ atributos|length }} +6 ,'asc'],[0,'asc']],
                "pageLength": 100,
                columns: [
                    { title: "Numero", data: "numero" },
                    {% for atributo in atributos %}
                    {% if atributo.idatributo.nombre=='emailpersonal'%}
                        {title:"Email",data:"idpia.emailpersonal",render: function(data, type, row){
                                if(row.idpia.emailpersonal==row.idpia.email)
                                    return row.idpia.emailpersonal
                                else if(row.idpia.emailpersonal==null)
                                    return row.idpia.email
                                else if(row.idpia.email==null)
                                    return row.idpia.emailpersonal
                                else return row.idpia.emailpersonal+","+row.idpia.email}},
                    {% elseif atributo.idatributo.nombre!='email'%}
                    {% if atributo.orden!=99 %}
                    { 
                        title: {% if atributo.etiqueta is null %}"{{ atributo.idatributo.nombre|capitalize }}"{% else %}"{{ atributo.etiqueta }}"{% endif %}, 
                        {% if atributo.idatributo.tipodato=='E' %} 
                        data: "idpia.{{atributo.idatributo.nombre|lower}}.nombre",
                        {% else %}
                        data: "idpia.{{atributo.idatributo.nombre|lower}}",
                        {% endif %}
                        {% if atributo.idatributo.tipodato=='S' %} 
                        render: function(data){return data==null?"":data.toUpperCase();}, 
                        {% elseif  atributo.idatributo.tipodato=='D' %} 
                        render: function(data){
                            var formatted=null;
                            if(data)
                                formatted = $.datepicker.formatDate("dd/mm/yy", new Date(data.timestamp * 1000));
                            return formatted;
                        },
                        {% elseif  atributo.idatributo.tipodato=='I' %} 
                        render: function(data){
                            if(data){
                                var url = "{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + data;
                                return "<a href='"+url+"' target='_blank'><img id='imagen_foto' src='"+url+"'/></a>";
                            }
                            else{
                                var url = "{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}";
                                return "<img id='imagen_foto' src='"+url+"'/></a>";
                            }
                        },                        
                        {% endif %}
                        {% if atributo.idatributo.tipo=="U" %}
                            visible:true,
                        {% endif %}
                    },            
                    {% endif %}
                    {% endif %}
                    {% endfor %}
                    { title: {{ (titulocompetencias|default('Distancia'))|json_encode|raw }}, data: "idcompetencia", defaultContent: "", render: function(data){return data==null?"":data.descripcion;} },
                    { title: "Categoria", data: "idcategoria", defaultContent: "", render: function(data){return data==null?"":data.descripcion;} },
                    { title: "Punto", data: "punto", visible:false },
                    { title: "Precio", data: "pagos[0].precio", visible:false },
                    { title: "Recarga", data: "pagos[0].regarga", visible:false },
                    { title: "Total", data: "pagos[0].monto", visible:false },   
                    { title: "Conciliado el", data: "pagos",
                        render: function(data){
                            //console.log($.formatDateTime('mm/dd/y g:ii a', new Date('2012/07/05 09:55:03')));
                            //console.log($.datetimepicker.formatDateTime('mm/dd/y g:ii a',new Date(data[0].conciliadoel.timestamp * 1000)));
                            //var formatted="";
                            //if(data[0].conciliadoel!=null)  
                            //    formatted = $.datepicker.formatDate("dd/mm/yyT00:00:00", new Date(data[0].conciliadoel.timestamp * 1000));
                            //return formatted;
                            var c = (data && data[0]) ? data[0].conciliadoel : null;
                            if(!c || !c.timestamp) return "";
                            var fecha = new Date(c.timestamp * 1000);
                            if(isNaN(fecha.getTime())) return "";
                            //return ('0' + fecha.getDay()).slice(-2) + "/" + ('0' + fecha.getMonth()).slice(-2) + "/" + fecha.getFullYear();
                            return fecha.getFullYear() + "/" + ('0' + (fecha.getMonth()+1)).slice(-2) + "/" + ('0' + fecha.getDate()).slice(-2) + " "
                                + ('0' + fecha.getHours()).slice(-2) + ":" + ('0' + fecha.getMinutes()).slice(-2) + ":" + ('0' + fecha.getSeconds()).slice(-2);
                        }
                    },   
                    { title: "Notificado", data: "notificado",render: function(data){return data!=true?"NO":"SI";} },
                    { title: "Sec.", data: "secuencia" },
                    { title: "Acciones", data:"id",render:
                                function(data, type, row){
                                    var urlshow="{{ path('inscrito_show', { 'id': '_id_' }) }}";
                                    urlshow = urlshow.replace('_id_', data);
                                    var urledit="{{ path('inscrito_edit', { 'id': '_id_' }) }}";
                                    urledit = urledit.replace('_id_', data);
                                    var html=
                                        "<ul id='icons' class='ui-widget ui-helper-clearfix'>"
                                        + "<a href='" + urlshow + "'>"
                                        + "<li class='ui-state-default ui-corner-all' title='Ver'><span class='ui-icon ui-icon-search'></span></li>"
                                        + "</a>"
                                        {% if nivel_seguridad == 1 %} + "<a href='" + urledit + "' >"
                                        + "<li class='ui-state-default ui-corner-all' title='Editar'><span class='ui-icon ui-icon-pencil'></span></li>"
                                        + "</a>"
                                        + "<a href='' onclick='anular(" + data + "," + row.secuencia + ");return false;'>"
                                        + "<li class='ui-state-default ui-corner-all' title='Anular'><span class='ui-icon ui-icon-closethick'></span></li>"
                                        + "</a>"{% endif %}
                                        + "</ul>"
                                    return html;
                                },
                        "width": "98px","orderable": false
                    },                     
                ],  
            });
            //Muestra la ventana de confirmacion
            $("#notificacion").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('inscrito_notificar_confirmacion_lote', { 'data_json':'_data_json_','idevento':idevento}) }}";
                            url = url.replace('_data_json_', data_json);
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });
            //Muestra la ventana de confirmacion
            $("#anumeros").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('numeracion_asignar', {'idevento':idevento}) }}";
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });            
            //Muestra la ventana de confirmacion
            $("#rnumeros").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('numeracion_resetear', {'idevento':idevento}) }}";
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });           
            //Muestra la ventna de confirmacion
            $("#correosatodos").dialog({
                autoOpen: false,
                width: 400,
                modal: true,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('inscrito_notificar_confirmacion_todos', {'idevento':idevento}) }}";
                            window.open(url, "_self");
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            }); 
            $("#dialog").dialog({
                autoOpen: false,
                width: 400,
                buttons: [
                    {
                        text: "SI",
                        click: function () {
                            url = "{{ path('inscrito_anular', { 'id':'_idinscrito_'}) }}";
                            url = url.replace('_idinscrito_', idinscrito);
                            window.open(url, "_self")
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "NO",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });            
        });

        $(function () {
            $("#tabs").tabs();
            $('#tabs a[href="#tabs-2"]').click();
            $('#tabs a[href="#tabs-1"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_preinscritos',{'idevento':idevento}) }}')
            });
            $('#tabs a[href="#tabs-3"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_anulados',{'idevento':idevento}) }}')
            });
            $('#tabs a[href="#tabs-5"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_estadisticas',{'idevento':idevento}) }}')
            });             
            $('#tabs a[href="#tabs-6"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_auditoria',{'idevento':idevento}) }}')
            });         
            
            $("#seccionCargando").hide();        
            $("#contenido").show();        
            
        });

    </script>           
{% endblock %} 
{% block style %}
<style type="text/css">
    #contenido{     
        display: none;
    }
    #seccionCargando > img{
        width: 50px;
    }        
    #seccionCargando{
        text-align: center;
    }    
    td,th{
        font-size: 10px;
    }
    .ui-icon {
        -ms-transform: scale(0.7); /* IE 9 */
        -webkit-transform: scale(0.7); /* Chrome, Safari, Opera */
        transform: scale(0.7);
    }        
    .dataTables_length,.dataTables_filter{
        margin-top: 3px;
    }
    select{
        width: 50px;
    }
    #evento{
        border: 1px solid #d8dcdf;
        padding: 5px;
        margin-bottom: 3px;
        border-radius: 6px;
        font-weight: bold;        
    }    
</style>
{% endblock %}  
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div id="seccionCargando">
        <img src="{{ asset('bundles/fratersoftpiaweb/images/loading.gif') }}">
    </div>        
    <div id="contenido">
        <div id="evento">{{nombreevento}}</div>
        <div id="tabs">
            <ul>
                <li><a href="#tabs-1">Pre-Inscritos</a></li>
                <li><a href="#tabs-2">Inscritos</a></li>
                <li><a href="#tabs-3">Anulados</a></li>
                <li><a href="#tabs-5">Estadisticas</a></li>
                {% if nivel_seguridad == 1 %}<li><a href="#tabs-6">Auditoria</a></li>{% endif %}
            </ul>
            <div id="tabs-1"></div>
            <div id="tabs-3"></div>  
            <div id="tabs-5"></div>  
            <div id="tabs-2">
                <table id="tablaInscritos" class="display row-border hover">
                </table>     
                <a href="{{ path('frater_soft_pia_web_eventos') }}"><button id="button">Regresar</button></a>
            </div>
            <div id="notificacion" title="Advertencia!!!">
                <p id="msgconc">Desea reenviar las notificaciones de Confirmacion de Inscripcion de las siguintes secuencias: <div id="ids"></div></p>
            </div>
            <div id="anumeros" title="Advertencia!!!">
                <p id="msgconc">¿Esta seguro que desea ASIGNAR los numeros?</p>
            </div>  
            <div id="rnumeros" title="Advertencia!!!">
                <p id="msgconc">¿Esta seguro que desea RESETEAR los numeros?</p>
            </div>  
            <div id="correosatodos" title="Advertencia!!!">
                <p id="msgconc">¿Esta seguro que desea enviar la confirmacion a todos los inscritos? El proceso tardara varios minutos.</p>
            </div> 
            <div id="dialog" title="Advertencia!!!">
                <p>Esta seguro que desea anular inscripcion con la secuencia <b id="sec"></b> ?</p>
            </div>        
        </div>
    </div>
    </div>
{% endblock %}
