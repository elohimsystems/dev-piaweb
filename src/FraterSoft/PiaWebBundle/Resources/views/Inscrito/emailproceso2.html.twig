{% extends '::base.html.twig' %}
{% import "FraterSoftPiaWebBundle:Default:FS-TWIG-Library.html.twig" as twiglib %}
{% block poweredby %}
{{ include('FraterSoftPiaWebBundle:Default:_poweredby.html.twig') }}
{% endblock %}
{% block style %}
<style type="text/css">
    th{
        text-align:left;
    }
    table{
        padding: 10px;
        width:650px;
        border: 1px solid black;
    }
</style>
{% endblock %}
{% block body -%}
    

    <table class="record_properties" align="center" border="0">
        <tbody>
            
            {% if entity.idevento.idorganizador.logo is not null %}
            <tr>
                <td colspan='3' align='center'>
                    <img width="300 px" 
                         src="{{ app.request.getSchemeAndHttpHost() ~ asset('bundles/fratersoftpiaweb/images/') ~ entity.idevento.idorganizador.logo }}">                    
                </td>
            </tr>
            {% endif %}
            <tr>
                <td colspan='3' align='center'>
                    <h1>Confirmaci&oacute;n de Pre-Inscripci&oacute;n</h1>
                </td>
            </tr>
            <tr>
                <td rowspan="{{entity.idevento.atributos|length + 4}}">
                    <img width="300 px" 
                         src="{{ app.request.getSchemeAndHttpHost() ~ asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ entity.idevento.logo }}">
                </td>
            </tr>            
            {% for atributo in entity.idevento.atributos %}
            {% if atributo.etiqueta is null %}
            <tr><th>{{atributo.idatributo.nombre|capitalize}}</th><td>{{twiglib.imprimirAtributo(atributo,attribute(entity.idpia,'get'~atributo.idatributo.nombre))}}</td></tr>
            {% else %}
            <tr><th>{{atributo.etiqueta}}</th><td>{{ twiglib.imprimirAtributo(atributo,attribute(entity.idpia,'get'~atributo.idatributo.nombre)) }}</td></tr>
            {% endif %}
            {% endfor %}
            <tr><th>Categoria</th><td>{{ entity.idcategoria.descripcion }}</td></tr>     
            <tr><th>Competencia</th><td>{{ entity.idcompetencia.descripcion }}</td></tr>
            <tr>
                <th>PreInscrito el</th>
                <td>{{ entity.fechahora|date('d-m-Y H:i:s') }}</td>
            </tr>
            <tr>
                <td colspan="3">
                    <p>
                    Estimad@ Atleta,<br>
                    Un gusto saludarle<br>
                    </p>
                    <p>Para formalizar la inscripci&oacute;n en el evento: {{ entity.idevento.nombre }}, a realizarse el {{ entity.idevento.fecha|date("d/m/Y") }} en {{ entity.idevento.lugar }}{% if entity.idevento.localidad %}, {{ entity.idevento.localidad }}{% endif %}. Hora de Salida: {{ entity.idevento.fecha|date("H:i") }}</p>
                    <p><span style="background-color:yellow"><b>Debe responder dicho correo adjuntando el soporte de pago.</b></span></p>
                    <p> 
                        Costo:<br>
                        {% for prc in precios %}
                        {{ entity.idcompetencia.descripcion }} - {{prc.moneda}}{{prc.precio|number_format(0, ',', '.')}} 
                        {% endfor %}
                    </p>
                    <p><b>FORMAS DE PAGO EN BOL&Iacute;VARES <br><br>
                    TRANSFERENCIA</b><br>
                    SOLO de Banesco a Banesco<br>
                    Rafael Rodriguez<br>
                    C&eacute;dula 6.973.974<br>
                    0134 0348 1234 8108 2621<br><br>
                    <b>PAGO MOVIL</b><br>
                    De otros Bancos a Banesco<br>
                    04148928433<br>
                    10.933.738<br>
                    Banesco<br><br>
                    <b>FORMAS DE PAGO EN DIVISAS</b><br>
                    <b>ZELLE</b><br>
                    Carolina Cortes<br>
                    puroeventospzo@gmail.com<br>
                    Enivar Nombre del titular de la cuenta<br>
                    <br>
                    {{ entity.idevento.puntoinscripcion|raw }} 
                    <p>
                    {{ entity.idevento.rutavideo|raw }}
                    <br>
                    {{ entity.idevento.rutaperfil|raw }}
                    <br>
                    Cualquier pregunta o inquietud no dude en contactarnos.<br>
                    </p>
                    <p>
                    {{ entity.idevento.idorganizador.contacto }}<br>
                    {{ entity.idevento.idorganizador.telefonocontacto }}<br>
                    </p>
                </td>
            </tr>              
        </tbody>
    </table>
    {% if controlParental is defined and controlParental %}
    <table align="center" border="0" style="margin-top:20px; border:1px solid #ccc; padding:15px; width:650px;">
        <tr><td style="font-weight:bold; font-size:14px;">Aviso Importante</td></tr>
        <tr><td style="padding-top:8px;">{{ controlParental.mensaje }}</td></tr>
        {% if controlParental.documento_pdf and controlParental.titulo_documento %}
        <tr><td style="padding-top:8px;"><b>Documento adjunto:</b> {{ controlParental.titulo_documento }}</td></tr>
        {% endif %}
    </table>
    {% endif %}
</ul>
{% endblock %}
