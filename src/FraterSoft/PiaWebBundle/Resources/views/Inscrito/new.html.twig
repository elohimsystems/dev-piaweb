        }
        #{{form.idpia.vars.id}} > div:nth-child(n+0):hover{
            font-weight: bold;
        }         
        
        {%if form.pagos is defined %}
        
        /****************************************************/
        /*  Configura el estilo del subformulario pago ******/
        /****************************************************/
        {##{{form.idpago.vars.id}} > div:nth-child(1){
            /*display: none;*/
        }         
        #{{form.pagos.vars.id}} > div:nth-child(n+0){
            margin-top: 5px;
        }         
        #fratersoft_piawebbundle_inscrito_pagos > div:nth-child(n+0){
            margin-top: 5px;
        }
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > label{
            display: inline-block;
            width: 180px;
            text-align: left;   
            vertical-align: middle;
        }
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > input[type="checkbox"]{
            vertical-align: middle;
            margin-left: 0;
        }
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > label[class="error"]{
            width: 20px;
        }
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0):hover{
            font-weight: bold;
        }        
        #}
        div[id*=idmoneda]{
