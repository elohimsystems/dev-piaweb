        }
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > input[type="text"],input[type="number"],textarea{
            vertical-align: middle;
            width: 196px;
        }
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > select {
            height: 21px;
            width: 204px;
        }
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > label{
            display: inline-block;
