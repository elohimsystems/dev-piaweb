        }
        {% endif %}

        /***********************************************************************
        * Da formato al formulario del competidor *
        ***********************************************************************/
        #{{form.idpia.vars.id}} > div:nth-child(n+0){
            margin-top: 5px;
        }         
        #{{form.idpia.vars.id}} > div:nth-child(n+0) > label{
            display: inline-block;
