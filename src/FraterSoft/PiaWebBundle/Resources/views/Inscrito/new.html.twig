   </style>
{% endblock %}    
{% block poweredby %}
{% for publicidad in entity.idevento.publicidad %}
    {% if publicidad.idubicacion == 3 and publicidad.estatus==1 %}
        <div style="text-align: center;">
            <img width="1350" height="100" src="{{asset('bundles/fratersoftpiaweb/images/' ~ publicidad.imagen)}}"/>
        </div>
    {% endif %}
{% endfor %}
{{ include('FraterSoftPiaWebBundle:Default:_poweredby.html.twig') }}
{% endblock %}
{% set index_pago = form.pagos|length %}
{% block body -%}   
    <div class="contenido">    
        <div id="titulogrupos">    
            <div>Inscripciones Grupales</div>
            <div>Agregre Integrante <b>N° {{integrante}}</b> {% if integrante > 1 %}o Edite el Grupo{% endif %}</div>
        </div>   
        {# {{dump(credito)}} #}
        {{ form_start(form,{'attr': {'id': 'formulario'}}) }}
        {% if multicompetenciaActivo %}
        {{ form_row(form.idevento) }}
        {{ form_errors(form.idpia) }}
        {{ form_widget(form.idpia) }}
        <div class="multicompetencia-campo">
            <table class="multicompetencia-tabla">
                <thead>
                    <tr>
                        <th>{{ entity.idevento.titulocompetencias|default('Modalidades') }}</th>
                        <th>Categoria</th>
                    </tr>
                </thead>
                <tbody id="{{ form.idcompetencias.vars.id }}">
                    {% for child in form.idcompetencias %}
                    <tr class="multicompetencia-fila">
                        <td>
                            {{ form_widget(child) }}
                            {{ form_label(child) }}
                        </td>
                        <td>
                            <span class="multicompetencia-item" id="multicompetencia-item-{{ child.vars.value }}" style="display:none;">
                                <select id="idcategoria_select_{{ child.vars.value }}" name="idcategoria_{{ child.vars.value }}">
                                    <option value="">Seleccione una Categoría</option>
                                </select>
                                <span id="precio_comp_{{ child.vars.value }}"></span>
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div id="multicompetencia-total">
                <strong>Total: </strong><span id="multicompetencia-total-valor">0</span>
            </div>
        </div>
        {% endif %}
        {{ form_end(form) }}
        {% if controlParentalConfig %}
        <div id="dialog-menor-edad" title="Aviso Importante" style="display:none;">
            <p>{{ controlParentalConfig.mensaje }}</p>
            {% if controlParentalConfig.documento_pdf %}
            <p>
                Descargue el {{ controlParentalConfig.titulo_documento }} <a href="{{ asset(controlParentalConfig.documento_pdf) }}" target="_blank">AQUI</a>
            </p>
            {% endif %}
        </div>
        {% endif %}
        <div id="uploadimage">    
            <div id="fine-uploader"></div>  
            {{ include("FraterSoftPiaWebBundle:Evento:template-fineuploader.html.twig") }} 
        </div>  
        {{twiglib.mensajetdc()}}
    </div>    
{% endblock %}
{% block javascripts %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig",{'idevento':entity.idevento.id}) }}            
    <script>
        var controlParentalConfig = {{ controlParentalConfig|json_encode|raw }};
        var menor_edad_requiere_confirmacion = {{ menor_edad ? 'true' : 'false' }};
        var menor_edad_confirmado = false;

        function addPagoForm(collectionHolder, $newLinkLi) {
            // Obtiene los datos del prototipo explicado anteriormente
            var prototype = collectionHolder.data('prototype');
        
            // Consigue el nuevo índice
            var index = collectionHolder.data('index');
        
            // Sustituye el '__name__' en el prototipo HTML para que
            // en su lugar sea un número basado en cuántos elementos hay
            var newForm = prototype.replace(/__name__/g, index);
            
        
            // Incrementa en uno el índice para el siguiente elemento
            collectionHolder.data('index', index + 1);
        
            // Muestra el formulario en la página en un elemento li,
            // antes del enlace 'Agregar una etiqueta'
            var $newFormLi = $('<li></li>').append(newForm);
            $newLinkLi.before($newFormLi);
        }    
        
        {% for atributo in atributos %}
            $("#fratersoft_piawebbundle_inscrito_idpia_{{ atributo.idatributo.nombre|lower }}").change(function () {
                buscaCategorias();
            });
        {% endfor %}      
        
        var precios=[];
        function buscaCategorias() {
        {% if multicompetenciaActivo %}
            //En modo multicompetencia la categoria se carga por cada competencia marcada
            $('#{{ form.idcompetencias.vars.id }} input[type=checkbox]:checked').each(function () {
                cargaCategoriasMulti($(this).val());
            });
        {% elseif form.idcategoria is defined %}
            //Busca las categorias segun los atributos configurados
            if(!$('#{{ form.idcompetencia.vars.id }}').val()){
                alert('Debe seleccionar una Competencia');
                return null;
            }            
            //Busca las categorias segun los atributos configurados
            var criterios = "idevento=" + $('#{{ form.idevento.vars.id }}').val()
                    + "&idcompetencia=" + $('#{{ form.idcompetencia.vars.id }}').val() + "&";
        {% for atributo in atributos %}
                if ($("#fratersoft_piawebbundle_inscrito_idpia_{{ atributo.idatributo.nombre|lower }}").val() == '')
                    return null;
                criterios += "{{ atributo.idatributo.nombre|lower }}=" + $("#fratersoft_piawebbundle_inscrito_idpia_{{ atributo.idatributo.nombre|lower }}").val();
            {% if not loop.last %}
                    criterios += "&";
            {% endif %}
        {% endfor %}      
                    console.log("{{ path('inscrito_categorias') }}?" + criterios);
                    $.ajax(
                            {
                                type: "GET",
                                data: criterios,
                                url: "{{ path('inscrito_categorias') }}",
                                dataType: "json",
                                success: function (datos)
                                {
                                    $("#{{ form.idcategoria.vars.id }}").empty();
                                    $("#{{ form.idcategoria.vars.id }}").prop("required", true);
                                    if (datos.length == 0){
                                        alert("No existe una Categoria aplicable");
                                        return(null);
                                    }
                                    if (datos.length > 1)
                                        $("#{{ form.idcategoria.vars.id }}").append("<option selected value=''>Seleccione una Categoría</option>");
                                    else
                                        {% if entity.idevento.proceso == 1 %}
                                        //console.log($("#formulario input[type='radio']:checked").val());
                                        buscaPrecio(
                                                $('#{{ form.idevento.vars.id }}').val(),
                                                $('#{{ form.idcompetencia.vars.id }}').val(),
                                                datos[0].id,
                                                $('#formulario'),
                                                {{recargas|json_encode|raw}},
                                                $("#formulario input[type='radio']:checked").val(),
                                                {{creditox|json_encode|raw}}
                                        );    
                                        {% endif %}
                                    $.each(datos, function (key, value) {
                                        $('#{{ form.idcategoria.vars.id }}').append($('<option>', {
                                            value: value.id,
                                            text: value.descripcion
                                        }));
                                    });
                                },
                                error: function (jqXHR, textStatus, errorThrown)
                                {
                                    alert("PIA Ajax Error: " + jqXHR.responseText);
                                }
                            }
                    );
        {% endif %}
        }

        {% if multicompetenciaActivo %}
        //Carga la categoria aplicable para UNA competencia marcada (modo multicompetencia)
        function cargaCategoriasMulti(idComp) {
            var criterios = "idevento=" + $('#{{ form.idevento.vars.id }}').val() + "&idcompetencia=" + idComp + "&";
        {% for atributo in atributos %}
            if ($("#fratersoft_piawebbundle_inscrito_idpia_{{ atributo.idatributo.nombre|lower }}").val() == '')
                return null;
            criterios += "{{ atributo.idatributo.nombre|lower }}=" + $("#fratersoft_piawebbundle_inscrito_idpia_{{ atributo.idatributo.nombre|lower }}").val();
            {% if not loop.last %}
            criterios += "&";
            {% endif %}
        {% endfor %}
            $.ajax({
                type: "GET",
                data: criterios,
                url: "{{ path('inscrito_categorias') }}",
                dataType: "json",
                success: function (datos) {
                    var $sel = $("#idcategoria_select_" + idComp);
                    $sel.empty();
                    if (datos.length == 0) {
                        alert("No existe una Categoria aplicable para una de las modalidades seleccionadas");
                        return null;
                    }
                    if (datos.length > 1)
                        $sel.append("<option selected value=''>Seleccione una Categoría</option>");
                    $.each(datos, function (key, value) {
                        $sel.append($('<option>', {value: value.id, text: value.descripcion}));
                    });
                    if (datos.length == 1) {
                        buscaPrecioMulti(idComp, datos[0].id);
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert("PIA Ajax Error: " + jqXHR.responseText);
                }
            });
        }

        //Precio por evento (tarifa base) para la moneda seleccionada. Se muestra al cargar
        //la pagina y se cobra UNA sola vez si alguna modalidad no tiene precio propio.
        var precioEventoMulti = 0;

        //Carga el precio por evento para la moneda seleccionada
        function cargarPrecioEventoMulti() {
            var idmon = $("#formulario input[type='radio']:checked").val();
            if (!idmon) return;
            $.ajax({
                type: "GET",
                data: { idevento: $('#{{ form.idevento.vars.id }}').val(), idmoneda: idmon },
                url: "{{ path('inscrito_precio_evento') }}",
                dataType: "json",
                success: function (d) {
                    precioEventoMulti = (d && d.precio) ? parseFloat(d.precio) || 0 : 0;
                    recalcularTotalMulticompetencia();
                }
            });
        }

        //Busca el precio ESPECIFICO de UNA modalidad (de competencia o categoria; 0 si no
        //tiene precio propio y debe usar la tarifa base del evento).
        function buscaPrecioMulti(idComp, idCategoria) {
            var idmon = $("#formulario input[type='radio']:checked").val();
            if (!idmon) return;
            $.ajax({
                type: "GET",
                data: {
                    idcompetencia: idComp,
                    idcategoria: idCategoria || '',
                    idmoneda: idmon
                },
                url: "{{ path('inscrito_precio_competencia') }}",
                dataType: "json",
                success: function (d) {
                    var monto = (d && d.precio) ? parseFloat(d.precio) || 0 : 0;
                    $("#precio_comp_" + idComp).data('precio', monto)
                        .text(monto > 0 ? monto.toFixed(2) : '(tarifa base)');
                    recalcularTotalMulticompetencia();
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert("PIA Ajax Error: " + jqXHR.responseText);
                }
            });
        }

        //Precio total = suma de los precios especificos de las modalidades marcadas + la
        //tarifa base del evento UNA sola vez (solo si alguna modalidad no tiene precio propio).
        //Sin modalidades marcadas se muestra la tarifa base del evento.
        function recalcularTotalMulticompetencia() {
            var $marcadas = $('#{{ form.idcompetencias.vars.id }} input[type=checkbox]:checked');
            var total = 0;
            if ($marcadas.length === 0) {
                total = precioEventoMulti;
            } else {
                var sumaEspecificos = 0;
                var algunaSinPrecio = false;
                $marcadas.each(function () {
                    var v = $('#precio_comp_' + $(this).val()).data('precio');
                    v = (v != null && v !== '') ? (parseFloat(v) || 0) : 0;
                    if (v > 0) sumaEspecificos += v;
                    else algunaSinPrecio = true;
                });
                total = sumaEspecificos + (algunaSinPrecio ? precioEventoMulti : 0);
            }
            $("#multicompetencia-total-valor").text(total.toFixed(2));
            {% if form.pagos is defined %}
            $("#{{ form.pagos[0].precio.vars.id }}").val(total.toFixed(2));
            {% endif %}
        }
        {% endif %}

        $().ready(function () {

            //Oculta el mensaje del credito si no existe el credito para el competidor
            {% if creditox is null %}
                $("#{{ form.pagos[0].message.vars.id }}").parent().hide()            
            {% endif %}

        
            {% if idgrupo is not null and not multicompetenciaActivo %}
            $('#{{form.idcompetencia.vars.id}}').val({{idcompetencia}});
            $('#{{form.idcompetencia.vars.id}}').prop("disabled",true);
            {% endif %}
        
