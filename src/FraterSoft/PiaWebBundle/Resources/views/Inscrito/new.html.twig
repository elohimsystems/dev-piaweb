        }
        #formulario > div:nth-child(6):hover{
            font-weight: bold;
        }  
        #formulario > div:nth-child(7):hover{
            font-weight: bold;
        }          
        #formulario > div:nth-child(3){
            margin: 0px;
        }
        #formulario > div:nth-child(3) > label{
            display:none;
        }
        #formulario > div:nth-child(n+0) > label{
            width: 180px;
        }        
        /***********************************************************************
        * Da formato al formulario del competidor *
        ***********************************************************************/
        #{{form.idpia.vars.id}} > div:nth-child(n+0){
