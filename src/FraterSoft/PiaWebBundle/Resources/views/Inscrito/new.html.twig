        }
        #camposimple{
            border: 1px solid rgb(169, 169, 169);
            height: 19px;
            width: 198px;
            display: flex;
            align-items: center;    
            background: white;
        }        
        input.error,select.error,.verimail-error.valid { 
            border: 1px solid red; 
            background-color: #ffa07a;
        }
        .valid{
            background-color: white;
        }
        label.error {
            display:none !important; 
        }                  
        #montorecarga{
            -webkit-appearance: textarea;
            border: 1px solid gray;
            font: medium -moz-fixed;
            font: -webkit-small-control;
            height: 16px;
            padding: 2px 0px 2px 0px;
            resize: both;
            width: 198px;
        }
        #titulogrupos{
            text-align: center;
            display:none;
        }    
        {#% endif %#}
        
    @media screen and (max-width: 547px){
        form{
            font-size: 0.9em;
            width: 344px;
        }
        #{{form.idpia.vars.id}} > div:nth-child(n+0) > input[type="text"],input[type="number"],textarea,
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > input[type="text"], input[type="number"], textarea{
            width: 166px;
            font-size: 0.8em;
        }
        #fratersoft_piawebbundle_inscrito_idpia > div:nth-child(n+0) > select,
        #formulario > div:nth-child(n+0) > select,
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > select,
        div[id*=idmoneda] {        
            height: 18px;
            width: 174px;
            font-size: 0.8em;
        }
        #fratersoft_piawebbundle_inscrito_idpia > div:nth-child(n+0) > label,
        #formulario > div:nth-child(n+0) > label ,
        div[id*=fratersoft_piawebbundle_inscrito_pagos] > div:nth-child(n+0) > label {
