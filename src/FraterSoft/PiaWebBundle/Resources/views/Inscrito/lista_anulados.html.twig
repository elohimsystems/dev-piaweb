{% extends '::base.html.twig' %}
{% block javascripts %}
    <script type="text/javascript" language="javascript" src="//cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/pdfmake.min.js"></script>
    <script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/vfs_fonts.js"></script>      
    <script>
        var idinscrito = 0;
        function anular(id) {
            idinscrito = id;
            $("#dialog").dialog("open");
        }

        $(document).ready(function () {
            $('#tablaAnulados').dataTable({
                "dom": 'Bf<"top"li>rt<"bottom"Blp><"clear">',
                //'scrollX': true,
                buttons: [
                    {extend: 'excelHtml5',
                        text: 'Exportar',
                        title: 'Listado Anulados {{nombreevento}}'
                    }, 
                    { extend: 'print', text: 'Imprimir' }
                ],
                "language": {
                    "emptyTable": "No hay datos para mostrar",
                    "lengthMenu": "Muestra _MENU_ registros",
                    "info": "Mostrando _START_ de _END_ de _TOTAL_ registros",
                    "search": "Buscar:",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    },
                }
            });
        });

        $(function () {
            $("#tabs").tabs();
            $('#tabs a[href="#tabs-3"]').click();
            $('#tabs a[href="#tabs-1"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_preinscritos',{'idevento':idevento}) }}')
            });
            $('#tabs a[href="#tabs-2"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_inscritos',{'idevento':idevento}) }}')
            });
            $('#tabs a[href="#tabs-5"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_estadisticas',{'idevento':idevento}) }}')
            });             
            $('#tabs a[href="#tabs-6"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_auditoria',{'idevento':idevento}) }}')
            });         
            $("#seccionCargando").hide();        
            $("#contenido").show();        
        });
    </script>           
{% endblock %}    
{% block style %}
<style type="text/css">
    #contenido{     
        display: none;
    }
    #seccionCargando > img{
        width: 50px;
    }        
    #seccionCargando{
        text-align: center;
    }    
    td,th{
        font-size: 10px;
    }
    .ui-icon {
        -ms-transform: scale(0.7); /* IE 9 */
        -webkit-transform: scale(0.7); /* Chrome, Safari, Opera */
        transform: scale(0.7);
    }        
    table.dataTable tbody th, table.dataTable tbody td{
        padding: 0;
    } 
    .dataTables_length,.dataTables_filter{
        margin-top: 3px;
    }
    select{
        width: 50px;
    }
    #evento{
        border: 1px solid #d8dcdf;
        padding: 5px;
        margin-bottom: 3px;
        border-radius: 6px;
        font-weight: bold;        
    }    
</style>
{% endblock %}  
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div id="seccionCargando">
        <img src="{{ asset('bundles/fratersoftpiaweb/images/loading.gif') }}">
    </div>        
    <div id="contenido">            
        <div id="evento">{{nombreevento}}</div>
        <div id="tabs">
            <ul>
                <li><a href="#tabs-1">Pre-Inscritos</a></li>
                <li><a href="#tabs-2">Inscritos</a></li>
                <li><a href="#tabs-3">Anulados</a></li>
                <li><a href="#tabs-5">Estadisticas</a></li>    
                {% if nivel_seguridad == 1 %}<li><a href="#tabs-6">Auditoria</a></li>{% endif %}
            </ul>
            <div id="tabs-1"></div>
            <div id="tabs-2"></div>  
            <div id="tabs-5"></div>  
            <div id="tabs-3">
                <table id="tablaAnulados" class="display row-border hover">
                    <thead>
                        <tr>
                            <th>Nro</th>
                            <th>{{ titulocompetencias|default('Competencia') }}</th>
                            <th>Cedula</th>                
                            <th>Apellido</th>
                            <th>Nombre</th>
                            <th>Sexo</th>
                            <th>Equipo</th>
                            <th>Estado</th>
                            <th>Categoria</th>
                            <th>Punto</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for anulada in anuladas %}
                            <tr>
                                <td>{{ anulada.secuencia }}</a></td>
                                <td>{% if anulada.idcompetencia is not null %}{{ anulada.idcompetencia.descripcion }}{% else %}{% for ic in anulada.competencias %}{{ ic.idcompetencia.descripcion }}{% if not loop.last %} / {% endif %}{% endfor %}{% endif %}</td>
                                <td>{{ anulada.idpia.iddocumento }}</td>
                                <td>{{ anulada.idpia.apellido|upper }}</td>
                                <td>{{ anulada.idpia.nombre|upper }}</td>
                                <td>{{ anulada.idpia.sexo }}</td>
                                <td>{{ anulada.idpia.equipo|upper }}</td>
                                <td>{{ anulada.idpia.idestado.estado }}</td>
                                <td>{% if anulada.idcategoria is not null %}{{ anulada.idcategoria.descripcion }}{% else %}{% for ic in anulada.competencias %}{% if ic.idcategoria %}{{ ic.idcategoria.descripcion }}{% endif %}{% if not loop.last %} / {% endif %}{% endfor %}{% endif %}</td>
                                <td>{{ anulada.punto }}</td>
                                <td>
                                    <ul id="icons" class="ui-widget ui-helper-clearfix">      
                                        <a href="{{ path('inscrito_show', { 'id': anulada.id }) }}">
                                            <li class="ui-state-default ui-corner-all" title="Ver"><span class="ui-icon ui-icon-search"></span></li>
                                        </a>
                                    </ul>                                
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>      
                <a href="{{ path('frater_soft_pia_web_eventos') }}"><button id="button">Regresar</button></a>        </div>
        </div>
    </div>
    </div>
{% endblock %}
