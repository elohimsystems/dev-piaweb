{% extends '::base.html.twig' %}
{% block jsQuery %} 
    <script src="{{ asset('bundles/fratersoftpiaweb/js/chart/Chart.bundle.min.js') }}" type="text/javascript" charset="utf-8"></script>    
    <script src="{{ asset('bundles/fratersoftpiaweb/js/chart/Chart.min.js') }}" type="text/javascript" charset="utf-8"></script>    
    <script src="{{ asset('bundles/fratersoftpiaweb/js/chart/utils.js') }}" type="text/javascript" charset="utf-8"></script>    
{% endblock %}
{% block javascripts %}
    <script>
        $(document).ready(function () {
            var arrayColors = [
                    'rgb(255, 159, 64)', //orange
                    'rgb(54, 162, 235)', //blue
                    'rgb(255, 99, 132)', //red
                    'rgb(255, 205, 86)', //yellow
                    'rgb(75, 192, 192)', //green
                    'rgb(153, 102, 255)', //purple
                    'rgb(201, 203, 207)', //grey    
            ];            
//- Fincion Generica para generar las tablas -----------------------------------                   
            function GenerarTabla(nombretabla,caption,tcantidad,tporcentaje){
                $(nombretabla).append("<tfoot><tr><th></th><th></th><th></th></tr></tfoot>");
                $(nombretabla).DataTable({ 
                    dom: "t",
                    data: data,
                    "pageLength": 50,
                    columns: [
                        { title: "Descripcion" },
                        { title: "Cantidad" },
                        { title: "%" },
                    ],
                    "columnDefs": [ //centra el contenido de la columna
                      {"className": "dt-center", "targets": 1},
                      {"className": "dt-right", "targets": 2}
                    ],
                    order: [[1,'DES']],
                    "footerCallback": function ( row, data, start, end, display ) {    
                        var api = this.api();
                        $(api.column( 0 ).footer()).html("TOTAL");
                        $(api.column( 1 ).footer()).html(tcantidad);
                        $(api.column( 2 ).footer()).html(tporcentaje);
                    }                
                });
                $(nombretabla).append("<caption><b>" + caption + "</b></caption>");
            }           


            $("#tabs").tabs();
            $('#tabs a[href="#tabs-5"]').click();            
            //Redireccion a la pagina de los inscritos al hacer click en el tab
            $('#tabs a[href="#tabs-1"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_preinscritos',{'idevento':idevento,'email':email}) }}')
            });            //Redireccion a la pagina de los inscritos al hacer click en el tab
            $('#tabs a[href="#tabs-2"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_inscritos',{'idevento':idevento,'email':email}) }}')
            });
            //Redireccion a la pagina de los anulados al hacer click en el tab
            $('#tabs a[href="#tabs-3"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_anulados',{'idevento':idevento,'email':email}) }}')
            });
            //Redireccion a la pagina de los operaciones TCD al hacer click en el tab
            $('#tabs a[href="#tabs-4"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_operacionestdc',{'idevento':idevento,'email':email}) }}')
            });   
            
            $("#select_atributos_opcion").change(function () {
                var criterios = "idevento=" + {{ idevento }} + "&entity='" + $("#select_atributos_opcion").val()+"'";
                console.log(criterios);
                $.ajax({
                    type: "GET",
                    data: criterios,
                    url: "{{ path('inscrito_estadisticasajax') }}",
                    dataType: "json",
                    success: function (datos)
                    {
                        $.each(datos['values'][0]['values'], function (key, value) {
                            if(value.precio!=-1){
                            }
                            else{
                            }
                        });             
                    },
                    error: function (jqXHR, textStatus, errorThrown)
                    {
                        alert("PIA Ajax Error: " + jqXHR.responseText);
                    }
                });

            });            

            $("#vergraficos").click(function(){
                $("#grafInscritosGeneral").show();
                $("#tablaInscritosGeneral").hide();
                $("#grafInscritosPorCompetencia").show();
                $("#tablaInscritosPorCompetencia").hide();
                $("#grafInscritosPorFormasDePago").show();
                $("#tablaInscritosPorFormasDePago").hide();
                $("#grafInscritosPorSexo").show();
                $("#tablaInscritosPorSexo").hide();                
                $("#grafInscritosPorCategoria").show();
                $("#tablaInscritosPorCategoria").hide();    
                $("#grafInscritosPorEstado").show();
                $("#tablaInscritosPorEstado").hide(); 
                $("#grafInscritosPorPrecio").show();
                $("#tablaInscritosPorPrecio").hide(); 
                $("#grafInscritosPorFecha").show();
                $("#tablaInscritosPorFecha").hide(); 
            });

            $("#vertablas").click(function(){
                $("#tablaInscritosGeneral").show();
                $("#grafInscritosGeneral").hide();
                $("#tablaInscritosPorCompetencia").show();
                $("#grafInscritosPorCompetencia").hide();
                $("#tablaInscritosPorFormasDePago").show();
                $("#grafInscritosPorFormasDePago").hide();
                $("#tablaInscritosPorSexo").show();
                $("#grafInscritosPorSexo").hide();                
                $("#tablaInscritosPorCategoria").show();
                $("#grafInscritosPorCategoria").hide();  
                $("#tablaInscritosPorEstado").show();
                $("#grafInscritosPorEstado").hide();  
                $("#tablaInscritosPorPrecio").show();
                $("#grafInscritosPorPrecio").hide();  
                $("#tablaInscritosPorFecha").show();
                $("#grafInscritosPorFecha").hide();  
            });            


        });
    </script>           
    {% endblock %}    
{% block style %}
<style type="text/css">
    div.containerInscritosGeneral, 
    div.containerInscritosPorCompetencia,
    div.containerInscritosPorFormaDePago,
    div.containerInscritosPorSexo,
    div.containerInscritosPorCategoria,
    div.containerInscritosPorEstado,
    div.containerInscritosPorPrecio
    {     
        width: 90%;
        margin: 10px;
    }    
    #evento{
        border: 1px solid #d8dcdf;
        padding: 5px;
        margin-bottom: 3px;
        border-radius: 6px;
        font-weight: bold;        
    }
</style>
{% endblock %}    
    {% block body -%}
    <div id="evento">{{nombreevento}}</div>
    <div id="tabs">
        <ul>
            <li><a href="#tabs-1">Pre-Inscritos</a></li>
            <li><a href="#tabs-2">Inscritos</a></li>
            <li><a href="#tabs-3">Anulados</a></li>
            <li><a href="#tabs-4">Operaciones TDC</a></li>
            <li><a href="#tabs-5">Estadisticas</a></li>            
        </ul>
        <div id="tabs-2"></div>
        <div id="tabs-3"></div>  
        <div id="tabs-4"></div>        
        <div id="tabs-1"></div>    
        <div id="tabs-5">
            <div id="atributos">
                Estadisticas por:  
                <select id="select_atributos_opcion">
                <option value="tminscritos.idcompetencia">Competencia</option>
                <option value="tminscritos.idcategoria">Categoria</option>
                <option value="tminscritos.fechahora">Inscritos por Dia</option>
                <option value="tminscritos.fechahora">Inscritos por Mes</option>
                <option value="tminscritos.punto">Punto</option>
                <option value="tminscritos.precio">Precio</option>
                {% for atributo in atributos %}
                    <option value="tmcompetidores.{{ atributo.idatributo.nombre }}">
                        {% if atributo.etiqueta is null %}
                            {{ atributo.idatributo.nombre }} 
                        {% else %} 
                            {{ atributo.etiqueta }} 
                        {% endif %}
                    </option>
                {% endfor %}
                <option value="tmpagos.tipo">Forma de Pago</option>
                <option value="tmpagos.moneda">Monneda</option>
                <option value="tmpagos.conciliado">Conciliado</option>
                </select>
            </div>          
            <table id="tablaEstadisticas" width=100% class="display" border="0">
                <tr>
                    <td align="center"><button id="vertablas">VER TABLAS</button></td>
                    <td align="center"><button id="vergraficos">VER GRAFICOS</button></td>
                </tr>
                <tr>
                    <td>
                        <div class="containerInscritosGeneral">
                            <table id="tablaInscritosGeneral" class="display"></table> 
                        </div>                                    
                    </td>
                    <td>
                        <div class="containerInscritosPorCompetencia">
                            <table id="tablaInscritosPorCompetencia" class="display"></table>   
                        </div>                                    
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="containerInscritosPorFormaDePago">
                            <table id="tablaInscritosPorFormasDePago" class="display"></table>   
                        </div>
                    </td>
                    <td>
                        <div class="containerInscritosPorSexo">
                            <table id="tablaInscritosPorSexo" class="display"></table>   
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="containerInscritosPorCategoria">
                            <table id="tablaInscritosPorCategoria" class="display"></table>   
                        </div>
                    </td>
                    <td>
                        <div class="containerInscritosPorEstado">
                            <table id="tablaInscritosPorEstado" class="display"></table>   
                        </div>
                        <div class="containerInscritosPorPrecio">
                            <table id="tablaInscritosPorPrecio" class="display"></table>   
                        </div>                    
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="containerInscritosPorFecha">
                            <table id="tablaInscritosPorFecha" class="display"></table>   
                        </div>
                    </td>
                    <td>
                    </td>
                </tr>
            </table> 
            <table id="graficos" width=100% class="display" border="0">
                <tr>
                    <td align="center">
                        <div id="canvas-holder" style="width:50%">
                            <canvas id="grafInscritosGeneral" />
                        </div>                                                      
                    </td>
                    <td align="center">
                        <div id="canvas-holder" style="width:50%">
                            <canvas id="grafInscritosPorCompetencia" />
                        </div>                                                             
                    </td>
                </tr>
                <tr>
                    <td align="center">
                        <div id="canvas-holder" style="width:50%">
                            <canvas id="grafInscritosPorFormasDePago" />
                        </div>                         
                    </td>
                    <td align="center">
                        <div id="canvas-holder" style="width:50%">
                            <canvas id="grafInscritosPorSexo" />
                        </div>                           
                    </td>
                </tr>
                <tr>
                    <td colspan="2" align="center">
                        <div id="canvas-holder" style="width:90%">
                            <canvas id="grafInscritosPorCategoria" />
                        </div>                         
                        <div id="canvas-holder" style="width:90%">
                            <canvas id="grafInscritosPorEstado" />
                        </div>                         
                        <div id="canvas-holder" style="width:90%">
                            <canvas id="grafInscritosPorPrecio" />
                        </div>                         
                    </td>
                </tr>
                <tr>
                    <td colspan="2" align="center">
                        <div id="canvas-holder" style="width:90%">
                            <canvas id="grafInscritosPorFecha" />
                        </div>                         
                    </td>
                </tr>
            </table> 
        </div>     
        <p align="center">
            <a href="{{ path('evento_listemail',{'email':email}) }}"><button id="button">Regresar</button></a>
        </p>
    </div>       
    {% endblock %}
