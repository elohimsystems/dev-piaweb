{% extends '::base.html.twig' %}
{% block jsQuery %} 
    <script src="{{ asset('bundles/fratersoftpiaweb/js/chart/Chart.bundle.min.js') }}" type="text/javascript" charset="utf-8"></script>    
    <script src="{{ asset('bundles/fratersoftpiaweb/js/chart/Chart.min.js') }}" type="text/javascript" charset="utf-8"></script>    
    <script src="{{ asset('bundles/fratersoftpiaweb/js/chart/utils.js') }}" type="text/javascript" charset="utf-8"></script>    
{% endblock %}
{% block javascripts %}
    <script>
//- Fincion Generica para generar las tablas -----------------------------------    
        var arraydatos=[];
        var data=[];
        var total=[];
        var datosgrafico=[];
        var etiquetasgrafico=[];
        var table;
        var arrayColors = [
                'rgb(255, 159, 64)', //orange
                'rgb(54, 162, 235)', //blue
                'rgb(255, 99, 132)', //red
                'rgb(255, 205, 86)', //yellow
                'rgb(75, 192, 192)', //green
                'rgb(153, 102, 255)', //purple
                'rgb(201, 203, 207)', //grey    
        ];            
        
        function GenerarTabla(nombretabla,caption,tcantidad,tporcentaje){            
            if($(nombretabla + " > tfoot").length==0)
                $(nombretabla).append("<tfoot><tr><th></th><th></th><th></th></tr></tfoot>");
            if(table!=null)
                table.destroy();
            table = $(nombretabla).DataTable({ 
                dom: "itp",
                data: data,
                retrieve: true,
                "pageLength": 50,
                columns: [
                    { title: "Descripcion" },
                    { title: "Cantidad" },
                    { title: "%" },
                ],
                "columnDefs": [ //centra el contenido de la columna
                  {"className": "dt-center", "targets": 1},
                  {"className": "dt-right", "targets": 2}
                ],
                order: [[1,'DES']],
                "footerCallback": function ( row, data, start, end, display ) {    
                    var api = this.api();
                    $(api.column( 0 ).footer()).html("TOTAL");
                    $(api.column( 1 ).footer()).html(tcantidad);
                    $(api.column( 2 ).footer()).html(tporcentaje.toFixed(2));
                }                
            });
            if($(nombretabla + " > caption").length==0)
                $(nombretabla).append("<caption><b>" + caption + "</b></caption>");
        } 
        function Graficar(){
            var tipochart;
            var config = {};
            var backgroudColors=[];
            tipochart=(datosgrafico.length>5)?'bar':'pie';
            for(var i=0;i<datosgrafico.length;i++){
                backgroudColors.push(arrayColors[i]);            
                if(tipochart=='bar')
                    break;
            }
            config = {
                type: tipochart,
                data: {
                    datasets: [{
                        data: datosgrafico,
                        backgroundColor: backgroudColors,
                    }],
                    labels: etiquetasgrafico
                },
                options: {
                    responsive: true,
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            boxWidth: 10,
                        }                        
                    },                    
                }
            };
            $("#canvas-holder").empty();
            $("#canvas-holder").html("<canvas id='grafico'/>");
            $("#canvas-holder").attr("style",(datosgrafico.length>5)?"width:80%":"width:50%");
            var ctx = document.getElementById("grafico").getContext("2d");
            window.myPie = new Chart(ctx, config);
        }
        $(document).ready(function () {
            $("#tabs").tabs();
            $('#tabs a[href="#tabs-5"]').click();            
            //Redireccion a la pagina de los inscritos al hacer click en el tab
            $('#tabs a[href="#tabs-1"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_preinscritos',{'idevento':idevento,'email':email}) }}')
            });            //Redireccion a la pagina de los inscritos al hacer click en el tab
            $('#tabs a[href="#tabs-2"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_inscritos',{'idevento':idevento,'email':email}) }}')
            });
            //Redireccion a la pagina de los anulados al hacer click en el tab
            $('#tabs a[href="#tabs-3"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_anulados',{'idevento':idevento,'email':email}) }}')
            });
            //Redireccion a la pagina de los operaciones TCD al hacer click en el tab
            $('#tabs a[href="#tabs-4"]').on("click", function () {
                $(location).attr('href', '{{ path('inscrito_lista_operacionestdc',{'idevento':idevento,'email':email}) }}')
            });   
            
            $("#select_atributos_opcion").change(function () {
                var criterios = "idevento=" + {{ idevento }} + "&entity=" + $("#select_atributos_opcion").val()+"";
                
                $.ajax({
                    type: "GET",
                    data: criterios,
                    url: "{{ path('inscrito_estadisticasajax') }}",
                    dataType: "json",
                    success: function (datos)
                    {
                        var totalporcentaje=0;
                        var porcentaje=0;
                        datosgrafico=[];
                        etiquetasgrafico=[];
                        arraydatos=[];
                        $.each(datos.data, function (key, value) {
                            porcentaje=(value.cantidad/datos.sumaCantidad)*100;
                            arraydatos.push([value.valor,value.cantidad,porcentaje.toFixed(2)]);
                            totalporcentaje+=porcentaje;
                            datosgrafico.push(porcentaje.toFixed(2));
                            etiquetasgrafico.push(value.valor);
                        });
                        console.log(etiquetasgrafico);
                        data=arraydatos;
                        GenerarTabla(
                            '#tablaestadistica',
                            'Estadisticas por ' + $("#select_atributos_opcion option:selected").text(),
                            datos.sumaCantidad,
                            totalporcentaje
                        );
                        Graficar();
                        alert("Procesado");
                    },
                    error: function (jqXHR, textStatus, errorThrown)
                    {
                        alert("PIA Ajax Error: " + jqXHR.responseText);
                    }
                });

            });            
        });
    </script>           
    {% endblock %}    
{% block style %}
<style type="text/css">
    #seccionTabla{     
        width: 70%;
        margin: auto;
    }    
    #canvas-holder{
        margin: auto;
    }
    #evento{
        border: 1px solid #d8dcdf;
        padding: 5px;
        margin-bottom: 3px;
        border-radius: 6px;
        font-weight: bold;        
    }
</style>
{% endblock %}    
    {% block body -%}
    <div id="evento">{{nombreevento}}</div>
    <div id="tabs">
        <ul>
            <li><a href="#tabs-1">Pre-Inscritos</a></li>
            <li><a href="#tabs-2">Inscritos</a></li>
            <li><a href="#tabs-3">Anulados</a></li>
            <li><a href="#tabs-4">Operaciones TDC</a></li>
            <li><a href="#tabs-5">Estadisticas</a></li>            
        </ul>
        <div id="tabs-2"></div>
        <div id="tabs-3"></div>  
        <div id="tabs-4"></div>        
        <div id="tabs-1"></div>    
        <div id="tabs-5">
            <div id="atributos">
                Estadisticas por:  
                <select id="select_atributos_opcion">
                <option value="tminscritos.idcompetencia">Competencia</option>
                <option value="tmcategorias.descripcion">Categoria</option>
                <option value="tminscritos.fechahora">Inscritos por Dia</option>
                <option value="tminscritos.fechahora">Inscritos por Mes</option>
                <option value="tminscritos.punto">Punto</option>
                <option value="tminscritos.precio">Precio</option>
                {% for atributo in atributos %}
                    <option value="tmcompetidores.{{ atributo.idatributo.nombre }}">
                        {% if atributo.etiqueta is null %}
                            {{ atributo.idatributo.nombre }} 
                        {% else %} 
                            {{ atributo.etiqueta }} 
                        {% endif %}
                    </option>
                {% endfor %}
                <option value="tmpagos.tipo">Forma de Pago</option>
                <option value="tmpagos.moneda">Monneda</option>
                <option value="tmpagos.conciliado">Conciliado</option>
                </select>
            </div>
            <div id="seccionTabla">
                <table id="tablaestadistica" class="display" border="0"></table>
            </div>
            <div id="seccionGrafico">
                <div id="canvas-holder" style="width:70%">
                    <canvas id="grafico"/>
                </div> 
            </div>
        </div>     
        <p align="center">
            <a href="{{ path('evento_listemail',{'email':email}) }}"><button id="button">Regresar</button></a>
        </p>
    </div>       
    {% endblock %}
