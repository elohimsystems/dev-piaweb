            //Valida que el email tenga el formato adecuado
            $("input#{{ edit_form.idpia.email.vars.id }}").verimail({
                denyTempEmailDomains: true,
                language: 'es',
                messageElement: "div#status-message"
            });

            $("input#{{ edit_form.idpia.email.vars.id }}").change(function () {
                if($("input#{{ edit_form.idpia.email.vars.id }}").getVerimailStatus() == 'error'){
                    $("input#{{ edit_form.idpia.email.vars.id }}").val('');
                }  
                $("div#status-message").html("");
            });

            $("#formulario").validate();

            jQuery.validator.addMethod("fechaESP", function (value, element)
            {
                var validator = this;
                var datePat = /^(\d{1,2})(\/|-)(\d{1,2})(\/|-)(\d{4})$/;
                var fechaCompleta = value.match(datePat);
                if (fechaCompleta == null) {
                    $.validator.messages.fechaESP = "Fecha invalida";
                    return false;
                }

                dia = fechaCompleta[1];
                mes = fechaCompleta[3];
                anio = fechaCompleta[5];

                if (dia < 1 || dia > 31) {
                    $.validator.messages.fechaESP = "Dia invalido";
                    return false;
                }
                if (mes < 1 || mes > 12) {
                    $.validator.messages.fechaESP = "Mes invalido";
                    return false;
                }
                if ((mes == 4 || mes == 6 || mes == 9 || mes == 11) && dia == 31) {
                    $.validator.messages.fechaESP = "Dia invalido";
                    return false;
                }
                if (mes == 2) { // bisiesto
                    var bisiesto = (anio % 4 == 0 && (anio % 100 != 0 || anio % 400 == 0));
                    if (dia > 29 || (dia == 29 && !bisiesto)) {
                        $.validator.messages.fechaESP = "Dia invalido";
                        return false;
                    }
                }
                return true;
            }, "Fecha invalida");

            //Funcion calcula la edad del competidor, dependiendo del critetio configurado
