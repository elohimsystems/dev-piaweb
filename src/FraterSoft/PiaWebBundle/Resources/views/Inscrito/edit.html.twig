{% endblock %}
    
{#{%macro opeart(operador_art)%}
    {%if(operador_art=='>')%}>{%elseif(operador_art=='<')%}<{%elseif(operador_art=='>=')%}>={%elseif(operador_art=='<=')%}<={%elseif(operador_art=='==')%}=={%elseif(operador_art=='!=')%}!={%endif%}
{%endmacro%}
{%macro opelog(operador_log)%}
    {%if(operador_log=='&&')%}&&{%elseif(operador_log=='||')%}||{%elseif(operador_log=='!')%}!{%endif%}
{%endmacro%}#}
