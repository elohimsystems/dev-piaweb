            var competenciasgrupo={{null|json_encode|raw}};
            if($.inArray($("#{{ edit_form.idcompetencia.vars.id }}").val(),competenciasgrupo)!=-1){
                $("#{{edit_form.idcategoria.vars.id}}").prop("disabled", true);
                $("#{{edit_form.pagos[0].precio.vars.id}}").prop("disabled", true);
                $("#{{ edit_form.pagos[0].precio.vars.id }}").attr('required',false);
                {% for campopago in edit_form.pagos[0] %}
                    $("#{{campopago.vars.id}}").prop("disabled", true);
