            }
            //Recalcula la categoria si es cambiado la competencia
            $("#{{ edit_form.idcompetencia.vars.id }}").change(function () {
                if($.inArray($("#{{ edit_form.idcompetencia.vars.id }}").val(),competenciasgrupo)!=-1){
                    $("#{{edit_form.idcategoria.vars.id}}").prop("disabled", true);
                    $("#{{edit_form.pagos[0].precio.vars.id}}").prop("disabled", true);
                    $("#{{ edit_form.pagos[0].precio.vars.id }}").attr('required',false);
                    {% for campopago in edit_form.pagos %}
                        $("#{{campopago.vars.id}}").prop("disabled", true);
                    {% endfor %}
                    {#$("#{{edit_form.idcategoria.vars.id}}").parent().hide();#}
                    {#$("#{{edit_form.precio.vars.id}}").parent().hide();  #}
                    {#$("#{{edit_form.pagos[0].vars.id}}").parent().hide();  #}
                    $("#{{edit_form.pagos[0].info.vars.id}}").parent().hide();
                    $("#titulogrupos").show();
                    $("#{{ edit_form.submit.vars.id }}").html('<span class="ui-button-text">Agregar</span>');
                }
                else{
                    $("#{{edit_form.idcategoria.vars.id}}").parent().show();
                    $("#{{edit_form.idcategoria.vars.id}}").removeAttr("disabled");
                    $("#{{edit_form.pagos[0].precio.vars.id}}").parent().show();
                    $("#{{edit_form.pagos[0].precio.vars.id}}").removeAttr("disabled");
                    $("#{{edit_form.pagos.vars.id}}").parent().show();
                    {% for campopago in edit_form.pagos %}
                        $("#{{campopago.vars.id}}").removeAttr("disabled");
                    {% endfor %}
                    $("#{{edit_form.pagos[0].info.vars.id}}").parent().show();
                    $("#titulogrupos").hide();
                    if ($("#{{ edit_form.idcompetencia.vars.id }}").val() != '') {
                        buscaCategorias();
                    }
                    $("#{{ edit_form.submit.vars.id }}").html('<span class="ui-button-text">Inscribir</span>');
                }                
            });                      
            
            {% elseif entity.idevento.proceso == 2 %}
                $("form#formulario" ).submit(function( event ) {
                    {% if edit_form.idpia.email is defined and edit_form.idpia.emailpersonal is defined %}
                    if($("#{{edit_form.idpia.email.vars.id}}").val()=="" && $("#{{edit_form.idpia.emailpersonal.vars.id}}").val()==""){
                        alert("Debe ingresar el Email Personal o el Secundario, ambos no pueden estar vacios");
                        return false;
                    }
                    {% endif %}        
                        {#if(!validaRequiredHidden($("#{{ edit_form.idpia.foto.vars.id }}"))) return false;
                    if(!validaRequiredHidden($("#{{ edit_form.idpia.fileiddocumento.vars.id }}"))) return false;
                    if(!validaRequiredHidden($("#{{ edit_form.idpia.filepartidanacimiento.vars.id }}"))) return false;
                    if(!validaRequiredHidden($("#{{ edit_form.idpia.filecertificadodeportivo.vars.id }}"))) return false;#}
                });                    
            {% endif %}
            
            //Bloquea a solo lecutara los campos que el usurio no debe cambiar si el
            //evento es de tipo campeonato
            {%if entity.idevento.idcampeonato.id is defined %}
                {#$("#{{ edit_form.idpia.equipo.vars.id }}").attr('readonly',true);
                $("#{{ edit_form.numero.vars.id }}").attr('readonly',true);
                $("#{{ edit_form.idcategoria.vars.id }}").attr('readonly',true);#}
            {% endif %}

            {% if edit_form.idpia.emailpersonal.vars.id is defined %}
            $emailoriginal=$("#{{ edit_form.idpia.emailpersonal.vars.id }}").val();
            $("#{{ edit_form.idpia.emailpersonal.vars.id }}").blur(function () {
                if($("#{{ edit_form.idpia.emailpersonal.vars.id }}").val()!="{% if entity.idpia %} {{entity.idpia.emailpersonal}} {% endif %}")
                    validaEmailPersonal($emailoriginal,$("#{{edit_form.idpia.emailpersonal.vars.id}}"));
            });
            {% endif %}

            //Valida que ambos correos no esten vacios
            {% if edit_form.idpia.email is defined and edit_form.idpia.emailpersonal is defined %}
            if($("#{{edit_form.idpia.email.vars.id}}").val()=="" && $("#{{edit_form.idpia.emailpersonal.vars.id}}").val()==""){
                alert("Debe ingresar el Email Personal o el Secundario, ambos no pueden estar vacios");
                return false;
            }
            {% endif %}  
                            
            //$("#mensajepago").hide();
            $("#mensajepagotarjeta").hide();

            //Enmascara los campos
