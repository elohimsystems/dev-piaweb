                {# {% endif %} #}
                {% if edit_form.pagos is defined %}
                $("#{{ edit_form.pagos[0].precio.vars.id }}").removeAttr("disabled");
                {#if($("#{{ edit_form.pagos.idformapago.vars.id }}").val()=='1')
                    $("#{{ edit_form.pagos.idbanco.vars.id }}").removeAttr("disabled");
                if($("#{{ edit_form.pagos.idformapago.vars.id }}").val()=='0'){
                    $("#{{ edit_form.pagos.idbanco.vars.id }}").removeAttr("required");
                    $("#{{ edit_form.pagos.idformapago.vars.id }}").removeAttr("disabled");
                }#}
