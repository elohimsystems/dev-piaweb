{% extends '::base.html.twig' %}
{% block stylesheets %}
    <link href="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.css')}}" rel="stylesheet" type="text/css"/>
{% endblock %}
{% block jsQuery %}    
    <script src="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.js')}}" type="text/javascript"></script>
{% endblock %}   

{% block javascripts %}
    <script>

        function buscaCategorias() {
            //Busca las categorias segun los atributos configurados
            if(!$('#{{ edit_form.idcompetencia.vars.id }}').val()){
                alert('Debe seleccionar una Competencia');
                return null;
            }            
            //Busca las categorias segun los atributos configurados
            var criterios = "idevento=" + $('#{{ edit_form.idevento.vars.id }}').val()
                    + "&idcompetencia=" + $('#{{ edit_form.idcompetencia.vars.id }}').val() + "&";
        {% for atributo in atributos %}
                if ($("#fratersoft_piawebbundle_inscrito_idpia_{{ atributo.idatributo.nombre|lower }}").val() == '')
                    return null;
                criterios += "{{ atributo.idatributo.nombre|lower }}=" + $("#fratersoft_piawebbundle_inscrito_idpia_{{ atributo.idatributo.nombre|lower }}").val();
            {% if not loop.last %}
                    criterios += "&";
            {% endif %}
        {% endfor %}      
                    //alert(criterios);
                    $.ajax(
                            {
                                type: "GET",
                                data: criterios,
                                url: "{{ path('inscrito_categorias') }}",
                                dataType: "json",
                                success: function (datos)
                                {
                                    $("#{{ edit_form.idcategoria.vars.id }}").empty();
                                    $("#{{ edit_form.idcategoria.vars.id }}").prop("required", true);
                                    if (datos['values'].length > 1)
                                        $("#{{ edit_form.idcategoria.vars.id }}").append("<option selected value=''>Seleccione una Categoría</option>");
                                    else
                                        buscaPrecio(
                                                $('#{{ edit_form.idevento.vars.id }}').val(),
                                                $('#{{ edit_form.idcompetencia.vars.id }}').val(),
                                                datos['values'][0].id
                                        );                                        
                                    $.each(datos['values'], function (key, value) {
                                        $('#{{ edit_form.idcategoria.vars.id }}').append($('<option>', {
                                            value: value.id,
                                            text: value.descripcion
                                        }));
                                    });
                                },
                                error: function (jqXHR, textStatus, errorThrown)
                                {
                                    alert("PIA Ajax Error: " + jqXHR.responseText);
                                }
                            }
                    );
                }

        function buscaPrecio(idevento, idcompetencia, idcategoria) {
            {%if entity.idevento.proceso == 1%}
            //Busca el precio segun configuracion
            var criterios = "idevento=" + idevento
                    + "&idcompetencia=" + idcompetencia
                    + "&idcategoria=" + idcategoria;
            $('#{{ edit_form.precio.vars.id }}').find('option').remove();
            $.ajax({
                type: "GET",
                data: criterios,
                url: "{{ path('inscrito_precio') }}",
                dataType: "json",
                success: function (datos)
                {
                    if(datos['values'][0]['values'].length>1)
                        $("#{{ edit_form.precio.vars.id }}").append("<option selected value=''>Seleccione un Precio</option>");
                    $.each(datos['values'][0]['values'], function (key, value) {
                        if(value.precio!=-1){
                            $('#{{ edit_form.precio.vars.id }}').append($('<option>', {
                                value: value.precio,
                                text: ((value.texto==null)?'':value.texto) + ' ' + value.moneda + ' ' + value.precio
                            }));
                            $("#{{ edit_form.precio.vars.id }}").prop("disabled", false);
                            $("#{{ edit_form.idpago.banco.vars.id }}").prop("disabled", false);
                            $("#{{ edit_form.idpago.referencia.vars.id }}").prop("disabled", false);
                            $("#{{ edit_form.idpago.tipo.vars.id }}").prop("disabled", false);                                      
                        }
                        else{
                            $('#{{ edit_form.precio.vars.id }}').append($('<option>', {
                                value: 0,
                                text: "EXONERADO"
                            }));
                            $("#{{ edit_form.precio.vars.id }}").prop("disabled", true);
                            $("#{{ edit_form.idpago.banco.vars.id }}").prop("disabled", true);
                            $("#{{ edit_form.idpago.referencia.vars.id }}").prop("disabled", true);
                            $("#{{ edit_form.idpago.tipo.vars.id }}").prop("disabled", true);                                
                        }
                    });             
                },
                error: function (jqXHR, textStatus, errorThrown)
                {
                    alert("PIA Ajax Error: " + jqXHR.responseText);
                }
            });
            {% endif %}
        }        

        $().ready(function () {

            {%if entity.idevento.proceso == 1%}
            //Busca los precios para los valores por defecto
            buscaPrecio($('#{{ edit_form.idevento.vars.id }}').val(),
                        $('#{{ edit_form.idcompetencia.vars.id }}').val()?$('#{{ edit_form.idcompetencia.vars.id }}').val():'',
                        $('#{{ edit_form.idcategoria.vars.id }}').val()?$('#{{ edit_form.idcategoria.vars.id }}').val():'');

            //Habilita el campo del banco justo antes de enviar el formulario
            $("form#formulario" ).submit(function( event ) {
                if($("#{{ edit_form.idpago.tipo.vars.id }}").val()=='1')
                    $("#{{ edit_form.idpago.banco.vars.id }}").removeAttr("disabled");
                if($("#{{ edit_form.idpago.tipo.vars.id }}").val()=='0'){
                    $("#{{ edit_form.idpago.banco.vars.id }}").removeAttr("required");
                    $("#{{ edit_form.idpago.tipo.vars.id }}").removeAttr("disabled");
                }
            });
            {% elseif entity.idevento.proceso == 2 %}
                $("form#formulario" ).submit(function( event ) {
                    {% if edit_form.idpia.email is defined and edit_form.idpia.emailpersonal is defined %}
                    if($("#{{edit_form.idpia.email.vars.id}}").val()=="" && $("#{{edit_form.idpia.emailpersonal.vars.id}}").val()==""){
                        alert("Debe ingresar el Email Personal o el Secundario, ambos no pueden estar vacios");
                        return false;
                    }
                    {% endif %}        
                    if(!validaRequiredHidden($("#{{ edit_form.idpia.foto.vars.id }}"))) return false;
                    if(!validaRequiredHidden($("#{{ edit_form.idpia.fileiddocumento.vars.id }}"))) return false;
                    if(!validaRequiredHidden($("#{{ edit_form.idpia.filepartidanacimiento.vars.id }}"))) return false;
                    if(!validaRequiredHidden($("#{{ edit_form.idpia.filecertificadodeportivo.vars.id }}"))) return false;
                });                    
            {% endif %}

            {% if entity.idpia.emailpersonal is defined %}
            $("#{{ edit_form.idpia.emailpersonal.vars.id }}").blur(function () {
                if($("#{{ edit_form.idpia.emailpersonal.vars.id }}").val()!="{{entity.idpia.emailpersonal}}")
                    validaEmailPersonal($("#{{edit_form.idpia.emailpersonal.vars.id}}"));
            });
            {% endif %}
            

            //Recalcula la categoria si es cambiado la competencia
            $("#{{ edit_form.idcompetencia.vars.id }}").change(function () {
                if ($("#{{ edit_form.idcompetencia.vars.id }}").val() != '') {
                    buscaCategorias();
                    buscaPrecio(
                            $('#{{ edit_form.idevento.vars.id }}').val(),
                            $('#{{ edit_form.idcompetencia.vars.id }}').val(),
                            ''
                    );
                }
            });                      

            $("#mensajepago").hide();
            $("#mensajepagotarjeta").hide();

            //Enmascara los campos
            if($('#{{ edit_form.idpia.telefono.vars.id }}').val()=="")
                $("input#{{ edit_form.idpia.telefono.vars.id }}").mask("(9999) 999-9999");
            $("input#{{ edit_form.idpia.fechanacimiento.vars.id }}").mask("99/99/9999");

            //Valida que el email tenga el formato adecuado
            $("input#{{ edit_form.idpia.email.vars.id }}").verimail({
                denyTempEmailDomains: true,
                language: 'es',
                messageElement: "div#status-message"
            });

            $("input#{{ edit_form.idpia.email.vars.id }}").change(function () {
                if($("input#{{ edit_form.idpia.email.vars.id }}").getVerimailStatus() == 'error'){
                    $("input#{{ edit_form.idpia.email.vars.id }}").val('');
                }  
                $("div#status-message").html("");
            });

            $("#formulario").validate();
            jQuery.extend(jQuery.validator.messages, {
                required: "Campo requerido",
            });

            jQuery.validator.addMethod("fechaESP", function (value, element)
            {
                var validator = this;
                var datePat = /^(\d{1,2})(\/|-)(\d{1,2})(\/|-)(\d{4})$/;
                var fechaCompleta = value.match(datePat);
                if (fechaCompleta == null) {
                    $.validator.messages.fechaESP = "Fecha invalida";
                    return false;
                }

                dia = fechaCompleta[1];
                mes = fechaCompleta[3];
                anio = fechaCompleta[5];

                if (dia < 1 || dia > 31) {
                    $.validator.messages.fechaESP = "Dia invalido";
                    return false;
                }
                if (mes < 1 || mes > 12) {
                    $.validator.messages.fechaESP = "Mes invalido";
                    return false;
                }
                if ((mes == 4 || mes == 6 || mes == 9 || mes == 11) && dia == 31) {
                    $.validator.messages.fechaESP = "Dia invalido";
                    return false;
                }
                if (mes == 2) { // bisiesto
                    var bisiesto = (anio % 4 == 0 && (anio % 100 != 0 || anio % 400 == 0));
                    if (dia > 29 || (dia == 29 && !bisiesto)) {
                        $.validator.messages.fechaESP = "Dia invalido";
                        return false;
                    }
                }
                return true;
            }, "Fecha invalida");

            //Funcion calcula la edad del competidor, dependiendo del critetio configurado
            $("#{{ edit_form.idpia.fechanacimiento.vars.id }}").blur(function () {
                if ($("#{{ edit_form.idpia.fechanacimiento.vars.id }}").val() != '') {
                    var fn = $("#{{ edit_form.idpia.fechanacimiento.vars.id }}").val().split("/");
                    var afn = new Date(parseInt(fn[2], 10),
                            parseInt(fn[1], 10) - 1,
                            parseInt(fn[0], 10));
                    {% if entity.idevento.criteriocalculoedad == 1 %} //Calculo Edad Anio Calendario
                    var afa = new Date();
                    $("#{{ edit_form.idpia.edad.vars.id }}").val(afa.getFullYear() - afn.getFullYear());
                    {% else %} //Calculo Edad a la Fecha del Evento
                        var afe = new Date("{{ entity.idevento.fechacierre|date("Y/m/d H:m:s") }}");
                        if(afe.getMonth() > afn.getMonth())
                                $("#{{ edit_form.idpia.edad.vars.id }}").val(afe.getFullYear() - afn.getFullYear());
                        else
                            if(afe.getMonth() == afn.getMonth() && afn.getDate() < afe.getDate())
                                $("#{{ edit_form.idpia.edad.vars.id }}").val(afe.getFullYear() - afn.getFullYear());
                            else
                                $("#{{ edit_form.idpia.edad.vars.id }}").val(afe.getFullYear() - afn.getFullYear()-1);
                    {% endif %}
                    buscaCategorias();
                    buscaPrecio(
                            $('#{{ edit_form.idevento.vars.id }}').val(),
                            $('#{{ edit_form.idcompetencia.vars.id }}').val(),
                            $('#{{ edit_form.idcategoria.vars.id }}').val()
                    );                        
                }
            });

        $("#{{ edit_form.idpia.sexo.vars.id }}").change(function () {
            buscaCategorias();
            buscaPrecio(
                    $('#{{ edit_form.idevento.vars.id }}').val(),
                    $('#{{ edit_form.idcompetencia.vars.id }}').val(),
                    $('#{{ edit_form.idcategoria.vars.id }}').val()
            );                    
        });

        $("#{{ edit_form.idcategoria.vars.id }}").change(function () {
            buscaPrecio(
                    $('#{{ edit_form.idevento.vars.id }}').val(),
                    $('#{{ edit_form.idcompetencia.vars.id }}').val(),
                    $('#{{ edit_form.idcategoria.vars.id }}').val()
            );
        });   

        {%if entity.idevento.proceso == 1%}
        $("#{{ edit_form.idpago.tipo.vars.id }}").change(function () {
            switch ($("#{{ edit_form.idpago.tipo.vars.id }}").val()) {
                case '':
                    $("#{{ edit_form.idpago.banco.vars.id }}").val(null);
                    $("#codigo123pago").remove();
                    $("#mensajepagotarjeta").hide();
                    $("#{{ edit_form.idpago.referencia.vars.id }}").removeAttr("readonly");
                    $("#{{ edit_form.idpago.banco.vars.id }}").removeAttr("disabled");
                    $("#mensajepago").hide();
                    $("#{{ edit_form.submit.vars.id }}").html('<span class="ui-button-text">Inscribir</span>')
                    break;
                case '1': //Selecciono Deposito
                    if ($("#{{ edit_form.precio.vars.id }}").val() == 0){
                        alert("Error el precio no puede ser 0");
                        $("#{{ edit_form.idpago.tipo.vars.id }}").val('');                                
                    }                                
                    else {                             
                        $("#{{ edit_form.submit.vars.id }}").show();
                        {% if entity.idevento.idorganizador %} //Valida que se haya configurado el organizador en el evento
                            $("#{{ edit_form.idpago.banco.vars.id }}").val("{{ entity.idevento.idorganizador.banco }}");
                        {% endif %}
                        $("#{{ edit_form.idpago.referencia.vars.id }}").prop("disabled", false);
                        $("#{{ edit_form.idpago.banco.vars.id }}").prop("disabled",true);
                        $("#mensajepago").show();
                        $("#mensajepagotarjeta").hide();
                        $("#codigo123pago").remove();
                        $("#{{ edit_form.submit.vars.id }}").html('<span class="ui-button-text">Inscribir</span>')
                    }
                    break;
                case '2': //Selecciono Transferencia
                    if ($("#{{ edit_form.precio.vars.id }}").val() == 0){
                        alert("Error el precio no puede ser 0");
                        $("#{{ edit_form.idpago.tipo.vars.id }}").val('');
                    }
                    else {                            
                        $("#{{ edit_form.submit.vars.id }}").show();
                        $("#{{ edit_form.idpago.banco.vars.id }}").val("");
                        $("#{{ edit_form.idpago.referencia.vars.id }}").prop("disabled", false);
                        $("#{{ edit_form.idpago.banco.vars.id }}").removeAttr("disabled");
                        $("#mensajepago").show();
                        $("#mensajepagotarjeta").hide();
                        $("#{{ edit_form.submit.vars.id }}").html('<span class="ui-button-text">Inscribir</span>');
                    }
                    break;
                case '3': //Selecciono Tarjeta de Credito
                    if ($("#{{ edit_form.precio.vars.id }}").val() == 0){
                        alert("Error el precio no puede ser 0");
                        $("#{{ edit_form.idpago.tipo.vars.id }}").val('');                                
                    }
                    else {
                        $("#mensajepago").hide();
                        $("#{{ edit_form.idpago.banco.vars.id }}").prop("disabled", true);
                        $("#{{ edit_form.idpago.referencia.vars.id }}").prop("disabled", true);
                        $("#{{ edit_form.submit.vars.id }}").html('<span class="ui-button-text">Continuar</span>');
                        $("#mensajepagotarjeta").show();
                    }
                    break;                        
            }
        });
        {% endif %}

        if($("#{{edit_form.idpia.foto.vars.id}}").attr("type")!="hidden"){
            //Agrega un bton al lado derecho del campo
            $("#{{edit_form.idpia.foto.vars.id}}").parent().append(
                "<button type='button' id='btn_foto'></button>"
            );    
            $("#{{edit_form.idpia.foto.vars.id}}").attr("type","hidden");
            var dato = "{{edit_form.idpia.foto.vars.data}}";
            var nombrearchivo = dato.substring(dato.lastIndexOf("/")+1,dato.length);        
            $("<input id='namefile_foto' type='text' value='' readonly>").insertAfter($("#{{edit_form.idpia.foto.vars.id}}"));        
            if($("#{{edit_form.idpia.foto.vars.id}}").val()=="")
                $("<img id='imagen_foto' src='{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}' sytle='height:21px'/>" ).insertBefore($("#{{edit_form.idpia.foto.vars.id}}"));
            else{
                $("<img id='imagen_foto' src='{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ edit_form.idpia.foto.vars.data}}' sytle='height:21px'/>" ).insertBefore($("#{{edit_form.idpia.foto.vars.id}}"));
                $("#namefile_foto").val(nombrearchivo);
            }
            $('#btn_foto').append("<img id='icon-foto' src='{{asset('bundles/fratersoftpiaweb/images/retrato-enmarcado.png')}}'/>").button();
            $("#btn_foto").on('click', function() {
                cargar_imagen($("#{{ edit_form.idpia.foto.vars.id }}"),$("#imagen_foto"),350,600,null);
            });        
        }

        if($("#{{edit_form.idpia.fileiddocumento.vars.id}}").attr("type")!="hidden"){
            controlLoadFile($("#{{edit_form.idpia.fileiddocumento.vars.id}}"),"pdf");
            controlLoadFile($("#{{edit_form.idpia.filepartidanacimiento.vars.id}}"),"pdf");
            controlLoadFile($("#{{edit_form.idpia.filecertificadodeportivo.vars.id}}"),"pdf");
        }

        //muestra la ventana para cargar imagenes o archivos
        $("#uploadimage").dialog({
            autoOpen: false,
            modal: true,
            buttons: [
                {
                    text: "Aceptar",
                    click: function () {
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Cerrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });
    });
    </script>   
{% endblock %}
