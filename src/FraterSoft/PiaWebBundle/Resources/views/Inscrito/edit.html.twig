                            parseInt(fn[0], 10));
                    {% if entity.idevento.criteriocalculoedad == 1 %} //Calculo Edad Anio Calendario
                    var afa = new Date();
                    $("#{{ edit_form.idpia.edad.vars.id }}").val(afa.getFullYear() - afn.getFullYear());
                    {% else %} //Calculo Edad a la Fecha del Evento
                        var afe = new Date("{{ entity.idevento.fechacierre|date("Y/m/d H:m:s") }}");
                        if(afe.getMonth() > afn.getMonth())
                                $("#{{ edit_form.idpia.edad.vars.id }}").val(afe.getFullYear() - afn.getFullYear());
                        else
                            if(afe.getMonth() == afn.getMonth() && afn.getDate() < afe.getDate())
                                $("#{{ edit_form.idpia.edad.vars.id }}").val(afe.getFullYear() - afn.getFullYear());
                            else
                                $("#{{ edit_form.idpia.edad.vars.id }}").val(afe.getFullYear() - afn.getFullYear()-1);
                    {% endif %}
                    buscaCategorias();
                    
                }
            });

        {# $("#{{ edit_form.idpia.sexo.vars.id }}").change(function () {
            buscaCategorias();
        }); #}

        $("#{{ edit_form.idcompetencia.vars.id }}").change(function () {
            buscaCategorias();
        });
        
        $("#{{ edit_form.idpia.idestado.vars.id }}").change(function () {
            
            if($('#{{ edit_form.idpia.idestado.vars.id }}').val() != 6){
                $('#{{ edit_form.idpia.equipo.vars.id }}').attr('readonly',false);
                $('#{{ edit_form.idpia.equipo.vars.id }}').val("");
            }
            else{
                $('#{{ edit_form.idpia.equipo.vars.id }}').attr('readonly',true);
                $('#{{ edit_form.idpia.equipo.vars.id }}').val("INDEPENDIENTE");
            }
        });        

        {% if edit_form.idcategoria is defined and edit_form.pagos is defined and entity.idevento.proceso == 1%}
        $("#{{ edit_form.idcategoria.vars.id }}").change(function () {
            buscaPrecio(
                    $('#{{ edit_form.idevento.vars.id }}').val(),
                    $('#{{ edit_form.idcompetencia.vars.id }}').val(),
                    $('#{{ edit_form.idcategoria.vars.id }}').val(),
                    $('#formulario'),
                    [],
                    $("#formulario input[type='radio']:checked").val()
            );
        });   
        {% endif %}

        {%if entity.idevento.proceso == 1 and edit_form.pagos is defined %}
        buscarFormasPago(
            $('#formulario'),
            {{entity.idevento.id}},
            $("#formulario input[type='radio']:checked").val()
        );
        
        ocultaCamposPagoForm($('#formulario'));
        {% set storedFpId = entity.pagos[0].idformapago.id|default(null) %}
        {% if storedFpId is not null %}
        var fpInterval = setInterval(function() {
            if ($("select[id*=idformapago] option").length > 1) {
                clearInterval(fpInterval);
                $("select[id*=idformapago]").val('{{ storedFpId }}');
                var jparametros = [];
                if (window.sessionStorage.getItem('idfp' + '{{ storedFpId }}')) {
                    jparametros = jQuery.parseJSON(window.sessionStorage.getItem('idfp' + '{{ storedFpId }}'));
                }
                $.each(jparametros, function(i, item) {
                    $(idform($('#formulario'), item.campo)).parent().children(0).show();
                    $(idform($('#formulario'), item.campo)).prop("required", true);
                    $(idform($('#formulario'), item.campo)).parent().children(0)[0].innerHTML = item.etiqueta;
                });
            }
        }, 100);
        setTimeout(function() { clearInterval(fpInterval); }, 10000);
        {% endif %}
        parametros={{null|json_encode|raw}};
        $("select[id*=idformapago]").change(function () {
            if(window.sessionStorage.getItem('idfp'+$("select[id*=idformapago]").val())==null)
                if(parametros!=null && parametros[$("select[id*=idformapago]").val()]){
                    jparametros=jQuery.parseJSON(parametros[$("select[id*=idformapago]").val()]);
                }
                else
                    jparametros=[];
            else
                jparametros=jQuery.parseJSON(window.sessionStorage.getItem('idfp'+$("select[id*=idformapago]").val()));
            ocultaCamposPagoForm($('#formulario'));
            manejoFormularioPago(
                $("input[id*=precio]"),
                $('#formulario'),
                jparametros
            ); 
        }); 
        {% endif %}

        if($("#{{edit_form.idpia.foto.vars.id}}").attr("type")!="hidden"){
            //Agrega un bton al lado derecho del campo
            $("#{{edit_form.idpia.foto.vars.id}}").parent().append(
                "<button type='button' id='btn_foto'></button>"
            );    
            $("#{{edit_form.idpia.foto.vars.id}}").attr("type","hidden");
            var dato = "{{edit_form.idpia.foto.vars.data}}";
            var nombrearchivo = dato.substring(dato.lastIndexOf("/")+1,dato.length);        
            $("<input id='namefile_foto' type='text' value='' readonly>").insertAfter($("#{{edit_form.idpia.foto.vars.id}}"));        
            if($("#{{edit_form.idpia.foto.vars.id}}").val()=="")
                $("<img id='imagen_foto' src='{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}' sytle='height:21px'/>" ).insertBefore($("#{{edit_form.idpia.foto.vars.id}}"));
            else{
                $("<img id='imagen_foto' src='{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ edit_form.idpia.foto.vars.data}}' sytle='height:21px'/>" ).insertBefore($("#{{edit_form.idpia.foto.vars.id}}"));
                $("#namefile_foto").val(nombrearchivo);
            }
            $('#btn_foto').append("<img id='icon-foto' src='{{asset('bundles/fratersoftpiaweb/images/retrato-enmarcado.png')}}'/>").button();
            $("#btn_foto").on('click', function() {
                cargar_imagen($("#{{ edit_form.idpia.foto.vars.id }}"),$("#imagen_foto"),350,600,null);
            });        
        }
        
        if($("#{{edit_form.idpia.fileiddocumento.vars.id}}").attr("type")!="hidden"){
            controlLoadFile($("#{{edit_form.idpia.fileiddocumento.vars.id}}"),"pdf");
            controlLoadFile($("#{{edit_form.idpia.filepartidanacimiento.vars.id}}"),"pdf");
            controlLoadFile($("#{{edit_form.idpia.filecertificadodeportivo.vars.id}}"),"pdf");
        }

        //muestra la ventana para cargar imagenes o archivos
        $("#uploadimage").dialog({
            autoOpen: false,
            modal: true,
            buttons: [
                {
                    text: "Aceptar",
                    click: function () {
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Cerrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });

        {% if edit_form.precio is defined %}
        $("#{{edit_form.precio.vars.id}}").change(function () {
            setTextoPrecio($("#{{edit_form.precio.vars.id}} option:selected"),$("#{{edit_form.idpago.texto.vars.id}}"));
            calcularTotalPagar(
                    $("#{{edit_form.precio.vars.id}}"),
                    $("#{{edit_form.idpago.monto.vars.id}}"),
                    {# {{recargas|json_encode|raw}} #}
                    {{null|json_encode|raw}}
            );
        });   
        {% endif %}

        {#$("#{{ edit_form.pagos[0].idmoneda.vars.id }}").change(function () {#}
        $("input[id*=idmoneda]").change(function () {
            console.log($(this).attr('id'));
            ocultaCamposPagoForm($('#formulario'));
            buscarFormasPago(
                $('#formulario'),
                {{entity.idevento.id}},
                $("#formulario input[type='radio']:checked").val()
            );
            buscaPrecio({{entity.idevento.id}},
                $('#{{ edit_form.idcompetencia.vars.id }}').val(),
                $('#{{ edit_form.idcategoria.vars.id }}').val(),
                $('#formulario'),
                [],
                $("#formulario input[type='radio']:checked").val()
            );
        });
        
    });
    
    {% for message in app.session.flashbag.get('success') %}
    $("<div id='dialog-message' title='Inscripcion'>\
        <p><span class='ui-icon ui-icon-circle-check' style='float:left; margin:0 7px 20px 0;'></span>\
        {{ message }}</p>\
    </div>").dialog({
        buttons: {
            'Aceptar': function() {
                $(this).dialog('close');
            }
        }
    });
    {% endfor %}
    </script>   
{% endblock %}
