{% extends '::base.html.twig' %}
{% import "FraterSoftPiaWebBundle:Default:FS-TWIG-Library.html.twig" as twiglib %}
{% block poweredby %}
{{ include('FraterSoftPiaWebBundle:Default:_poweredby.html.twig') }}
{% endblock %}
{% block style %}
<style type="text/css">
    th{
        text-align:left;
    }
    table{
        padding: 10px;
        width:650px;        
        border: 1px solid black;
    }
</style>
{% endblock %}
{% block body -%}
    <table align="center">
        <tbody>
            {% if inscrito.idevento.rutaperfil is not null %}
            <tr>
                <td colspan='3' align='center'>
                    <img width="300 px" 
                         src="{{ app.request.getSchemeAndHttpHost() ~ asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ inscrito.idevento.rutaperfil }}">                    
                </td>
            </tr>
            {% endif %}
            <tr>
                <td colspan='3' align='center'>
                    <h1>Confirmaci&oacute;n de Inscripci&oacute;n</h1>
                </td>
            </tr>
            {% if inscrito.numero != null %}
            <tr>
                <td colspan='3' align='center'><h1>Dorsal Numero: {{ inscrito.numero }}</h1></td>
            </tr>
            {% endif %}            
            <tr>
                <td rowspan="{{inscrito.idevento.atributos|length + 5}}">
                    <img width="300 px" 
                         src="{{ app.request.getSchemeAndHttpHost() ~ asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ inscrito.idevento.logo }}">
                </td>
            </tr>            
            {% for atributo in inscrito.idevento.atributos %}
            {% if atributo.etiqueta is null %}
            <tr><th>{{atributo.idatributo.nombre|capitalize}}</th><td>{{twiglib.imprimirAtributo(atributo,attribute(inscrito.idpia,'get'~atributo.idatributo.nombre))}}</td></tr>
            {% else %}
            <tr><th>{{atributo.etiqueta}}</th><td>{{ twiglib.imprimirAtributo(atributo,attribute(inscrito.idpia,'get'~atributo.idatributo.nombre)) }}</td></tr>
            {% endif %}
            {% endfor %}
            {% if inscrito.idcompetencia is not null %}
            <tr><th>Distancia</th><td>{{ inscrito.idcompetencia.descripcion }}</td></tr>
            {% endif %}
            {% if inscrito.idcategoria is not null %}
            <tr><th>Categoria</th><td>{{ inscrito.idcategoria.descripcion }}</td></tr>
            {% endif %}
            {% if inscrito.competencias is not empty and inscrito.competencias|length > 1 %}
            <tr><th>{{ inscrito.idevento.titulocompetencias|default('Competencias') }}</th><th>Categoria</th></tr>
            {% for ic in inscrito.competencias %}
            <tr><td>{{ ic.idcompetencia.descripcion }}</td><td>{% if ic.idcategoria %}{{ ic.idcategoria.descripcion }}{% endif %}</td></tr>
            {% endfor %}
            {% endif %}
            <tr>
                <th>PreInscrito el</th>
                <td>{{ inscrito.fechahora|date('d-m-Y H:i:s') }}</td>
            </tr>
            <tr>
                <th>Conciliado el</th>
                <td>{{ inscrito.pagos[0].conciliadoel|date('d-m-Y H:i:s') }}</td>
            </tr>            
            <tr>
                <td colspan="3">
                    <p>Estimado(a) participante:</p>
                    <p>Por medio de la presente le informamos que su  pago ha sido confirmado.</p>
                    <p>A continuaci&oacute;n los datos suministrados por usted. En caso de existir alg&uacute;n error, por favor notif&iacute;quelo por esta v&iacute;a lo antes posible.</p>
                    {#% if inscrito.idevento.id == 3921097655 %#}
                    {% if inscrito.idevento.idorganizador.id == 30 %}
                    <p>ENTREGA DE KIT</p>
                    {{ inscrito.idevento.rutamapa|raw }} 
                    <p>POR NINGUN MOTIVO SE ENTREGARAN KITS FUERA DEL HORARIO ESTABLECIDO</p>
                    <br>
                    <p><h2>NO GARANTIZAMOS LA TALLA DE LA FRANELA</h2></p>
                    <p>ES INDISPENSABLE PARA RETIRAR EL KIT<br>
                    -  C&eacute;dula Laminada del atleta<br>
                    -  Para retirar el kit de otro participante, deber&aacute; presentar fotocopia de cedula tanto del participante como de la persona que lo retirara, m&aacute;s una autorizaci&oacute;n por escrito.</p>
                    {% endif %}
                    <p align="center"><h2>NOTA IMPORTANTE<br>
                    Las Inscripciones NO SON REEMBOLSABLES Y/O TRANSFERIBLES.</h2></p>
                    <br>
                    <p>Gracias por participar en nuestro evento</p>
                    <br>
                    {{ inscrito.idevento.idorganizador.banco|raw }} {# IMPRIME LAS REDES SOCIALES #}
                    <p>
                    {{ inscrito.idevento.idorganizador.contacto }}<br>
                    {{ inscrito.idevento.idorganizador.telefonocontacto }}<br>
                    </p>
                </td>
            </tr>              
        </tbody>
    </table>
    {% if controlParental is defined and controlParental %}
    <table align="center" border="0" style="margin-top:20px; border:1px solid #ccc; padding:15px; width:650px;">
        <tr><td style="font-weight:bold; font-size:14px;">Aviso Importante</td></tr>
        <tr><td style="padding-top:8px;">{{ controlParental.mensaje }}</td></tr>
        {% if controlParental.documento_pdf and controlParental.titulo_documento %}
        <tr><td style="padding-top:8px;"><b>Documento adjunto:</b> {{ controlParental.titulo_documento }}</td></tr>
        {% endif %}
    </table>
    {% endif %}
{% endblock %}
