{% extends '::base.html.twig' %}
{% import "FraterSoftPiaWebBundle:Default:FS-TWIG-Library.html.twig" as twiglib %}
{% if entity.idevento.tema is defined and entity.idevento.tema is not null %}{% set temastyle=entity.idevento.tema.styles %}{% endif %}
{% block javascripts %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig") }}    
    <script>
        $(document).ready(function () {
            {#$("#textoformapago").html(TextoFormaPago('{{ entity.pagos[0].tipo }}'));#}
            $('#tablaReporte').DataTable({
                dom: "t",
                ordering: false,
                pageLength: 30,
                columns: [
                    { title: "" },
                    { title: "" },
                ],       
                "columnDefs": [ //centra el contenido de la columna
                    {"className": "dt-right", "targets":0},
                    {"className": "dt-left", "targets":1},
                ],  
            });
            $("#tablaReporte").append("<caption><b>DATOS DE PRE-INSCRIPCI&Oacute;N</b></caption>");
            $('#tablaPago').DataTable({
                dom: "t",
                ordering: false,
                pageLength: 30,
                columns: [
                    { title: "" },
                    { title: "" },
                ],       
                "columnDefs": [ //centra el contenido de la columna
                    {"className": "dt-right", "targets":0},
                    {"className": "dt-left", "targets":1},
                ],  
            });
            $("#tablaPago").append("<caption><b>INFORMACION DE PAGO</b></caption>");
            
        });
    </script>           
{% endblock %} 
{% block style %}
<style type="text/css">
    div.container
    {     
        width: 400px;
        margin: auto;
        text-align: center;
    }    
    #boton{
        text-align: center;
    }
    #mensaje{
        margin: auto;            
        text-align: center;
        font-size: 16px;
        width: 400px
    }    
    img#imagen_foto,img#imagen_archivo {
        height: 16px;
    }      
</style>
{% endblock %} 
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div class="container"><p>
    <table id="tablaReporte" class="display compact">
        <tbody>          
            {%if entity.numero is not null%}<tr><th>Numero</th><td>{{ entity.numero }}</td></tr>{%endif%}
            {% for atributo in entity.idevento.atributos %}
            {% if atributo.etiqueta is null %}
            <tr><th>{{atributo.idatributo.nombre|capitalize}}</th><td>{{twiglib.imprimirAtributo(atributo,attribute(entity.idpia,'get'~atributo.idatributo.nombre))}}</td></tr>
            {% else %}
            <tr><th>{{atributo.etiqueta}}</th><td>{{ twiglib.imprimirAtributo(atributo,attribute(entity.idpia,'get'~atributo.idatributo.nombre)) }}</td></tr>
            {% endif %}
            {% endfor %}
            <tr><th>Distancia</th><td>{{ entity.idcompetencia.descripcion }}</td></tr>
            <tr><th>Fecha y Hora</th><td>{{ entity.fechahora.timestamp|date('d-m-Y H:i:s') }}</td></tr>                        
            
            {#% for atributo in entity.idevento.atributos %}
            {% for key, dato in entity.idpia %}
            {%if atributo.idatributo.nombre|lower==key %}
            {%if atributo.idatributo.tipodato=='D' %}
            <tr><th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th><td>{{ entity.idpia[atributo.idatributo.nombre|lower]['timestamp']|date('d-m-Y') }}</td></tr>
            {%elseif atributo.idatributo.tipodato=='E' %}
            <tr><th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th><td>{{ entity.idpia.idestado.nombre }}</tr>
            {%elseif atributo.idatributo.tipodato=='I' %}
            <tr>
                <th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th>
                {% if entity.idpia[atributo.idatributo.nombre|lower] %}
                <td>
                    <a href='{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')~entity.idpia[atributo.idatributo.nombre|lower]}}' target='_blank'>
                    <img id='imagen_{{atributo.idatributo.nombre|lower}}' src='{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')~entity.idpia[atributo.idatributo.nombre|lower]}}'/></a>
                </td>
                {% else %}
                <td>
                    <img id='imagen_{{atributo.idatributo.nombre|lower}}' src='{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}'/>
                </td>
                {% endif %}
            </tr>
            {%elseif atributo.idatributo.tipodato=='F' %}
            <tr>
                <th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th>
                {% if entity.idpia[atributo.idatributo.nombre|lower] %}
                <td>
                    <a href='{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')~entity.idpia[atributo.idatributo.nombre|lower]}}' target='_blank'>
                    <img id='imagen_archivo' src='{{asset('bundles/fratersoftpiaweb/images/pdf-128.png')}}'/></a>
                </td>
                {% else %}
                <td>
                    <img id='imagen_archivo' src='{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}'/>
                </td>
                {% endif %}
            </tr>
            {%else%}
            <tr><th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th><td>{{ entity.idpia[atributo.idatributo.nombre|lower] }}</td></tr>
            {%endif%}
            {%endif%}
            {%endfor%}                
            {%endfor%#}
            <tr><th>Categoria</th><td>{{ entity.idcategoria.descripcion }}</td></tr> 
        </tbody>
    </table></p>
    {% if entity.pagos[0] is defined %}
    <table id="tablaPago" class="display compact">
        <tbody>          
            <tr><th>Forma de Pago</th><td>{% if entity.pagos[0].idformapago is null %}""{% else %}{{entity.pagos[0].idformapago.nombre}}{% endif %}</td></tr>
            <tr><th>Precio</th><td>{{ entity.pagos[0].precio }}</td></tr>
            {% for parametro in parametros %}
            {% if attribute(entity.pagos[0],'get' ~ parametro.campo).timestamp is defined %}
            <tr><th>{{ parametro.etiqueta }}</th><td>{{ attribute(entity.pagos[0],'get' ~ parametro.campo)|date('d-m-Y') }}</td></tr>
            {% elseif parametro.campo=='idcuenta' %}
            <tr><th>{{ parametro.etiqueta }}</th><td>{{ attribute(entity.pagos[0].idcuenta.idbanco,'getNombre') }}</td></tr>
            {%else%}
            <tr><th>{{ parametro.etiqueta }}</th><td>{{ attribute(entity.pagos[0],'get' ~ parametro.campo) }}</td></tr>
            {%endif%}
            {% endfor %}
        </tbody>
    </table>
    {%endif%}
    <div id='mensaje'>
        {% if entity.idevento.proceso == 1 %}
        <p>Su incripci&oacute;n ser&aacute; certificada una vez verifiquemos los datos del pago.</p>
        {% endif %}
    </div>               
    <div id='boton'><p>
    <a href="{{ app.request.server.get('HTTP_REFERER') }}">            
        <button class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
            Regresar
        </button> 
    </a></p>
    </div>
    </div>
    </div>
{% endblock %}