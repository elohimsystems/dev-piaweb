{% extends '::base.html.twig' %}
{% if evento.tema is defined and evento.tema is not null %}{% set temastyle=evento.tema.styles %}{% endif %}
{% block javascripts %}
    <script>
        $(document).ready(function () {
            $('#tablaReporte').DataTable({
                dom: "t",
                ordering: false,
                pageLength: 30,
                columns: [
                    { title: "" },
                    { title: "" },
                ],       
                "columnDefs": [ //centra el contenido de la columna
                    {"className": "dt-right", "targets":0},
                    {"className": "dt-left", "targets":1},
                ],  
            });
            $("#tablaReporte").append("<caption><b>CONFIRMACI&Oacute;N DE PRE-INSCRIPCI&Oacute;N</b></caption>");
        });
    </script>           
{% endblock %} 
{% block style %}
<style type="text/css">
    div.container
    {     
        width: 400px;
        margin: auto;
        text-align: center;
    }    
    #boton{
        text-align: center;
    }
    #mensaje{
        margin: auto;            
        text-align: center;
        font-size: 16px;
    }    
</style>
{% endblock %} 
{% block body -%}
    <div class="container">
    <table id="tablaReporte" class="display compact">
        <tbody>          
            <tr><th>Competencia</th><td>{{ entity.idcompetencia.descripcion }}</td></tr>
            {%if entity.numero is not null%}<tr><th>Numero</th><td>{{ entity.numero }}</td></tr>{%endif%}
            {% for atributo in atributos %}
            {% for key, dato in entity.idpia %}
            {%if atributo.idatributo.nombre|lower==key %}
            {%if atributo.idatributo.tipodato=='D' %}
            <tr><th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th><td>{{ entity.idpia[atributo.idatributo.nombre|lower]['timestamp']|date('d-m-Y') }}</td></tr>
            {%elseif atributo.idatributo.tipodato=='E' %}
            <tr><th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th><td>{{ entity.idpia.idestado.nombre }}</tr>
            {%else%}
            <tr><th>{% if atributo.etiqueta is null %}{{ key|title }}{% else %}{{atributo.etiqueta}}{% endif %}</th><td>{{ entity.idpia[atributo.idatributo.nombre|lower] }}</td></tr>
            {%endif%}
            {%endif%}
            {%endfor%}                
            {%endfor%}
            <tr><th>Categoria</th><td>{{ entity.idcategoria.descripcion }}</td></tr> 
            <tr><th>Fecha y Hora</th><td>{{ entity.fechahora.timestamp|date('d-m-Y H:i:s') }}</td></tr>                        
        </tbody>
    </table>
    <div id='mensaje'>
        {% if evento.proceso == 1 %}
            <p>Su incripci&oacute;n ser&aacute; certificada una vez verifiquemos los datos del pago.</p>
            <p>Correo de confirmaci&oacute;n de pre-inscripci&oacute;n enviado satisfactoriamente, revise la bandeja de
            correos no deseados o spams, en caso de no ubicarlo en la bandeja de correos recibidos</p>
        {% elseif evento.proceso == 2 %}
            <p>Le enviamos un correo con el costo de la inscripcion y los pasos a seguir pago.</p>
            <p>En caso de no ubicarlo en la bandeja de correos recibidos, por favor revise la bandeja de correos no deseados o spam</p>
        {% endif %}
    </div>               
    <div id='boton'><p>
    <a href="{{ path('competidor_find', { 'idevento': evento.id }) }}">            
        <button class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only">
        {% if evento.proceso == 1 %}
            Inscribir Otro Participante
        {% elseif evento.proceso == 2 %}
            Pre-Inscribir Otro Participante
        {% endif %}
        </button> 
    </a></p>
    </div>    
    </div>
{% endblock %}
