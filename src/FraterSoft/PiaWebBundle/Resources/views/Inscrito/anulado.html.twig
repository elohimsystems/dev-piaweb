{% extends '::base.html.twig' %}
{% block style %}
    <style type="text/css">
        th{
            text-align: left;
        }
        table {
            margin: auto;
            border: 0px solid black;
            width: 400px;
        }        
        #titulo{
            text-align: center;
            font-size: 24px;
        }
        #evento{
            text-align: center;
            font-size: 24px;
        }        
    </style>
{% endblock %}  
{% block body -%}
    <table>
        <tbody>
            <tr>
                <td colspan="2" align="center"><p id="titulo"><strong>PRE-INSCRIPCION ANULADA</strong></p></td>
            </tr>        
            <tr>
                <td colspan="2" align="center"><p id="evento"><strong>{{ inscrito.idevento.nombre }}</strong></p></td>
            </tr>        
            <tr><th>Cedula</th><td>{{ inscrito.idpia.iddocumento }}</td></tr>
            <tr><th>Apellido</th><td>{{ inscrito.idpia.apellido }}</td></tr>
            <tr><th>Nombre</th><td>{{ inscrito.idpia.nombre }}</td></tr>
            <tr>
                <th>Fecha y Hora</th>
                <td>{{ inscrito.fechahora|date('d-m-Y H:i:s') }}</td>
            </tr>
            {% if  idgrupo is defined %}
            <tr>
                <td colspan="2" align="center">
                    Su inscripcion grupal fue anulada. Puede volver a inscribirse
                    en el mismo grupo o en otro si asi lo desea.
                </td>
            </tr>               
            {% else %}
            <tr>
                <td colspan="2" align="center">
                    El Organizador ha decido anular esta pre-inscripci&oacute;n. Para mayor
                    informaci&oacute;n al respecto, comunicarse con {{ inscrito.idevento.idorganizador.contacto }} 
                    al n&uacute;mero {{ inscrito.idevento.idorganizador.telefonocontacto }} o al correo
                    {{ inscrito.idevento.idorganizador.emailcontacto }}
                </td>
            </tr>               
            {% endif %}
        </tbody>
    </table>
{% endblock %}
