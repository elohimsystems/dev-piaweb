{% extends '::base.html.twig' %}

{% block body -%}
    <h1>Club</h1>

    <table class="record_properties">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ entity.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ entity.nombre }}</td>
            </tr>
            <tr>
                <th>Tipoidentificacion</th>
                <td>{{ entity.tipoIdentificacion }}</td>
            </tr>
            <tr>
                <th>Numidentificacion</th>
                <td>{{ entity.numIdentificacion }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ entity.email }}</td>
            </tr>
            <tr>
                <th>Logonombre</th>
                <td>{{ entity.logonombre }}</td>
            </tr>
            <tr>
                <th>Logoarchivo</th>
                <td>{{ entity.logoarchivo }}</td>
            </tr>
            <tr>
                <th>Logo</th>
                <td>{{ entity.logo }}</td>
            </tr>
            <tr>
                <th>Usuario</th>
                <td>{{ entity.usuario }}</td>
            </tr>
        </tbody>
    </table>

        <ul class="record_actions">
    <li>
        <a href="{{ path('club') }}">
            Back to the list
        </a>
    </li>
    <li>
        <a href="{{ path('club_edit', { 'id': entity.id }) }}">
            Edit
        </a>
    </li>
    <li>{{ form(delete_form) }}</li>
</ul>
{% endblock %}
