{% extends '::base.html.twig' %}

{% block body -%}
    <div id="titulo">CAMPEONATO: {% if entities[0] is defined %} {{entities[0].idcampeonato}} {% else %}  {% endif %}</div>
    <div id="tabs">    
        {{ include("FraterSoftPiaWebBundle:Campeonato:tabs.html.twig") }}
        <table class="records_list">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Club</th>
                    <th>Pordefecto</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for entity in entities %}
                <tr>
                    <td><a href="{{ path('campeonatoclubes_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                    <td>{{ entity.idclub.nombre }}</td>
                    <td>{{ entity.pordefecto }}</td>
                    <td>
                    <ul>
                        <li>
                            <a href="{{ path('campeonatoclubes_show', { 'id': entity.id }) }}">show</a>
                        </li>
                        <li>
                            <a href="{{ path('campeonatoclubes_edit', { 'id': entity.id }) }}">edit</a>
                        </li>
                    </ul>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

            <ul>
            <li>
                <a href="{{ path('campeonatoclubes_new') }}">
                    Create a new entry
                </a>
            </li>
        </ul>
    </div> 
    {% endblock %}
