{% extends '::base.html.twig' %}

{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <h1>CampeonatoClubes</h1>

    <table class="record_properties">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ entity.id }}</td>
            </tr>
            <tr>
                <th>Idcampeonato</th>
                <td>{{ entity.idcampeonato }}</td>
            </tr>
            <tr>
                <th>Club</th>
                <td>{{ entity.club }}</td>
            </tr>
            <tr>
                <th>Pordefecto</th>
                <td>{{ entity.pordefecto }}</td>
            </tr>
        </tbody>
    </table>

        <ul class="record_actions">
    <li>
        <a href="{{ path('campeonatoclubes') }}">
            Back to the list
        </a>
    </li>
    <li>
        <a href="{{ path('campeonatoclubes_edit', { 'id': entity.id }) }}">
            Edit
        </a>
    </li>
    <li>{{ form(delete_form) }}</li>
</ul>
    </div>
{% endblock %}
