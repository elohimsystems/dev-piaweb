{% extends '::base.html.twig' %}
{% block style %} 
{{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':0}) }}    
<style type="text/css">
    #tabs{  /* Oculta el tabs para que se muestre luego de cargar todo el html */
        display: none;
    }
    #formulario > div:nth-child(1){
        /*display: none;*/
    }
</style>
{% endblock %}  
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div id="titulo_padre">{{campeonato.nombre}} {{campeonato.anio}}</div>
    <div id="tabs">    
        {{ include("FraterSoftPiaWebBundle:Campeonato:tabs.html.twig") }}
        <div id="tabs-1">     
            <div id="titulotabla"><h3>Afiliar Clubes</h3></div>
            <table id="campeonatoclubes" class="display row-border hover">
            </table>    
        </div>
        <button class="ui-button ui-widget ui-corner-all" onclick="$(location).attr('href', '{{app.session.get('urllistacampeonatos')}}');">Regresar</button>
        <div id="dialogformGuardar" title="Afiliar club">
            {{ form_start(form,{'attr': {'id': 'formulario'}}) }}
            {{ form_end(form) }} 
        </div>          
        <div id="dialogelimiar" title="Advertencia!!!">
            ¿Esta seguro que desea desafiliar el club <strong id="eliminar"></strong>?
        </div> 
        <div id="dialog-message" title="Mensaje">
        </div>
    </div>
    </div>
{% endblock %}
{% block javascripts -%}
{{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig") }}
<script type="text/javascript" language="javascript" src="//cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
<script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/pdfmake.min.js"></script>
<script type="text/javascript" language="javascript" src="//cdn.rawgit.com/bpampuch/pdfmake/0.1.27/build/vfs_fonts.js"></script>     
<script>
    $(document).ready(function () { 
        $("#tabs").css("display","block");            
        $('#tabs a[href="#tabs-2"]').on("click", function () {
            $(location).attr('href', '{{ path('categoria_campeonato_new',{'idcampeonato':campeonato.id}) }}');
        });            
        $('#tabs a[href="#tabs-3"]').on("click", function () {
            $(location).attr('href', '{{ path('campeonatocompetidores_new',{'idcampeonato':campeonato.id}) }}');
        });                    
                        
        tablaDatos(
                $('#formulario'), //Se usa para llenar lo campos del formulario
                {{campos|json_encode|raw}}, //json con los atributos de la entidad y sus caracteristicas
                'Clubes Afiliados', //Usada para el titulo 
                "{{ path('campeonatoclubes_create')}}", //Url para crear
                "{{ path('campeonatoclubes_update',{'id':'_id_'})}}", //Url para editar
                "{{ path('campeonatoclubes_listaajax',{'idcampeonato': campeonato.id }) }}", //Url para buscar los datos a listar
                [{posicion:3, config:{title:"Club",data:"club"}}] //Agrega una columna a la tabla en la posicion indicada
        );
        dialogGuardar($('#formulario'),{{campos|json_encode|raw}});
        dialogEliminar('{{ path('campeonatoclubes_delete',{'id':'_id_'})}}');
        dialogMensaje();
                
        {% if estado is defined %}
            {% if estado == 1 %}
                $("#dialog-message").html("<p><span class='ui-icon ui-icon-circle-check' style='float:left; margin:0 7px 50px 0;'>" +
                        "</span>El Club fue DESAFILIADO satisfacoriamente.</p>").dialog();
                $("#dialog-message").dialog("open");
            {% endif %}    
            {% if estado == 2 %}
                $("#dialog-message").html("<p><span class='ui-icon ui-icon-circle-check' style='float:left; margin:0 7px 50px 0;'>" +
                        "</span>El Club fue AFILIADO satisfacoriamente.</p>").dialog();
                $("#dialog-message").dialog("open");
            {% endif %}    
            {% if estado == 3 %}
                $("#dialog-message").html("<p><span class='ui-icon ui-icon-circle-check' style='float:left; margin:0 7px 50px 0;'>" +
                        "</span>La afiliacion fue ACTUALIZADA satisfacoriamente.</p>").dialog();
                $("#dialog-message").dialog("open");
            {% endif %}    
        {% endif %}        
    });    
</script>    
{% endblock %}
