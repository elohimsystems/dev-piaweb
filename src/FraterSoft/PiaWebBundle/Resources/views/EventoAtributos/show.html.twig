{% extends '::base.html.twig' %}

{% block body -%}
    <h1>EventoAtributos</h1>

    <table class="record_properties">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ entity.id }}</td>
            </tr>
            <tr>
                <th>Etiqueta</th>
                <td>{{ entity.etiqueta }}</td>
            </tr>
            <tr>
                <th>Criterio</th>
                <td>{{ entity.criterio }}</td>
            </tr>
            <tr>
                <th>Orden</th>
                <td>{{ entity.orden }}</td>
            </tr>
            <tr>
                <th>Busqueda</th>
                <td>{{ entity.busqueda }}</td>
            </tr>
        </tbody>
    </table>
{% endblock %}
