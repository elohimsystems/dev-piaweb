{% extends '::base.html.twig' %}

{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <h1>Preciosevento list</h1>

    <table class="records_list">
        <thead>
            <tr>
                <th>Id</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Hasta</th>
                <th>Prioridad</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td><a href="{{ path('preciosevento_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.precio }}</td>
                <td>{{ entity.cantidad }}</td>
                <td>{{ entity.hasta }}</td>
                <td>{{ entity.prioridad }}</td>
                <td>
                <ul>
                    <li>
                        <a href="{{ path('preciosevento_show', { 'id': entity.id }) }}">show</a>
                    </li>
                    <li>
                        <a href="{{ path('preciosevento_edit', { 'id': entity.id }) }}">edit</a>
                    </li>
                </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

        <ul>
        <li>
            <a href="{{ path('preciosevento_new') }}">
                Create a new entry
            </a>
        </li>
    </ul>
    </div>
    {% endblock %}
