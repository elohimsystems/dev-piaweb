{% extends '::base.html.twig' %}
{% block style %}
<style type="text/css">
    .maestro-form-wrap { max-width: 520px; margin: 20px 0; }
    .maestro-form-wrap h1 { font-size: 20px; margin: 0 0 16px; }
    .maestro-form-wrap form > div { margin-bottom: 12px; }
    .maestro-form-wrap label { display: block; font-weight: bold; font-size: 12px; color: #555; margin-bottom: 3px; }
    .maestro-form-wrap input[type="text"],
    .maestro-form-wrap input[type="email"],
    .maestro-form-wrap input[type="file"],
    .maestro-form-wrap select {
        width: 100%;
        box-sizing: border-box;
        padding: 6px 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 13px;
    }
    .maestro-form-wrap .logo-actual { margin-bottom: 4px; }
    .maestro-form-wrap .logo-actual img { max-height: 80px; border: 1px solid #eee; border-radius: 4px; }
    .maestro-form-acciones { margin-top: 18px; display: flex; gap: 10px; }
    .maestro-form-acciones a {
        display: inline-block;
        padding: 8px 16px;
        border: 1px solid #ccc;
        border-radius: 4px;
        text-decoration: none;
        color: #333;
        background: #f7f7f7;
        font-size: 13px;
    }
    @media screen and (max-width: 600px) {
        .maestro-form-wrap { max-width: 100%; }
    }
</style>
{% endblock %}
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
        <div class="maestro-form-wrap">
            <h1>{{ titulo }}</h1>

            {% if entity.logo %}
                <div class="logo-actual">
                    <label>Logo actual</label>
                    <img src="{{ asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ entity.logo }}" alt="">
                </div>
            {% endif %}

            {{ form_start(form) }}
            {{ form_row(form.nombre) }}
            {{ form_row(form.abreviado) }}
            {{ form_row(form.logo) }}
            {{ form_row(form.email) }}
            {{ form_row(form.rif) }}
            {{ form_row(form.contacto) }}
            {{ form_row(form.telefonocontacto) }}
            {{ form_row(form.emailcontacto) }}
            {{ form_row(form.idmoneda) }}
            {{ form_row(form.submit) }}
            {{ form_end(form) }}

            <div class="maestro-form-acciones">
                <a href="{{ path('maestro_organizador') }}">Volver al listado</a>
            </div>
        </div>
    </div>
{% endblock %}
