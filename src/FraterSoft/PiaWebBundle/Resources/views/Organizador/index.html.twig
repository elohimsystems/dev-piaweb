{% extends '::base.html.twig' %}
{% block javascripts %}
    <script>
        $(document).ready(function () {
            $('#tablaOrganizadores').DataTable({
                "dom": 'Bflit<"bottom"Blp>',
                "order": [[1, "ASC"]],
                "columnDefs": [{ "orderable": false, "targets": [0, -1] }],
                "language": {
                    "emptyTable": "No hay organizadores registrados",
                    "lengthMenu": "Muestra _MENU_ registros",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    "infoEmpty": "0 registros",
                    "infoFiltered": "(filtrados de _MAX_)",
                    "search": "Buscar:",
                    "paginate": { "first": "Primero", "last": "Ultimo", "next": "Siguiente", "previous": "Anterior" }
                }
            });
        });
    </script>
{% endblock %}
{% block style %}
<style type="text/css">
    .maestro-cab {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 12px;
    }
    .maestro-cab h1 { margin: 0; font-size: 20px; }
    .btn-nuevo {
        background: #337ab7;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }
    td, th { font-size: 11px; }
    #tablaOrganizadores td { vertical-align: middle; }
    .org-logo { width: 32px; height: 32px; object-fit: contain; border-radius: 4px; border: 1px solid #eee; }
    .maestro-flash { padding: 8px 12px; border-radius: 4px; margin: 8px 0; font-size: 13px; }
    .maestro-flash.success { background: #e8f5e9; border: 1px solid #a5d6a7; color: #2e7d32; }
    .maestro-flash.error { background: #fdecea; border: 1px solid #f5c6cb; color: #c0392b; }
    .acciones-org { display: flex; gap: 4px; }
    .acciones-org a, .acciones-org button {
        border: 1px solid #ccc;
        background: #f7f7f7;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 11px;
        cursor: pointer;
        text-decoration: none;
        color: #333;
    }
    .acciones-org .btn-eliminar { color: #c0392b; border-color: #e6b0aa; }
</style>
{% endblock %}
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}

        {% for tipo, mensajes in app.session.flashbag.all %}
            {% for mensaje in mensajes %}
                <div class="maestro-flash {{ tipo }}">{{ mensaje }}</div>
            {% endfor %}
        {% endfor %}

        <div class="maestro-cab">
            <h1>Maestro de Organizadores</h1>
            <a href="{{ path('maestro_organizador_new') }}"><button type="button" class="btn-nuevo">Nuevo Organizador</button></a>
        </div>

        <table id="tablaOrganizadores" class="display row-border hover compact">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Nombre</th>
                    <th>Abreviado</th>
                    <th>RIF</th>
                    <th>Email</th>
                    <th>Contacto</th>
                    <th>Telefono</th>
                    <th>Moneda</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for entity in entities %}
                    <tr>
                        <td>
                            {% if entity.logo %}
                                <img class="org-logo" src="{{ asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ entity.logo }}" alt="">
                            {% endif %}
                        </td>
                        <td>{{ entity.nombre }}</td>
                        <td>{{ entity.abreviado }}</td>
                        <td>{{ entity.rif }}</td>
                        <td>{{ entity.email }}</td>
                        <td>{{ entity.contacto }}</td>
                        <td>{{ entity.telefonocontacto }}</td>
                        <td>{{ entity.idmoneda ? entity.idmoneda.nombre : '' }}</td>
                        <td>
                            <div class="acciones-org">
                                <a href="{{ path('maestro_organizador_edit', { 'id': entity.id }) }}">Editar</a>
                                <form method="post" action="{{ path('maestro_organizador_eliminar', { 'id': entity.id }) }}"
                                      onsubmit="return confirm('¿Eliminar el organizador {{ entity.nombre|e('js') }}? Esta accion no se puede deshacer.');"
                                      style="margin:0;">
                                    <button type="submit" class="btn-eliminar">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
