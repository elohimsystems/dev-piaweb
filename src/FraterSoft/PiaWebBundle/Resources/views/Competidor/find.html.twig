{% block poweredby %}
{% for publicidad in evento.publicidad %}
    {% if publicidad.idubicacion == 2 and publicidad.estatus==1 %}
        <div style="text-align: center;">
            <img width="1350" height="100" src="{{asset('bundles/fratersoftpiaweb/images/' ~ publicidad.imagen)}}"/>
        </div>
    {% endif %}
{% endfor %}
<div id="poweredby" style="text-align: center;margin: 10px 20px 30px;border: 1px">
    <a href="http://www.sistemapia.com" target="_blank" style="text-decoration:none">
        <b style="font-size: 9px">
            V-{{ asset('')|slice(7,asset('')|length-5-7) }}
        </b><br>
        <strong>
        powered by
        <img width="40" align="center" 
             src="{{asset('bundles/fratersoftpiaweb/images/logopiaft.png')}}"/>
        </strong>
    </a>
</div>
{% endblock %}
{% block body -%}  
<div id="title-evento" style="text-align:center;"><h1>{{ evento.nombre}}</h1></div>
<div id="container">
    {{ form_start(form) }}
    {{ form_errors(form) }}
    {% set etiquetabuscar = form_label(form.buscar) %}
    <div class="texto">{{ form_label(form.atributo) }} {{ form_widget(form.atributo) }}</div>
    {% if form.siniddocumento is defined %}
    <div><h2>No posee {{form_label(form.buscar)}}?, marque aqui:{{form_widget(form.siniddocumento)}} e ingrese {{form_label(form.buscar)}} del Representante</h2></div>
    {% endif %}
    <div> {{ form_widget(form.buscar) }}</td>       
    <div class="texto">Pulsa el botón para</div>       
    <div> {{ form_widget(form.Buscar) }}</td>       
    {# Busca si el precio tiene cupos #}
    {% set cupoPrecio = '' %}
    {% set montoPrecio = 0 %}
    {% set textoPrecio = '' %}
    {% set monedaPrecio = '' %}
    {% for precioEvento in preciosEvento %}
        {% if precioEvento.cantidad != ''  %}
            {% set cupoPrecio = precioEvento.cantidad %}
            {% set montoPrecio = precioEvento.precio %}
            {% set textoPrecio = precioEvento.texto %}
            {% set monedaPrecio = precioEvento.idmoneda.codigolocal %}
        {% endif %}
    {% endfor %}
    {% if cupoPrecio == '' %}
    <div>
        <div id="countercierre">
        <H1>Este proceso cierra en</H1>
        <div class="centrar">
            <div id="counter"></div>
            <div class="desc">
                <div id='label_counter_dia'>Días</div>
                <div id='label_counter_horas'>Horas</div>
                <div id='label_counter_minutos'>Minutos</div>
                <div id='label_counter_segundos'>Segundos</div>
            </div>  
        </div>
        </div>
    </div>
    {% else %}
    <div>
        <div id="countercierre">
        <H1>{{textoPrecio}} {{cupoPrecio}} CUPOS</H1>
        <div>
            <H1>{{monedaPrecio}} {{montoPrecio}}</H1>
        </div>
        </div>
    </div>
    {% endif %}
    <div id="vacio"><br></div>
    <div class="soporte"><div>Para soporte o consulta puede escríbirnos o llámarnos por </div><b>WhatsApp 
        <a href="https://wa.me/{{ evento.idorganizador.telefonocontacto|replace({' ':"",'-':"",'.':""})}}" target="_blank"><img id="logowhatsapp" alt="{{ evento.idorganizador.telefonocontacto }}"  src="{{asset('bundles/fratersoftpiaweb/images/whatsapp.png')}}" ></a>
         al numero {{ evento.idorganizador.telefonocontacto }}</b><br>
         O escríbenos por <b>WhatsApp Web</b> en el siguiente enlace: <a href="https://wa.me/{{ evento.idorganizador.telefonocontacto|replace({' ':"",'-':"",'.':""}) }}" target="_blank">Link</a>
    </div>
    <div id="mejorcon">
        Mejor con: <img width="24" align="center" src="{{asset('bundles/fratersoftpiaweb/images/cromo.png')}}"/>
        <img width="24" align="center" src="{{asset('bundles/fratersoftpiaweb/images/opera.png')}}"/>
        <img width="24" align="center" src="{{asset('bundles/fratersoftpiaweb/images/mozilla.png')}}"/>                
    </div>
</div>
{{ form_end(form) }} 


