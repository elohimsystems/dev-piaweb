{% extends '::base.html.twig' %}
{% block javascripts %}
<script>
    function datediff(fromDate,toDate,interval) { 
        /*
         * DateFormat month/day/year hh:mm:ss
         * ex.
         * datediff('01/01/2011 12:00:00','01/01/2011 13:30:00','seconds');
         */
        var dias=0,horas=0,minutos=0,segundos=0;
        var second=1000, minute=second*60, hour=minute*60, day=hour*24, week=day*7; 
        fromDate = new Date(fromDate); 
        toDate = new Date(toDate); 
        var timediff = toDate - fromDate; 
        if (isNaN(timediff)) return NaN; 
        switch (interval) { 
            case "years": return toDate.getFullYear() - fromDate.getFullYear(); 
            case "months": return ( 
                ( toDate.getFullYear() * 12 + toDate.getMonth() ) 
                - 
                ( fromDate.getFullYear() * 12 + fromDate.getMonth() ) 
            ); 
            case "weeks"  : return Math.floor(timediff / week); 
            case "days"   : return Math.floor(timediff / day);  
            case "hours"  : return Math.floor(timediff / hour);  
            case "minutes": return Math.floor(timediff / minute); 
            case "seconds": return Math.floor(timediff / second); 
            case "dd:hh:mm:ss": 
                dias=Math.floor(timediff / day); 
                timediff=timediff-(dias * day);
                horas=Math.floor(timediff / hour); 
                timediff=timediff-(horas * hour);
                minutos=Math.floor(timediff / minute);
                timediff=timediff-(minutos * minute);
                segundos=Math.floor(timediff / second);
                //Completa con ceros si es necesario y retorna el string dd:hh:mm:ss
                return ("0" + dias.toString()).slice(-2) + ":" +
                        ("0" + horas.toString()).slice(-2) + ":" +
                        ("0" + minutos.toString()).slice(-2) + ":" +
                        ("0" + segundos.toString()).slice(-2);
            default: return undefined; 
        } 
    }
    $().ready(function() {  

    });
    
    $(function(){
        var currentdate = new Date('{{ "now"|date("m/d/Y H:i:s", evento.zonahoraria) }}');
        var fechacierre = '{{ evento.fechainicio|date("m/d/Y  H:i:s", evento.zonahoraria) }}';
        var now = 
            (currentdate.getMonth()+1) + "/" + 
            currentdate.getDate() + "/"+ 
            currentdate.getFullYear() + " " + 
            currentdate.getHours() + ":" + 
            currentdate.getMinutes() + ":" + 
            currentdate.getSeconds();       
        $('#counter').countdown({
            image: '{{ asset('bundles/fratersoftpiaweb/images') }}/digits.png',
            startTime: datediff(now,fechacierre,"dd:hh:mm:ss")
        });
    });
</script>
