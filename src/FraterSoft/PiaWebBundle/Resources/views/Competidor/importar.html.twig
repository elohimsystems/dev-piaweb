{% extends '::base.html.twig' %}
{% block stylesheets %}
    <link href="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.css')}}" rel="stylesheet" type="text/css"/>
{% endblock %}
{% block jsQuery %}    
    <script src="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.js')}}" type="text/javascript"></script>
{% endblock %}
{% block style %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':1}) }}
    <style type="text/css">
        #{{form.archivo.vars.id}}{
            width: 145px !important; 
            vertical-align: middle;
        }
        #namefile{
            width: 145px; 
            vertical-align: middle;
        }
        #btn_archivo{
            height: 21px;
            width: 31px;
        }     
        #btn_archivo > span{
            padding-bottom: 0;
            padding-top: 0;
            padding-left: 0;
            padding-right: 0;
        }
        #icon-archivo{
            vertical-align: middle;
        }
        #imagen_archivo{
            height: 20px;
            vertical-align: middle;
            padding-right: 2px;
        }
   </style>
{% endblock %}    

{% block javascripts %}
    <script>
        var dataSet=[];
        var camposSet=[];
        function processData(allText) {
            //var record_num = 5;  // or however many elements there are in each row
            var allTextLines = allText.split(/\r\n|\n/);
            var header = allTextLines[0].split(',');
            //var lines = [];
            //var headings = entries.splice(0,record_num);
            for(i=0;i<header.length-1;i++){
                camposSet[i]={ title: header[i] };
            }
            for(i=0,j=0;i<allTextLines.length-1;i++){
                if(i==0 && $("#{{form.cabecera.vars.id}}").prop('checked')==false)
                    dataSet[i]=allTextLines[i].split(',');
                else
                    if(i>0)
                        dataSet[j++]=allTextLines[i].split(',');
            }
            console.log(dataSet);
            //while (entries.length>0) {
            //    var tarr = [];
            //    for (var j=0; j<record_num; j++) {
            ///        tarr.push(headings[j]+":"+entries.shift());
            //    }
            //    lines.push(tarr);
            //}
        }        
        $().ready(function () {
            var data=null;
            controlLoadFile($("#{{form.archivo.vars.id}}"),"csv");
            $('#imagen_archivo').on('load', function () {
                if($('#imagen_archivo').attr('src').endsWith('csv-128.png')){
                    data = "{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + $("#{{form.archivo.vars.id}}").val();
                    $.ajax({
                        type: "GET",
                        url: data,
                        dataType: "text",
                        success: function(data) {
                            processData(data);
                        }
                     });
                }
            });                     
            $('#csvcompetidor').DataTable( {
                data: dataSet,
            } );            
            //muestra la ventana para cargar imagenes o archivos
            $("#uploadimage").dialog({
                autoOpen: false,
                modal: true,
                buttons: [
                    {
                        text: "Aceptar",
                        click: function () {
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "Cerrar",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });            
        });
    </script>   
{% endblock %}

{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <h1>Importar Competidores</h1>
    {{ form_start(form) }}
    {{ form_end(form) }}
    {% if actualizados is defined %}{{ actualizados }}{% endif %}
    <table id="csvcompetidor" class="display" cellspacing="0" width="100%">
        <thead>
            <tr>
            {% for clave,campo in campos %}
                {% if campo is iterable %}
                    {% if campo['constraint']!='primarykey' %}
                    <th>{{campo['nombre']}} </th>
                    {% endif %}
                {% endif %}
            {% endfor %}
            </tr>
        </thead>
    </table>
    <div id="uploadimage">    
        <div id="fine-uploader"></div>  
        {{ include("FraterSoftPiaWebBundle:Evento:template-fineuploader.html.twig") }} 
    </div>    
    {{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig",{'idevento':null}) }}
    </div>
{% endblock %}
