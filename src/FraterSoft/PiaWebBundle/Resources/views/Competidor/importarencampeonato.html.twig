{% extends '::base.html.twig' %}
{% block stylesheets %}
    <link href="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.css')}}" rel="stylesheet" type="text/css"/>
{% endblock %}
{% block jsQuery %}    
    <script src="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.js')}}" type="text/javascript"></script>
{% endblock %}
{% block style %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':2}) }}
    <style type="text/css">
        #{{form.archivo.vars.id}}{
            width: 145px !important; 
            vertical-align: middle;
        }
        #namefile{
            width: 145px; 
            vertical-align: middle;
        }
        #btn_archivo{
            height: 21px;
            width: 31px;
        }     
        #btn_archivo > span{
            padding-bottom: 0;
            padding-top: 0;
            padding-left: 0;
            padding-right: 0;
        }
        #icon-archivo{
            vertical-align: middle;
        }
        #imagen_archivo{
            height: 20px;
            vertical-align: middle;
            padding-right: 2px;
        }
        #tabs{  /* Oculta el tabs para que se muestre luego de cargar todo el html */
            display: none;
        }        
   </style>
{% endblock %}    
{% block javascripts %}
    <script>        
        var atributos = [];
        var titulos = [];
        var table;
        {% for clave,campo in campos %}
            {% if campo is iterable %}
                {% if campo['constraint']!='primarykey' %}
                var atributo = new Object();
                atributo.nombre="{{campo['nombre']}}";
                atributo.tipo="{{campo['tipo']}}";
                atributo.longitud="{{campo['longitud']}}";
                atributos["{{campo['nombre']}}"]=atributo;
                titulos.push("{{campo['nombre']}}");
                {% endif %}
            {% endif %}
        {% endfor %}
        titulos.push("categoria");
        titulos.push("numero");
        var atributo = new Object();
        atributo.nombre="categoria";
        atributo.tipo="string";
        atributo.longitud="30";
        atributos["categoria"]=atributo;
        var atributo = new Object();
        atributo.nombre="numero";
        atributo.tipo="integer";
        atributo.longitud="3";
        atributos["numero"]=atributo;
        
        var dataSet=[];
        var camposSet=[];
        function processData(allText) {
            var allTextLines = allText.split(/\r\n|\n/);
            var header = allTextLines[0].split(',');            
            
            //Valida que la primera fila del archivo poseea los titulos adecuados
            for(i=0;i<header.length;i++){
                for(j=0;j<titulos.length;j++){
                    if($.inArray(header[i],titulos)==-1){
                        alert("Nombre del titulo " + header[i] + " no es valido, use el archivo con el formato "
                                + " adecuado para importar los datos. Borre el archivo, corrijalo y vuelva a cargarlo.");
                        return false;
                    }
                }
            }
            console.log(header);
            
            //Configura los titulos de la tabla
            for(i=0;i<header.length-1;i++){
                camposSet[i]={ title: header[i] };
            }
            
            //Configura el dataset con que sera llenada la tabla
            var line=[];
            for(nl=1,j=0;nl<allTextLines.length && allTextLines[nl]!="";nl++){
                line[j]=allTextLines[nl].split(',');
                for(col=0;col<header.length;col++){
                    if(line[j][col]!="")
                        switch(atributos[header[col]].tipo){
                            case "string":
                                if(atributos[header[col]].longitud<line[j][col].length){
                                    alert("Error en la columna " + header[col] + ", linea " + (nl+1) +
                                            ". Longitud mayor " + atributos[header[col]].longitud);
                                    return false;
                                }
                                break;
                            case "datetime":
                                if(isNaN(Date.parse(line[j][col]))){
                                    alert("Error en la columna: " + header[col] + ", linea: " + (nl+1) +
                                            ". Formato de fecha incorrecto, formato correcto: aaaa/mm/dd");
                                    return false;
                                }
                                break;
                            case "bigint":
                                if(isNaN(line[j][col])){
                                    alert("Error en la columna: " + header[col] + ", linea: " + (nl+1) +
                                            ". Valor no es numerico");
                                    return false;
                                }
                                break;
                        }
                }
                dataSet.push(line[j++]);
            }
            return true;
        }        
        $().ready(function () {
            $("#tabs").css("display","block");            
            $('#tabs a[href="#tabs-3"]').click();
            $('#tabs a[href="#tabs-1"]').on("click", function () {
                $(location).attr('href', '{{ path('campeonatoclubes_new',{'idcampeonato':idcampeonato}) }}')
            });                    
            $('#tabs a[href="#tabs-2"]').on("click", function () {
                $(location).attr('href', '{{ path('categoria_campeonato_new',{'idcampeonato':idcampeonato}) }}');
            });            
            
            var data=null;
            controlLoadFile($("#{{form.archivo.vars.id}}"),"csv");
            $('#namefile_archivo').on("input propertychange",function(){
                console.log("cambie");
            });
            $('#imagen_archivo').on('load', function () {
                if($('#imagen_archivo').attr('src').endsWith('csv-128.png')){
                    data = "{{asset('bundles/fratersoftpiaweb/fine-uploader/files/')}}" + $("#{{form.archivo.vars.id}}").val();
                    $.ajax({
                        type: "GET",
                        url: data,
                        dataType: "text",
                        success: function(data) {
                            if(processData(data))
                                table = $('#csvcompetidor').DataTable( {
                                    data: dataSet,
                                    columns: camposSet,
                                });            
                        }
                     });
                }
            });                                 
            
            //muestra la ventana para cargar imagenes o archivos
            $("#uploadimage").dialog({
                autoOpen: false,
                modal: true,
                buttons: [
                    {
                        text: "Aceptar",
                        click: function () {
                            $(this).dialog("close");
                        }
                    },
                    {
                        text: "Cerrar",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ]
            });            
        });
    </script>   
{% endblock %}

{% block body -%}
    <div id="tabs">        
        {{ include("FraterSoftPiaWebBundle:Campeonato:tabs.html.twig") }}
        <div id="tabs-3">     
            <h1>Importar Competidores</h1>
            {{ form_start(form,{'attr': {'id': 'formulario'}}) }}
            {{ form_end(form) }}
            Competidores actualizados:{% if actualizados is defined %}{{ actualizados }}{% endif %}<br>
            Competidores nuevos:{% if insertados is defined %}{{ insertados }}{% endif %}<br>
            <table id="csvcompetidor" class="display" cellspacing="0" width="100%">
            </table>
            <div id="uploadimage">    
                <div id="fine-uploader"></div>  
                {{ include("FraterSoftPiaWebBundle:Evento:template-fineuploader.html.twig") }} 
            </div>    
            {{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig",{'idevento':null}) }}    
        </div> 
    </div>         
{% endblock %}
