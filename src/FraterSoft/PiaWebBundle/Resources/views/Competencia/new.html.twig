{% extends '::base.html.twig' %}
{% block style %} 
{{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':0}) }}    
<style type="text/css">
    #tabs{  /* Oculta el tabs para que se muestre luego de cargar todo el html */
        display: none;
    }
    #formulario > div:nth-child(1){
        display: none;
    }
        /****************************************************/
        /*  Configura el estilo del subformulario pago ******/
        /****************************************************/
        #{{form.grupo.vars.id}} > div:nth-child(n+0){
            margin-top: 5px;
        }         
        #{{form.grupo.vars.id}} > div:nth-child(n+0) > label{
            display: inline-block;
            width: 150px;
            text-align: left;   
            vertical-align: middle;
        }
        #{{form.grupo.vars.id}} > div:nth-child(n+0) > input[type="checkbox"]{
            vertical-align: middle;
            margin-left: 0;
        }
        #{{form.grupo.vars.id}} > div:nth-child(n+0) > label[class="error"]{
            width: 20px;
        }
        #{{form.grupo.vars.id}} > div:nth-child(n+0) > input[type="text"],input[type="number"],textarea{
            vertical-align: middle;
            width: 196px;
        }
        #formulario > div:nth-child(5) > label{
            width: 100%;
            font-weight: bold;
        }
</style>
{% endblock %}  
{% set entidad='competencia' %}
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div id="tabs">    
        {{ include("FraterSoftPiaWebBundle:Evento:tabs.html.twig") }}
        <div id="tabs-2">     
            {{ include("FraterSoftPiaWebBundle:Evento:menu_conf_inscripciones.html.twig") }}
            <div id="titulotabla"><h3>{{entidad|title}}s Configuradas</h3></div>
            <table id="{{entidad}}" class="display row-border hover">
            </table>    
        </div> 
        <button class="ui-button ui-widget ui-corner-all" onclick="$(location).attr('href', '{{app.session.get('urllistaeventos')}}');">Regresar</button>
        <div id="dialogformGuardar">
            {{ form_start(form,{'attr': {'id': 'formulario'}}) }}
            {{ form_end(form) }} 
        </div>          
        <div id="dialogelimiar">
            ¿Esta seguro que desea elimar la fila <strong id="eliminar"></strong>?
        </div> 
        <div id="dialog-message" title="Mensaje">
        </div>        
    </div> 
    </div>
{% endblock %}
{% block javascripts -%}
{{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig") }}

<link href="{{asset('bundles/fratersoftpiaweb/css/jquery.datetimepicker.css')}}" rel="stylesheet" type="text/css"/>
<script src="{{asset('bundles/fratersoftpiaweb/js/jquery.datetimepicker.full.js')}}" type="text/javascript"></script>  
<script>
    $(document).ready(function () { 
        var entidad = 'competencia';
        $("#tabs").css("display","block");
        $( "#botonera" ).controlgroup();                          
        tablaDatos(
                $('#formulario'), //Se usa para llenar lo campos del formulario
                {{campos|json_encode|raw}}, //json con los atributos de la entidad y sus caracteristicas
                toTitleCase(entidad), //Usada para el titulo 
                "{{ path(entidad ~ '_create')}}", //Url para crear
                "{{ path(entidad ~ '_update',{'id':'_id_'})}}", //Url para editar
                "{{ path(entidad ~ '_listaajax',{'idevento': idevento }) }}", //Url para buscar los datos a listar
        );
        dialogGuardar($('#formulario'),{{campos|json_encode|raw}});
        dialogEliminar('{{ path(entidad ~ '_delete',{'id':'_id_'})}}');
        dialogMensaje();
        
        menuConfInscripcionesControl('competencias');        
        
        $("#{{form.grupo.integrantes.vars.id}}").blur(function () {
            if($("#{{form.grupo.integrantes.vars.id}}").val()=="")
                $("#{{form.grupo.secuencia.vars.id}}").val("");
            else
                $("#{{form.grupo.secuencia.vars.id}}").val(1);
        });                  
                
        {% if estado is defined %}
            {% if estado == 1 %}
                $("#dialog-message").html("<p><span class='ui-icon ui-icon-circle-check' style='float:left; margin:0 7px 50px 0;'>" +
                        "</span>La {{entidad|title}} fue ELIMINADA satisfacoriamente.</p>").dialog();
                $("#dialog-message").dialog("open");
            {% endif %}    
            {% if estado == 2 %}
                $("#dialog-message").html("<p><span class='ui-icon ui-icon-circle-check' style='float:left; margin:0 7px 50px 0;'>" +
                        "</span>La {{entidad|title}} fue CREADA satisfacoriamente.</p>").dialog();
                $("#dialog-message").dialog("open");
            {% endif %}    
            {% if estado == 3 %}
                $("#dialog-message").html("<p><span class='ui-icon ui-icon-circle-check' style='float:left; margin:0 7px 50px 0;'>" +
                        "</span>La {{entidad|title}} fue ACTUALIZADA satisfacoriamente.</p>").dialog();
                $("#dialog-message").dialog("open");
            {% endif %}    
        {% endif %}        

        $("#{{form.fechacierre.vars.id}}").datetimepicker({
            format: "d/m/Y H:i",
            defaultSelect: true,
            lang: 'es',
        });          
            
    });    
</script>    
{% endblock %}
