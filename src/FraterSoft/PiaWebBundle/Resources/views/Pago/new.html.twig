{% extends '::base.html.twig' %}
{% block stylesheets %}
    <link href="{{asset('bundles/fratersoftpiaweb/css/jquery.datetimepicker.css')}}" rel="stylesheet" type="text/css"/>
{% endblock %}
{% block javascripts %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig",{'idevento':inscripcion.idevento.id}) }}    
    <script>
        $(document).ready(function () {
            var parametros;
            $("#{{form.fechapago.vars.id}}").datetimepicker({
                format: "d/m/Y",
                defaultSelect: true,
                lang: 'es',
                timepicker:false,
            });
            $('#tablaReporte').DataTable({
                dom: "t",
                ordering: false,
                pageLength: 30,
                columns: [
                    { title: "" },
                    { title: "" },
                ],       
                "columnDefs": [ //centra el contenido de la columna
                    {"className": "dt-right", "targets":0},
                    {"className": "dt-left", "targets":1},
                ],  
            });
            $("#tablaReporte").append("<caption><b>PAGO DE PRE-INSCRIPCI&Oacute;N</b></caption>");
            
            ocultaCamposPagoForm($('#formulario'));
            parametros={{fpparametros|json_encode|raw}};
            $("#{{ form.idformapago.vars.id }}").change(function () {
                if(window.sessionStorage.getItem('idfp'+$("#{{ form.idformapago.vars.id }}").val())==null)
                    if(parametros[$("#{{ form.idformapago.vars.id }}").val()])
                        jparametros=jQuery.parseJSON(parametros[$("#{{ form.idformapago.vars.id }}").val()]);
                    else
                        jparametros=[];
                else
                    jparametros=jQuery.parseJSON(window.sessionStorage.getItem('idfp'+$("#{{ form.idformapago.vars.id }}").val()));
                ocultaCamposPagoForm($('#formulario'));
                manejoFormularioPago(
                    $("#{{ form.precio.vars.id }}"),
                    $('#formulario'),
                    jparametros
                ); 
            });
            $("#{{ form.idmoneda.vars.id }}").change(function () {
                ocultaCamposPagoForm($('#formulario'));
                buscarFormasPago(
                    $('#formulario'),
                    {{inscripcion.idevento.id}},
                    $("#formulario input[type='radio']:checked").val()
                );
                buscaPrecio({{inscripcion.idevento.id}},
                    {{inscripcion.idcompetencia.id}},
                    {{inscripcion.idcategoria.id}},
                    $('#formulario'),
                    {{recargas|json_encode|raw}},
                    $("#formulario input[type='radio']:checked").val()
                );
            });   
        });
    </script>           
{% endblock %} 
{% block style %}
    {{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':2}) }}
    <style type="text/css">
        div.container
        {     
            width: 400px;
            margin: auto;
            text-align: center;
        }    
        #formulario > div:nth-child(n+0) > label{
            display: inline-block;
            width: 180px;
            text-align: left;   
            vertical-align: middle;
        }        
        #fratersoft_piawebbundle_pago_idmoneda{
            width: 200px;
            float: right;        
        }
    </style>
{% endblock %} 

{% block body -%}
    <div class="container">
        <table id="tablaReporte" class="display compact">
            <tbody>          
                {% if inscripcion.idcompetencia is not null %}
                <tr><th>Competencia</th><td>{{ inscripcion.idcompetencia.descripcion }}</td></tr>
                {% endif %}
                <tr><th>Nombre</th><td>{{ inscripcion.idpia.nombre|upper }}</td></tr>
                <tr><th>Apellido</th><td>{{ inscripcion.idpia.apellido|upper }}</td></tr>
                {% if inscripcion.idcategoria is not null %}
                <tr><th>Categoria</th><td>{{ inscripcion.idcategoria.descripcion }}</td></tr>
                {% endif %}
                {% if inscripcion.competencias is not empty and inscripcion.competencias|length > 1 %}
                {% for ic in inscripcion.competencias %}
                <tr><th>{{ ic.idcompetencia.descripcion }}</th><td>{% if ic.idcategoria %}{{ ic.idcategoria.descripcion }}{% endif %}</td></tr>
                {% endfor %}
                {% endif %}
            </tbody>
        </table>
        {{ form_start(form,{'attr': {'id': 'formulario'}}) }}
        {{ form_end(form) }} 
    </div>
{% endblock %}
{% block jsQuery %}    
    <script src="{{asset('bundles/fratersoftpiaweb/js/jquery.datetimepicker.full.js')}}" type="text/javascript"></script>    
{% endblock %}  
