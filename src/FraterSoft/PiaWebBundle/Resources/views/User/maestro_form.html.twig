{% extends '::base.html.twig' %}
{% block style %}
<style type="text/css">
    .maestro-form-wrap { max-width: 720px; margin: 30px auto; padding: 30px; border: 1px solid #ccc; border-radius: 6px; box-shadow: 2px 2px 8px rgba(0,0,0,0.1); }
    .maestro-form-wrap h2 { margin: 0 0 20px; }
    .fp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .fp-grid .full-width { grid-column: 1 / -1; }
    .fp-grid label { display: block; margin-bottom: 4px; font-weight: bold; font-size: 13px; }
    .fp-grid input[type="text"], .fp-grid input[type="email"], .fp-grid input[type="password"], .fp-grid select {
        width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 13px;
    }
    .fp-check { display: flex; align-items: center; gap: 8px; }
    .fp-check label { margin: 0; }
    .fp-roles div { margin-bottom: 4px; }
    .fp-roles label { display: inline; font-weight: normal; margin-left: 4px; }
    .submit-btn { text-align: center; margin-top: 25px; }
    .submit-btn input, .submit-btn button {
        padding: 10px 40px; background: #337ab7; color: #fff; border: none;
        border-radius: 4px; cursor: pointer; font-size: 14px;
    }
    .maestro-form-acciones { margin-top: 20px; text-align: center; }
    .maestro-form-acciones a { display: inline-block; padding: 8px 20px; border: 1px solid #ccc; border-radius: 4px; text-decoration: none; color: #333; background: #f7f7f7; font-size: 13px; }
    .maestro-flash { padding: 8px 12px; border-radius: 4px; margin: 8px 0; font-size: 13px; }
    .maestro-flash.error { background: #fdecea; border: 1px solid #f5c6cb; color: #c0392b; }
    .maestro-flash.success { background: #e8f5e9; border: 1px solid #a5d6a7; color: #2e7d32; }
    .fp-grid small { display: block; margin-top: 4px; color: #666; }
    @media screen and (max-width: 600px) { .maestro-form-wrap { margin: 15px auto; padding: 15px; } .fp-grid { grid-template-columns: 1fr; } }
</style>
{% endblock %}
{% block body -%}
    <div class="pia-wrapper">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
        <div class="maestro-form-wrap">
            <h2>{{ titulo }}</h2>

            {% for tipo, mensajes in app.session.flashbag.all %}
                {% for mensaje in mensajes %}
                    <div class="maestro-flash {{ tipo }}">{{ mensaje }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {'attr': {'id': 'formulario'}}) }}
                <div class="fp-grid">
                    <div>
                        <label>{{ form_label(form.username) }}</label>
                        {{ form_widget(form.username) }}
                        {{ form_errors(form.username) }}
                    </div>
                    <div>
                        <label>{{ form_label(form.email) }}</label>
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div>
                        <label>{{ form_label(form.plainPassword) }}</label>
                        {{ form_widget(form.plainPassword) }}
                        {{ form_errors(form.plainPassword) }}
                        <small>{{ entity.id ? 'Dejar en blanco para no cambiar la contraseña actual.' : 'Obligatoria para el nuevo usuario.' }}</small>
                    </div>
                    <div>
                        <label>{{ form_label(form.idorganizador) }}</label>
                        {{ form_widget(form.idorganizador) }}
                        {{ form_errors(form.idorganizador) }}
                    </div>
                    <div class="full-width fp-check">
                        {{ form_widget(form.enabled) }}
                        <label>{{ form_label(form.enabled) }}</label>
                        {{ form_errors(form.enabled) }}
                    </div>
                    <div class="full-width fp-roles">
                        <label>{{ form_label(form.roles) }}</label>
                        {% for rol in form.roles %}
                        <div>
                            {{ form_widget(rol) }}
                            {{ form_label(rol) }}
                        </div>
                        {% endfor %}
                        {{ form_errors(form.roles) }}
                    </div>
                </div>

                {{ form_rest(form) }}

                <div class="submit-btn">
                    {{ form_widget(form.submit) }}
                </div>
            {{ form_end(form) }}

            <div class="maestro-form-acciones">
                <a href="{{ path('maestro_user') }}">Volver al listado</a>
            </div>
        </div>
    </div>
{% endblock %}
