{% extends '::base.html.twig' %}
{% block javascripts %}
    <script>
        $(document).ready(function () {
            //Configura la tabla de datos
            $('#listaEnProceso').DataTable({
                "dom": 'Bflit<"bottom"Blp>',                
                buttons: [                       
                    {text: 'Nuevo',
                        action : function(e) {
                            alert("Crear evento");
                        }
                    },                 
                ],
                "language": {
                    "emptyTable": "No hay datos para mostrar",
                    "lengthMenu": "Muestra _MENU_ registros",
                    "info": "Mostrando _START_ de _END_ de _TOTAL_ registros",
                    "search": "Buscar:",
                    "infoFiltered":   "(filtradas de _MAX_ registros)",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    },
                },
                order: [
                    [3,"ASC"],[5,"DES"]
                ]
            });
            $('#listaEjecutados').DataTable({
                "dom": 'Bflit<"bottom"Blp>',                  
                buttons: [                       
                    {text: 'Nuevo',
                        action : function(e) {
                            alert("Crear evento");
                        }
                    },                 
                ],
                "language": {
                    "emptyTable": "No hay datos para mostrar",
                    "lengthMenu": "Muestra _MENU_ registros",
                    "info": "Mostrando _START_ de _END_ de _TOTAL_ registros",
                    "search": "Buscar:",
                    "infoFiltered":   "(filtradas de _MAX_ registros)",
                    "paginate": {
                        "first": "Primero",
                        "last": "Ultimo",
                        "next": "Siguiente",
                        "previous": "Anterior"
                    },
                },
                order: [
                    [3,"ASC"],[5,"DES"]
                ]
            });

    });
    </script>   
{% endblock %}    
{% block style %}
<style type="text/css">
    td,th{
        font-size: 10px;
    }
    .ui-icon {
        -ms-transform: scale(0.7); /* IE 9 */
        -webkit-transform: scale(0.7); /* Chrome, Safari, Opera */
        transform: scale(0.7);
    }        
    table.dataTable tbody th, table.dataTable tbody td{
        padding: 0;
    } 
    .dataTables_length,.dataTables_filter{
        margin-top: 3px;
    }
    select{
        width: 50px;
    }
</style>
{% endblock %} 
{% block body -%}
    <div class="pia-wrapper">
    {{ include('FraterSoftPiaWebBundle:Default:_header.html.twig') }}
    <h1>Eventos de {{ organizador_nombre }}</h1>
    <div id="tabs">
      <ul>
        <li><a href="#tabs-1">En Proceso</a></li>
        <li><a href="#tabs-2">Ejecutados</a></li>
      </ul>
        <div id="tabs-1">
            <table id="listaEnProceso" class="display row-border hover compact">
                <thead>
                    <tr>
                        <th>Logo</th>
                        <th>Nombre</th>
                        <th>Realizacion</th>
                        <th>Cierre</th>
                        <th>Cupos Maximos</th>
                        <th>PreInscritos</th>
                        <th>Inscritos</th>
                        <th>TDC Sin Pago</th>
                        <th>Cupos Asignados</th>
                        <th>Disponibles</th>                        
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for entity in entities %}
                    <tr>
                        <td>
                            {% if entity.logo is null %}
                            <img width="32" src="{{ asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}">
                            {% else %}
                            <img width="32" src="{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ entity.logo}}">
                            {% endif %}
                        </td>
                        <td>{{ entity.nombre }}</td>
                        <td>{% if entity.fecha %}{{ entity.fecha|date('Y-m-d H:i:s') }}{% endif %}</td>
                        <td>{% if entity.fechacierre %}{{ entity.fechacierre|date('Y-m-d H:i:s') }}{% endif %}</td>
                        <td>{{ entity.cupomaximo }}</td>
                        <td>{{ entity.preinscritos }}</td>
                        <td>{{ entity.inscritos }}</td>
                        <td>{{ entity.tdcsinpago }}</td>
                        <td>{{ entity.preinscritos + entity.inscritos + entity.tdcsinpago }}</td>
                        {% if entity.cupomaximo is null or entity.cupomaximo == 0 %}
                        <td></td>
                        {% else %}
                        <td>{{ entity.cupomaximo - (entity.preinscritos + entity.inscritos + entity.tdcsinpago) }}</td>
                        {% endif %}                        
                        <td>
                            {% if entity.activo == 1%}
                                {% if email=='admin'%}
                                    <span class="ui-icon ui-icon-play" title="Estus: Activo. Pulse para Detener"></span>
                                {% else %}
                                    <span class="ui-icon ui-icon-play" title="Estus: Activo. Pulse para Detener"></span>
                                {% endif %}
                            {% else %}
                                {% if email=='admin'%}                                
                                    <span class="ui-icon ui-icon-stop" title="Estus: Detenido. Pulse para Activar"></span>
                                {% else %}
                                    <span class="ui-icon ui-icon-stop" title="Estus: Detenido. Pulse para Activar"></span>
                                {% endif %}                                    
                            {% endif %}           
                        </td>
                        <td>
                        <ul id="icons" class="ui-widget ui-helper-clearfix">                 
                            <li class="ui-state-default ui-corner-all" title="Ver">
                                <a href="{{ path('evento_show', { 'id': entity.id }) }}"><span class="ui-icon ui-icon-search"></span></a>
                            </li>
                            <li class="ui-state-default ui-corner-all {% if nivel_seguridad != 1 %} ui-state-disabled {% endif %}" title="{{ nivel_seguridad }}" >
                                {% if nivel_seguridad == 1%}
                                <a href="{{ path('evento_edit', { 'id': entity.id }) }}"><span class="ui-icon ui-icon-pencil"></span></a>
                                {% else %}
                                <span class="ui-icon ui-icon-pencil "></span>
                                {% endif %}
                            </li>
                            <li class="ui-state-default ui-corner-all" title="Panel">
                                <a href="{{ path('inscrito_lista_preinscritos', { 'idevento': entity.id }) }}"><span class="ui-icon ui-icon-gear"></span></a>
                            </li>
                        </ul>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div id="tabs-2">
          <table id="listaEjecutados" class="display row-border hover compact">
                <thead>
                    <tr>
                        <th>Logo</th>
                        <th>Nombre</th>
                        <th>Realizacion</th>
                        <th>Cierre</th>
                        <th>Cupos</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for entity in ejecutados %}
                    <tr>
                        <td>
                            {% if entity.logo is null %}
                            <img width="32" src="{{ asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}">
                            {% else %}
                            <img width="32" src="{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ entity.logo}}">
                            {% endif %}
                        </td>
                        <td>{{ entity.nombre }}</td>
                        <td>{% if entity.fecha %}{{ entity.fecha|date('Y-m-d H:i:s') }}{% endif %}</td>
                        <td>{% if entity.fechacierre %}{{ entity.fechacierre|date('Y-m-d H:i:s') }}{% endif %}</td>
                        <td>{{ entity.cupomaximo }}</td>
                        <td>
                            {% if entity.activo == 1%}
                                {% if email=='admin'%}
                                    <span class="ui-icon ui-icon-play" title="Estus: Activo. Pulse para Detener"></span>
                                {% else %}
                                    <span class="ui-icon ui-icon-play" title="Estus: Activo. Pulse para Detener"></span>
                                {% endif %}
                            {% else %}
                                {% if email=='admin'%}                                
                                    <span class="ui-icon ui-icon-stop" title="Estus: Detenido. Pulse para Activar"></span>
                                {% else %}
                                    <span class="ui-icon ui-icon-stop" title="Estus: Detenido. Pulse para Activar"></span>
                                {% endif %}                                    
                            {% endif %}           
                        </td>
                        <td>
                        <ul id="icons" class="ui-widget ui-helper-clearfix">                 
                            <li class="ui-state-default ui-corner-all" title="Ver">
                                <a href="{{ path('evento_show', { 'id': entity.id }) }}"><span class="ui-icon ui-icon-search"></span></a>
                            </li>
                            <li class="ui-state-default ui-corner-all" title="Editar">
                                <a href="{{ path('evento_edit', { 'id': entity.id }) }}"><span class="ui-icon ui-icon-pencil"></span></a>
                            </li>
                            <li class="ui-state-default ui-corner-all" title="Panel">
                                <a href="{{ path('inscrito_lista_preinscritos', { 'idevento': entity.id,'email':email}) }}"><span class="ui-icon ui-icon-gear"></span></a>
                            </li>
                        </ul>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>                
    </div>    
    </div>

    {% endblock %}


