{% extends '::base.html.twig' %}

{% block body -%}
<style>
    .evento-show {
        max-width: 900px;
        margin: 40px auto;
        padding: 30px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-shadow: 2px 2px 8px rgba(0,0,0,0.1);
    }
    .evento-show h2 {
        margin-top: 0;
        margin-bottom: 20px;
    }
    .evento-show .logo-section {
        text-align: center;
        margin-bottom: 20px;
    }
    .evento-show .logo-section img {
        max-width: 200px;
        max-height: 200px;
        border-radius: 10%;
        border: 2px solid #ddd;
    }
    .evento-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 25px;
    }
    .evento-grid .full-width {
        grid-column: 1 / -1;
    }
    .evento-grid label {
        display: block;
        font-weight: bold;
        font-size: 12px;
        color: #666;
        margin-bottom: 2px;
    }
    .evento-grid .valor {
        font-size: 14px;
    }
    .submit-btn {
        text-align: center;
        margin-top: 25px;
    }
    .submit-btn a button {
        padding: 10px 40px;
        background: #337ab7;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }
    /* Telefonos: los datos pasan a una sola columna */
    @media screen and (max-width: 600px) {
        .evento-show {
            margin: 15px auto;
            padding: 15px;
        }
        .evento-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }
        .submit-btn a button {
            width: 100%;
            padding: 12px 0;
        }
    }
</style>

<div class="pia-wrapper">
{{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
<div class="evento-show">
    <h2>{{ entity.nombre }}</h2>

    {% if entity.logo %}
    <div class="logo-section">
        <img src="{{ asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ entity.logo }}" alt="Logo">
    </div>
    {% endif %}

    <div class="evento-grid">
        <div>
            <label>Fecha</label>
            <div class="valor">{% if entity.fecha %}{{ entity.fecha|date('d/m/Y') }}{% endif %}</div>
        </div>
        <div>
            <label>Hora</label>
            <div class="valor">{% if entity.hora %}{{ entity.hora|date('H:i') }}{% endif %}</div>
        </div>
        <div>
            <label>Lugar</label>
            <div class="valor">{{ entity.lugar }}</div>
        </div>
        <div>
            <label>Organizador</label>
            <div class="valor">{{ entity.organizador }}</div>
        </div>
        <div>
            <label>Nombre de Contacto</label>
            <div class="valor">{{ entity.nombrecontacto }}</div>
        </div>
        <div>
            <label>Teléfono de Contacto</label>
            <div class="valor">{{ entity.telefonocontacto }}</div>
        </div>
        <div>
            <label>Email de Contacto</label>
            <div class="valor">{{ entity.emailcontacto }}</div>
        </div>
        <div>
            <label>Punto de Inscripción</label>
            <div class="valor">{{ entity.puntoinscripcion }}</div>
        </div>
        <div>
            <label>Fecha de Cierre</label>
            <div class="valor">{% if entity.fechacierre %}{{ entity.fechacierre|date('d/m/Y H:i') }}{% endif %}</div>
        </div>
        <div>
            <label>Fecha de Cierre Efectivo</label>
            <div class="valor">{% if entity.fechacierreefectivo %}{{ entity.fechacierreefectivo|date('d/m/Y H:i') }}{% endif %}</div>
        </div>
        <div>
            <label>Hora de Cierre</label>
            <div class="valor">{% if entity.horacierre %}{{ entity.horacierre|date('H:i') }}{% endif %}</div>
        </div>
        <div>
            <label>Equipo</label>
            <div class="valor">{{ entity.equipo }}</div>
        </div>
        <div>
            <label>Rifa</label>
            <div class="valor">{{ entity.rifa ? 'Sí' : 'No' }}</div>
        </div>
        <div>
            <label>Tipo</label>
            <div class="valor">{{ entity.tipo }}</div>
        </div>
        <div>
            <label>Control de Cupo</label>
            <div class="valor">{{ entity.cupocontrol ? 'Sí' : 'No' }}</div>
        </div>
        <div>
            <label>Cupo Máximo</label>
            <div class="valor">{{ entity.cupomaximo }}</div>
        </div>
        <div>
            <label>Activo</label>
            <div class="valor">{{ entity.activo ? 'Sí' : 'No' }}</div>
        </div>
        <div>
            <label>Criterio de Cálculo de Edad</label>
            <div class="valor">{{ entity.criteriocalculoedad }}</div>
        </div>
        <div>
            <label>Control de Menores de 16</label>
            <div class="valor">{{ entity.controlamenores16 ? 'Sí' : 'No' }}</div>
        </div>
    </div>

    <div class="submit-btn">
        <a href="{{ path('frater_soft_pia_web_eventos') }}"><button>Volver</button></a>
    </div>
</div>
</div>
{% endblock %}
