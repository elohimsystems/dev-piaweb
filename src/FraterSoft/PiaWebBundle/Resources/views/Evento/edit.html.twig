{% extends '::base.html.twig' %}
{% block stylesheets %}
    <link href="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.css')}}" rel="stylesheet" type="text/css"/>
    <link href="{{asset('bundles/fratersoftpiaweb/css/jquery.datetimepicker.css')}}" rel="stylesheet" type="text/css"/>
{% endblock %}
{% block jsQuery %}    
    <script src="{{asset('bundles/fratersoftpiaweb/fine-uploader/fine-uploader.min.js')}}" type="text/javascript"></script>
    <script src="{{asset('bundles/fratersoftpiaweb/js/jquery.datetimepicker.full.js')}}" type="text/javascript"></script>    
    {# Google Maps deshabilitado por seguridad #}
{% endblock %}  
{% block style %}    
    {{ include("FraterSoftPiaWebBundle:Default:FS-CSS-Library.html.twig",{'numero_botones':2}) }}
    <style>
        #tabs{
            display: none;
        }        
        .contenido{    
            margin: auto;
            width: 750px;
        }
        #imagenesbotones{
            float: left;    
            margin-right: 5px;            
        }
        #fine-uploader{
            float: left;    
            margin-right: 5px;
        }
        #contenedor-form{
            float: left;
        }
        .qq-uploader {
            width: inherit;
            border-radius: 3px;
            background-color: #a1aec7;
            border: 1px dashed #CCCCCC;
            padding: 5px;
            //height: 295px;
        }
        .qq-file-info{
            color: black;
        }
        #block-form {
            float: left;
        }    
        .qq-upload-list li.qq-upload-success {
            background-color: #FFFFFF;
        }        
        /* Always set the map height explicitly to define the size of the div
         * element that contains the map. */
        #map {
          height: 100%;
        }
        
        .controls {
          margin-top: 10px;
          border: 1px solid transparent;
          border-radius: 2px 0 0 2px;
          box-sizing: border-box;
          -moz-box-sizing: border-box;
          height: 32px;
          outline: none;
          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
        }        
        
        #pac-input {
          background-color: #fff;
          font-family: Roboto;
          font-size: 15px;
          font-weight: 300;
          margin-left: 12px;
          padding: 0 11px 0 13px;
          text-overflow: ellipsis;
          width: 300px;
        }

        #pac-input:focus {
          border-color: #4d90fe;
        }        

        /* Optional: Makes the sample page fill the window. */
        html, body {
          height: 100%;
          margin: 0;
          padding: 0;
        }             
        #btn_checkemail{
            height: 21px;
            width: 31px;
        }     
        #btn_checkemail> span{
            padding-bottom: 0;
            padding-top: 0;
            padding-left: 0;
            padding-right: 0;
        }
        #icon-checkemail{
            vertical-align: middle;
        }
        #boton_logo{
            width: 200px;
        }
        #imagen_rutaperfil,#imagen_rutamapa,#imagen_rutavideo{
            width: 28px;
            vertical-align: middle;
            border-radius: 10%;
        }
        #imagen_logo{
            width: 200px;
            border-radius: 10%;
        }
        #boton_rutamapa,#boton_rutaperfil,#boton_rutavideo,#boton_codigo{
            width: 165px;
        }
        #seccion_rutamapa,#seccion_rutaperfil,#seccion_rutavideo,#seccion_codigo{
            padding-top: 3px;
        }
        #reproductor{
            height: 315px;
            border: 1px solid;
        }
    </style>
{% endblock %}

{% block body -%}
    <div style="max-width:1200px; margin:auto">
        {{ include("FraterSoftPiaWebBundle:Default:_header.html.twig") }}
    <div id="tabs">        
        {{ include("FraterSoftPiaWebBundle:Evento:tabs.html.twig") }}
        <div id="tabs-1">
            <div class="contenido">
                <div id="imagenesbotones">
                    <div id="seccion_logo">
                        {% if edit_form.logo.vars.data is empty %}
                            <div><img id="imagen_logo" src="{{asset('bundles/fratersoftpiaweb/images/sinimagen.png') }}"></div>
                        {%else%}    
                            <div><img id="imagen_logo" src="{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ edit_form.logo.vars.data}}"></div>
                        {%endif%}
                        <div><button type="button" id="boton_logo">Logo</button></div>
                    </div>
                    <div id="seccion_rutamapa">
                        <button type="button" id="boton_rutamapa">Mapa de Ruta</button>
                        {% if edit_form.rutamapa.vars.data is empty %}
                            <img id="imagen_rutamapa" src="{{asset('bundles/fratersoftpiaweb/images/sinimagen.png') }}">
                        {%else%}    
                            <img id="imagen_rutamapa" src="{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ edit_form.rutamapa.vars.data}}">
                        {%endif%}
                    </div>
                    <div id="seccion_rutaperfil">
                        <button type="button" id="boton_rutaperfil">Perfil de Ruta</button>
                        {% if edit_form.rutaperfil.vars.data is empty %}
                            <img id="imagen_rutaperfil" src="{{asset('bundles/fratersoftpiaweb/images/sinimagen.png') }}">
                        {%else%}    
                            <img id="imagen_rutaperfil" src="{{asset('bundles/fratersoftpiaweb/fine-uploader/files/') ~ edit_form.rutaperfil.vars.data}}">
                        {%endif%}
                    </div>
                    <div id="seccion_rutavideo">
                        <button type="button" id="boton_rutavideo">Video de Ruta</button>
                        {% if edit_form.rutavideo.vars.data is empty %}
                            <img id="imagen_rutavideo" src="{{asset('bundles/fratersoftpiaweb/images/sinimagen.png') }}">
                        {%else%}    
                            <img id="imagen_rutavideo" src="{{asset('bundles/fratersoftpiaweb/images/youtube.png') }}">
                        {%endif%}
                    </div>
                    <div id="seccion_codigo">
                        <button type="button" id="boton_codigo">Codigo</button>
                    </div>
                </div>
                <div id="contenedor-form">
                {{ form_start(edit_form) }}
                {{ form_end(edit_form) }} 
                </div>
            </div> 
            <div id="dialog_checkemail">    
                Ingrese el codigo de confirmacion enviado al correo<br>
                <input id="codigo" type="text" placeholder="Ingrese codigo">
            </div>
            <div id="uploadimage">    
                <div id="fine-uploader"></div>  
                {{ include("FraterSoftPiaWebBundle:Evento:template-fineuploader.html.twig") }} 
            </div>
            <div id="uploadvideo">
                <b>Pegue el codigo de youtube, y presione Insertar</b>
                <textarea id="codigoyoutube" rows="4" cols="89"></textarea>
                <button id="boton_insertar">Insertar</button>
                <button id="boton_borrar">Borrar</button>
                <div id="reproductor"></div>
            </div>  
            <div id="codigoweb">
                <b>Copie el siguiente codigo y peguelo en su pagina web</b>
                <textarea id="textcodigoweb" rows="4" cols="67" readonly></textarea>
            </div>  
            <div id="dialog_controlparental" title="Control Parental"></div>
            
        </div>
    </div>
    </div>
{% endblock %}
{% block javascripts %}
{{ include("FraterSoftPiaWebBundle:Default:FS-JS-Library.html.twig",{'idevento':entity.id}) }}
<script>
    function deshabilitaRetroceso(){
        window.location.hash="no-back-button";
        window.location.hash="Again-No-back-button" //chrome
        window.onhashchange=function(){window.location.hash="no-back-button";}
    }     
    
    {# Google Maps deshabilitado #}
    
    $(function() {              
        //Carga los tabs en lo que se haya cargado todo el html
        $("#tabs").css("display","grid");            

        $("#boton_codigo").on('click', function() {
            $("#textcodigoweb").val("<iframe align='middle' frameborder='0' height='850' scrolling='no' src='{{ app.request.getSchemeAndHttpHost() }}{{ app.request.getBaseURL() }}/competidor/findform/{{entity.id}}' width='100%'></iframe>");
            $("#codigoweb").dialog("open");
        });            

        
        if($("#{{edit_form.tipo.vars.id}}").val()=='U')
            $("#{{edit_form.idcampeonato.vars.id}}").prop("disabled", true);
            
        $("#{{ edit_form.tipo.vars.id }}").change(function () {
            if($("#{{edit_form.tipo.vars.id}}").val()=='U'){
                $("#{{edit_form.idcampeonato.vars.id}} option").attr("selected", false);
                $("#{{edit_form.idcampeonato.vars.id}}").prop("disabled", true);
            }
            else
                $("#{{edit_form.idcampeonato.vars.id}}").prop("disabled", false);
        });                  

        if($("#{{edit_form.cupocontrol.vars.id}}").prop('checked')==true)
            $("#{{edit_form.cupomaximo.vars.id}}").prop("disabled", false);
        else
            $("#{{edit_form.cupomaximo.vars.id}}").prop("disabled", true);                

        $("#{{ edit_form.cupocontrol.vars.id }}").change(function () {
            if($("#{{edit_form.cupocontrol.vars.id}}").prop('checked')==true)
                $("#{{edit_form.cupomaximo.vars.id}}").prop("disabled", false);
            else
                $("#{{edit_form.cupomaximo.vars.id}}").prop("disabled", true);
        });                  

        
        $("#{{edit_form.emailcontacto.vars.id}}").parent().append(
            "<button type='button' id='btn_checkemail'></button>"
        );           
        $('#btn_checkemail').append("<img id='icon-checkemail' src='{{asset('bundles/fratersoftpiaweb/images/comprobado.png')}}'/>").button();

        $("#btn_checkemail").on('click', function() {
            deshabilitaRetroceso();
            $("#dialog_checkemail").dialog("open");
        });            
        

        $("#boton_logo").on('click', function() {
            cargar_imagen($("#{{ edit_form.logo.vars.id }}"),$("#imagen_logo"),500,300);
        });

        $("#boton_rutamapa").on('click', function() {
            cargar_imagen($("#{{ edit_form.rutamapa.vars.id }}"),$("#imagen_rutamapa"),800,500);
        });

        $("#boton_rutaperfil").on('click', function() {
            cargar_imagen($("#{{ edit_form.rutaperfil.vars.id }}"),$("#imagen_rutaperfil"),800,500);
        });
        
        $("#{{edit_form.fecha.vars.id}}").datetimepicker({
            format: "d/m/Y H:i",
            defaultSelect: true,
            lang: 'es',
        });
        $("#{{edit_form.fechacierre.vars.id}}").datetimepicker({
            format: "d/m/Y H:i",
            defaultSelect: true,
            lang: 'es',
        });           
        $("#{{edit_form.fechainicio.vars.id}}").datetimepicker({
            format: "d/m/Y H:i",
            defaultSelect: true,
            lang: 'es',
        });   
        
        {% if edit_form.logo.vars.data is not empty %}
            {% set logoyruta = edit_form.logo.vars.data|split('/') %}            
            var uuid = "{{ logoyruta[0] }}";
            var file = "{{ logoyruta[1] }}";
        {% else %}
            var uuid = null;
            var file = null;
        {% endif %}
        
    

        $("#dialog_checkemail").dialog({
            autoOpen: false,
            width: 400,
            height: 300,
            modal: true,
            buttons: [
                {
                    text: "Aceptar",
                    click: function () {
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Cerrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });            
        
        $("#uploadimage").dialog({
            autoOpen: false,
            modal: true,
            buttons: [
                {
                    text: "Aceptar",
                    click: function () {
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Cerrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });
        
        $("#boton_insertar").on('click', function() {
            $("#reproductor").html($("#codigoyoutube").val());
            $("#imagen_rutavideo").attr("src","{{asset('bundles/fratersoftpiaweb/images/youtube.png')}}");
        });

        $("#boton_borrar").on('click', function() {
            $("#codigoyoutube").val('');
            $("#reproductor").html('');
            $("#imagen_rutavideo").attr("src","{{asset('bundles/fratersoftpiaweb/images/sinimagen.png')}}");
        });            
        
        $("#boton_rutavideo").on('click', function() {
            {% if edit_form.rutavideo.vars.data is not empty %}
                $("#codigoyoutube").val('{{edit_form.rutavideo.vars.data|raw}}');
                $("#reproductor").html($("#codigoyoutube").val());
            {% endif %}
            $("#uploadvideo").dialog("open");
        });            
        
        $("#uploadvideo").dialog({
            autoOpen: false,
            width: 585,
            modal: true,
            buttons: [
                {
                    text: "Aceptar",
                    click: function () {
                        $("#{{edit_form.rutavideo.vars.id}}").val($("#codigoyoutube").val());
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Cerrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });           
        
        $("#codigoweb").dialog({
            autoOpen: false,
            width: 585,
            modal: true,
            buttons: [
                {
                    text: "Copiar",
                    click: function () {
                        var copyText = document.getElementById("textcodigoweb");
                        copyText.select();
                        document.execCommand("copy");
                        alert("Vaya a su pagina web y pegue el codigo con CONTROL + V");
                        $(this).dialog("close");
                    }
                },
                {
                    text: "Cerrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });            

        //Control Parental button y dialog
        $("#{{edit_form.controlparental.vars.id}}").parent().append(
            "<button type='button' id='btn_controlparental'>Configurar</button>"
        );
        $('#btn_controlparental').button();
        function actualizarBtnControlParental() {
            var activo = $("#{{edit_form.controlparental.vars.id}}").prop('checked')
                && !$("#{{edit_form.externo.vars.id}}").prop('checked');
            $("#btn_controlparental").button("option", "disabled", !activo);
        }
        actualizarBtnControlParental();
        $("#{{edit_form.controlparental.vars.id}}").change(actualizarBtnControlParental);
        $("#btn_controlparental").on('click', function() {
            var url = "{{ path('controlparental_configurar', {'idevento': entity.id}) }}";
            $("#dialog_controlparental").html("<p>Cargando...</p>").dialog("open");
            $.get(url, function(data) {
                $("#dialog_controlparental").html(data);
            }).fail(function(jqXHR, textStatus, errorThrown) {
                $("#dialog_controlparental").html("<p>Error: " + textStatus + " - " + errorThrown + "<br>" + jqXHR.responseText + "</p>");
            });
        });
        $("#dialog_controlparental").dialog({
            autoOpen: false,
            width: 550,
            height: 520,
            modal: true,
            buttons: [
                {
                    text: "Guardar",
                    click: function () {
                        var $form = $("#form_controlparental");
                        var formData = new FormData($form[0]);
                        $.ajax({
                            url: $form.attr('action'),
                            type: 'POST',
                            data: formData,
                            processData: false,
                            contentType: false,
                            dataType: 'json',
                            success: function(response) {
                                if(response.success) {
                                    $("#dialog_controlparental").dialog("close");
                                    alert("Control Parental guardado exitosamente");
                                } else {
                                    alert("Error al guardar. Verifique los datos.");
                                }
                            },
                            error: function(jqXHR, textStatus, errorThrown) {
                                console.log('=== Error AJAX Control Parental ===');
                                console.log('textStatus:', textStatus);
                                console.log('errorThrown:', errorThrown);
                                console.log('responseText:', jqXHR.responseText);
                                console.log('status:', jqXHR.status);
                            }
                        });
                    }
                },
                {
                    text: "Cerrar",
                    click: function () {
                        $(this).dialog("close");
                    }
                }
            ]
        });            

        //Oculta los campos que no se usaran si el eventos es externo
        condicionaCampos();
        $("#{{ edit_form.externo.vars.id }}").change(function () {
            condicionaCampos();
        });             
        function setCampos(valor){
            $("#{{edit_form.lugar.vars.id}}").prop('disabled',valor);
            setVisual($("#{{edit_form.lugar.vars.id}}"),valor);
            $("#{{edit_form.proceso.vars.id}}").prop('disabled',valor);
            setVisual($("#{{edit_form.proceso.vars.id}}"),valor);
            $("#{{edit_form.fechainicio.vars.id}}").prop('disabled',valor);                    
            setVisual($("#{{edit_form.fechainicio.vars.id}}"),valor);
            $("#{{edit_form.fechacierre.vars.id}}").prop('disabled',valor);                    
            setVisual($("#{{edit_form.fechacierre.vars.id}}"),valor);
            $("#{{edit_form.tipo.vars.id}}").prop('disabled',valor);
            setVisual($("#{{edit_form.tipo.vars.id}}"),valor);
            if($("#{{edit_form.tipo.vars.id}}").val()=='C')
                $("#{{edit_form.idcampeonato.vars.id}}").prop("disabled", valor);
            setVisual($("#{{edit_form.idcampeonato.vars.id}}"),valor);
            $("#{{edit_form.cupocontrol.vars.id}}").prop('disabled',valor);                    
            setVisual($("#{{edit_form.cupocontrol.vars.id}}"),valor);
            if($("#{{edit_form.cupocontrol.vars.id}}").prop('checked')==true)
                $("#{{edit_form.cupomaximo.vars.id}}").prop("disabled", valor);
            setVisual($("#{{edit_form.cupomaximo.vars.id}}"),valor);
            $("#{{edit_form.criteriocalculoedad.vars.id}}").prop('disabled',valor);                    
            setVisual($("#{{edit_form.criteriocalculoedad.vars.id}}"),valor);
            $("#{{edit_form.zonahoraria.vars.id}}").prop('disabled',valor);                    
            setVisual($("#{{edit_form.zonahoraria.vars.id}}"),valor);
            $("#{{edit_form.idorganizador.vars.id}}").prop('disabled',valor);                                    
            setVisual($("#{{edit_form.idorganizador.vars.id}}"),valor);
            $("#{{edit_form.controlparental.vars.id}}").prop('disabled',valor);
            setVisual($("#{{edit_form.controlparental.vars.id}}"),valor);
            $("#boton_rutamapa").button({disabled: valor});
            $("#boton_rutaperfil").button({disabled: valor});
            $("#boton_rutavideo").button({disabled: valor});
            $("#boton_codigo").button({disabled: valor});
        }
        function setVisual(element,valor){
            if(valor==true){
                $("#formulario > div:nth-child(" + (element.parent().index()+1) + ")").hide();
            }
            else{
                $("#formulario > div:nth-child(" + (element.parent().index()+1) + ")").show();
            }
        }
        function condicionaCampos(){
            if($("#{{edit_form.externo.vars.id}}").prop('checked')==true){
                setCampos(true);
                $( "#tabs" ).tabs({disabled: [1,2,3]});
            }
            else{
                setCampos(false);
                $( "#tabs" ).tabs("enable");
            }
            if(typeof actualizarBtnControlParental === 'function')
                actualizarBtnControlParental();
        }
        $('#tabs a[href="#tabs-2"]').on("click", function () {
            $(location).attr('href', '{{ path('eventoatributos_new',{'idevento':entity.id}) }}')
        });            
    });        
</script>         
{% endblock %}
