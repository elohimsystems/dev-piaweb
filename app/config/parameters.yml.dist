# This file is auto-generated during the composer install
parameters:
  database_driver: pdo_pgsql
  database_host: localhost
  database_port: null
  database_name: ~
  database_user: ~
  database_password: ~

  mailer_transport: smtp
  mailer_host: ~
  mailer_port: 465
  mailer_encryption: ssl
  mailer_user: ~
  mailer_password: ~

  locale: es
  secret: ThisTokenIsNotSoSecretChangeIt

  contacto_email: ~
  contacto_whatsapp: ~

  # URL publica real de este ambiente (usada en sitemap.xml). Debe
  # apuntar a donde realmente responde el sitio (incluyendo subcarpeta
  # si el DocumentRoot no apunta directo a web/), ej:
  # https://sistemapia.com.ve/piaweb/web
  site_base_url: ~
