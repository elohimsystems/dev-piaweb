{% extends "FOSUserBundle::layout.html.twig" %}

{% block fos_user_content %}
<div style="width: 360px; margin: 80px auto; padding: 30px; border: 1px solid #ccc; border-radius: 6px; box-shadow: 2px 2px 8px rgba(0,0,0,0.1);">
    <h2 style="margin-top: 0;">Recuperar Contraseña</h2>

    <p style="font-size: 13px; color: #555;">
        Ingrese el correo del organizador. Si existe, le enviaremos un enlace para restablecer su contraseña.
    </p>

    {% if invalid_username is defined %}
    <div style="color: #a94442; background: #f2dede; border: 1px solid #ebccd1; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
        No se encontró ningún organizador con el correo "{{ invalid_username }}".
    </div>
    {% endif %}

    <form action="{{ path('fos_user_resetting_send_email') }}" method="POST">
        <label for="username" style="display:block; margin-bottom:4px;">Correo Electrónico</label>
        <input type="email" id="username" name="username" required="required"
               style="width:100%; padding:8px; margin-bottom:15px; border:1px solid #ccc; border-radius:4px; box-sizing:border-box;" />

        <input type="submit" value="Enviar Enlace"
               style="width:100%; padding:10px; background:#337ab7; color:#fff; border:none; border-radius:4px; cursor:pointer; font-size:14px;" />
    </form>

    <div style="text-align:center; margin-top:15px;">
        <a href="{{ path('fos_user_security_login') }}" style="font-size:13px; color:#337ab7;">Volver a Iniciar Sesión</a>
    </div>
</div>
{% endblock fos_user_content %}
