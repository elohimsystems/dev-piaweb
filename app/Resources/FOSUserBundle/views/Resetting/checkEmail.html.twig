{% extends "FOSUserBundle::layout.html.twig" %}

{% block fos_user_content %}
<div style="width: 360px; margin: 80px auto; padding: 30px; border: 1px solid #ccc; border-radius: 6px; box-shadow: 2px 2px 8px rgba(0,0,0,0.1); text-align:center;">
    <h2 style="margin-top: 0;">Revise su Correo</h2>
    <p style="font-size: 14px; color: #555;">
        Se ha enviado un enlace para restablecer su contraseña a <strong>{{ email }}</strong>.
    </p>
    <div style="margin-top:15px;">
        <a href="{{ path('fos_user_security_login') }}" style="font-size:13px; color:#337ab7;">Volver a Iniciar Sesión</a>
    </div>
</div>
{% endblock fos_user_content %}
